# ============================================================
# Atlas Docker 部署环境变量
# 复制为 .env 后按需修改：
#   cp .env.example .env
# ============================================================

# 生产环境必须设置强随机密钥（>=32 字符）
# 生成:  openssl rand -hex 32
JWT_SECRET=change-me-in-production-min-32-bytes!!

# true 为开发模式（自动建表 + 种子数据 + 开放 docs），生产必须 false
DEBUG=false

# 日志级别 debug | info | warning | error
LOG_LEVEL=info

# 允许的跨域来源（JSON 数组格式），生产建议限定域名
# CORS_ORIGINS=["https://reader.example.com","https://admin.example.com"]
CORS_ORIGINS=["*"]