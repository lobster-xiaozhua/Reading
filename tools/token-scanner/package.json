{
  "name": "@novel/tools-token-scanner",
  "version": "1.1.0",
  "description": "Atlas Design System · 令牌扫描器 + B 端导入审计，CI 守门：阻断裸色值、非令牌间距、SVG 硬编码色值、违规导入 @novel/components 基础组件",
  "type": "module",
  "main": "./dist/scanner.cjs",
  "bin": {
    "token-scanner": "./dist/cli.cjs",
    "import-audit": "./dist/import-audit.cjs"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/cli.js",
    "audit": "node dist/import-audit.js --root apps/admin",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ --max-warnings=0",
    "test": "node --import tsx --test src/__tests__/"
  },
  "devDependencies": {
    "@eslint/js": "^9.10.0",
    "@types/node": "^20.19.43",
    "eslint": "^9.10.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.5.0"
  },
  "dependencies": {
    "react-router": "6.30.4",
    "react-router-dom": "6.30.4"
  }
}
