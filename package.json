{
  "name": "novel-reader-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "小说阅读全端工程 · Atlas Design System（C 端）+ Ant Design（B 端）共用底层",
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "pnpm -r --filter=./packages/* run build",
    "dev": "pnpm -r --parallel run dev",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "token-scan": "node tools/token-scanner/dist/cli.js --root .",
    "import-audit": "node tools/token-scanner/dist/import-audit.js --root apps/admin",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "ci": "pnpm run lint && pnpm run typecheck && pnpm run token-scan && pnpm run import-audit && pnpm run test"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^8.3.0",
    "@storybook/addon-essentials": "^8.3.0",
    "@storybook/addon-interactions": "^8.3.0",
    "@storybook/react-vite": "^8.3.0",
    "eslint": "^9.10.0",
    "@eslint/js": "^9.10.0",
    "typescript-eslint": "^8.5.0",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "storybook": "^8.3.0",
    "tsx": "^4.23.1",
    "typescript": "^5.6.0"
  }
}
