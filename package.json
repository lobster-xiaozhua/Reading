{
  "name": "novel-reader-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "小说阅读全端工程 · Atlas Design System（C 端）+ Ant Design（B 端）共用底层",
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "pnpm -r --filter=./packages/* run build",
    "dev": "pnpm -r --parallel run dev",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "token-scan": "node tools/token-scanner/dist/cli.js --root .",
    "ci": "pnpm run lint && pnpm run typecheck && pnpm run token-scan && pnpm run test"
  },
  "devDependencies": {
    "tsx": "^4.23.1",
    "typescript": "^5.6.0"
  }
}
