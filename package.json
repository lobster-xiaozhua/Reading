{
  "name": "novel-reader-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "小说阅读全端工程 · Atlas Design System（C 端）+ Ant Design（B 端）共用底层",
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "pnpm -r --filter=./packages/* run build",
    "build:all": "pnpm -r run build",
    "dev": "pnpm -r --parallel run dev",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "clean": "pnpm -r exec rm -rf dist",
    "clean:all": "pnpm run clean && rm -rf node_modules && pnpm -r exec rm -rf node_modules",
    "test": "pnpm -r --filter='./apps/*' --filter='./packages/components' run test -- --run",
    "test:quick": "cd backend && python3 -m pytest tests/ -q --tb=short -m 'not slow' && pnpm -r --filter='./apps/*' --filter='./packages/components' run test -- --run",
    "test:full": "cd backend && python3 -m pytest tests/ -q --tb=short && pnpm run coverage",
    "coverage": "pnpm --filter @novel/web exec vitest run --coverage && pnpm --filter @novel/admin exec vitest run --coverage",
    "audit": "pnpm audit --audit-level=high",
    "token-scan": "node tools/token-scanner/dist/cli.js --root .",
    "import-audit": "node tools/token-scanner/dist/import-audit.js --root apps/admin",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "monitor": "bash monitoring/run.sh",
    "monitor:health": "bash monitoring/run.sh --only health",
    "monitor:api": "bash monitoring/run.sh --only api",
    "monitor:page": "bash monitoring/run.sh --only page",
    "monitor:flow": "bash monitoring/run.sh --only flow",
    "monitor:global": "bash monitoring/run.sh --only global",
    "global-check": "bash scripts/global-check/run.sh",
    "global-check:api": "bash scripts/global-check/run.sh --tag api",
    "global-check:pages": "bash scripts/global-check/run.sh --tag pages",
    "ci": "pnpm run lint && pnpm run typecheck && pnpm run token-scan || true && pnpm run import-audit && (cd backend && python3 -m pytest tests/ -q --tb=short --no-cov -n auto) && pnpm run coverage",
    "validate": "bash scripts/validate.sh",
    "validate:quick": "bash scripts/validate.sh --quick",
    "deploy": "bash scripts/deploy.sh",
    "deploy:test": "bash scripts/deploy-test.sh",
    "deploy:test:quick": "bash scripts/deploy-test.sh --quick"
  },
"pnpm": {
    "onlyBuiltDependencies": ["esbuild"],
    "overrides": {
      "react-router": "7.18.2",
      "react-router-dom": "7.18.2",
      "js-yaml": "4.3.1",
      "nanoid": ">=3.3.17",
      "uuid": "^11.0.0"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.10.0",
    "@playwright/test": "^1.62.1",
    "@storybook/addon-a11y": "^8.3.0",
    "@storybook/addon-essentials": "^8.3.0",
    "@storybook/addon-interactions": "^8.3.0",
    "@storybook/react-vite": "^8.3.0",
    "eslint": "^9.10.0",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "storybook": "^8.3.0",
    "tsx": "^4.23.1",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.5.0"
  }
}
