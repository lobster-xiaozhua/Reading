{
  "name": "novel-reader-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "小说阅读全端工程 · Atlas Design System（C 端）+ Ant Design（B 端）共用底层",
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "pnpm -r --filter=./packages/* run build",
    "dev": "pnpm -r --parallel run dev",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "coverage": "pnpm --filter @novel/web exec vitest run --coverage && pnpm --filter @novel/admin exec vitest run --coverage",
    "audit": "pnpm audit --audit-level=high",
    "token-scan": "node tools/token-scanner/dist/cli.js --root .",
    "import-audit": "node tools/token-scanner/dist/import-audit.js --root apps/admin",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "monitor": "bash monitoring/run.sh",
    "monitor:health": "bash monitoring/run.sh --only health",
    "monitor:api": "bash monitoring/run.sh --only api",
    "monitor:page": "bash monitoring/run.sh --only page",
    "monitor:flow": "bash monitoring/run.sh --only flow",
    "ci": "pnpm run lint && pnpm run typecheck && pnpm run token-scan -- --root . || true && pnpm run import-audit && pnpm run test && pnpm run coverage",
    "validate": "bash scripts/validate.sh",
    "validate:quick": "bash scripts/validate.sh --quick",
    "deploy": "bash scripts/deploy.sh",
    "deploy:test": "bash scripts/deploy-test.sh",
    "deploy:test:quick": "bash scripts/deploy-test.sh --quick"
  },
"pnpm": {
    "overrides": {
      "react-router": "6.30.1",
      "react-router-dom": "6.30.1",
      "@remix-run/router": "1.23.0"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.10.0",
    "@playwright/test": "^1.62.1",
    "@storybook/addon-a11y": "^8.3.0",
    "@storybook/addon-essentials": "^8.3.0",
    "@storybook/addon-interactions": "^8.3.0",
    "@storybook/react-vite": "^8.3.0",
    "eslint": "^9.10.0",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "storybook": "^8.3.0",
    "tsx": "^4.23.1",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.5.0"
  }
}
