{
  "name": "@novel/b-end",
  "version": "0.1.0",
  "description": "Atlas Design System · B 端专用组件包（22 组件，基于 Ant Design 5.x + Atlas Tokens）",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": [],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'lint placeholder'",
    "test": "node --import tsx --test 'src/**/*.test.ts'"
  },
  "peerDependencies": {
    "@ant-design/icons": "^5.4.0",
    "antd": "^5.21.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@novel/tokens": "workspace:*",
    "@novel/icons": "workspace:*"
  },
  "devDependencies": {
    "@ant-design/icons": "^5.4.0",
    "@types/node": "^20.19.43",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "antd": "^5.21.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.23.1",
    "typescript": "^5.6.0"
  }
}
