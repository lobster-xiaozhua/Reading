{
  "name": "@novel/types",
  "version": "0.1.0",
  "description": "Atlas Design System · 跨端共享类型包（C/B 端 Novel/Chapter 基础类型 + 枚举，避免双源真相）",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ --max-warnings=0",
    "test": "echo 'no tests'"
  },
  "devDependencies": {
    "@eslint/js": "^9.10.0",
    "eslint": "^9.10.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.5.0"
  },
  "dependencies": {
    "react-router": "6.30.4",
    "react-router-dom": "6.30.4"
  }
}
