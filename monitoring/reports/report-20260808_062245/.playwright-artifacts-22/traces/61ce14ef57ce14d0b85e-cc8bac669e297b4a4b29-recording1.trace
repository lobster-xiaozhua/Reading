h;\n      }\n      .app-shell-skeleton__nav {\n        height: 56px;\n        background: #ffffff;\n        border-bottom: 1px solid #e5e6eb;\n      }\n      .app-shell-skeleton__body {\n        flex: 1;\n        padding: 24px 16px;\n      }\n      .app-shell-skeleton__line {\n        height: 16px;\n        background: #f2f3f5;\n        border-radius: 4px;\n        margin-bottom: 12px;\n      }\n      .app-shell-skeleton__line--w60 {\n        width: 60%;\n      }\n      .app-shell-skeleton__line--w40 {\n        width: 40%;\n      }\n    "],"\n  ",["STYLE",{},".novel-navbar {\n  position: sticky;\n  top: 0;\n  z-index: var(--z-index-sticky);\n  background: var(--color-bg-surface);\n  border-bottom: 1px solid var(--color-border-subtle);\n  box-shadow: var(--sh-1);\n  backdrop-filter: saturate(180%) blur(12px);\n  -webkit-backdrop-filter: saturate(180%) blur(12px);\n}\n\n.novel-navbar__inner {\n  display: flex;\n  align-items: center;\n  gap: var(--space-4);\n  height: 56px;\n}\n\n.novel-navbar__logo {\n  display: inline-flex;\n  align-items: center;\n  gap: var(--space-2);\n  text-decoration: none;\n  color: var(--color-text-primary);\n  flex-shrink: 0;\n}\n.novel-navbar__logo-mark {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  width: 32px;\n  height: 32px;\n  border-radius: var(--radius-md);\n  background: linear-gradient(135deg, var(--color-brand), var(--color-accent));\n  color: var(--color-text-inverse);\n  font-family: var(--font-serif);\n  font-weight: var(--font-weight-bold);\n  font-size: var(--font-size-body);\n  box-shadow: var(--sh-1), 0 0 12px var(--color-brand-glow-25);\n  transition:\n    box-shadow var(--dur-fast) var(--ease-standard),\n    transform var(--dur-fast) var(--ease-spring);\n}\n.novel-navbar__logo:hover .novel-navbar__logo-mark {\n  box-shadow: var(--sh-2), 0 0 16px var(--color-brand-glow-35);\n  transform: scale(1.08);\n}\n.novel-navbar__logo-text {\n  font-family: var(--font-serif);\n  font-size: var(--font-size-h4);\n  font-weight: var(--font-weight-semibold);\n  background: linear-gradient(to right, var(--color-text-primary), var(--color-text-secondary));\n  -webkit-background-clip: text;\n  -webkit-text-fill-color: transparent;\n  background-clip: text;\n}\n\n.novel-navbar__nav {\n  display: flex;\n  align-items: center;\n  gap: var(--space-1);\n}\n.novel-navbar__nav-link {\n  display: inline-flex;\n  align-items: center;\n  padding: var(--space-2) var(--space-3);\n  border-radius: var(--radius-md);\n  color: var(--color-text-secondary);\n  font-size: var(--font-size-small);\n  text-decoration: none;\n  transition:\n    color var(--dur-fast) var(--ease-standard),\n    background var(--dur-fast) var(--ease-standard);\n}\n.novel-navbar__nav-link:hover {\n  color: var(--color-brand);\n  background: var(--color-brand-bg);\n}\n.novel-navbar__nav-link.is-active,\n.novel-navbar__nav-link[aria-current=\"page\"] {\n  color: var(--color-brand);\n  font-weight: var(--font-weight-emphasis);\n}\n\n.novel-navbar__search {\n  flex: 1;\n  max-width: 420px;\n  display: flex;\n  align-items: center;\n  gap: var(--space-2);\n  margin-left: auto;\n}\n.novel-navbar__search-input {\n  flex: 1;\n  height: 36px;\n  padding: 0 var(--space-3);\n  border: 1px solid var(--color-border-default);\n  border-radius: var(--radius-full);\n  background: var(--color-bg-subtle);\n  color: var(--color-text-primary);\n  font-family: inherit;\n  font-size: var(--font-size-small);\n  outline: none;\n  transition:\n    border-color var(--dur-fast) var(--ease-standard),\n    background var(--dur-fast) var(--ease-standard);\n}\n.novel-navbar__search-input:focus {\n  border-color: var(--color-brand);\n  background: var(--color-bg-surface);\n  box-shadow: 0 0 0 3px var(--color-brand-bg);\n}\n.novel-navbar__search-btn {\n  height: 36px;\n  padding: 0 var(--space-4);\n  border: none;\n  border-radius: var(--radius-full);\n  background: var(--color-brand);\n  color: var(--color-text-inverse);\n  font-size: var(--font-size-small);\n  cursor: pointer;\n  transition: all var(--dur-fast) var(--ease-standard);\n}\n.novel-navbar__search-btn:hover {\n  background: var(--color-brand-hover);\n}\n.novel-navbar__search-btn:active {\n  transform: scale(0.95);\n}\n.novel-navbar__search-btn:disabled {\n  opacity: 0.5;\n  cursor: not-allowed;\n}\n\n.novel-navbar__user {\n  flex-shrink: 0;\n}\n.novel-navbar__avatar-link {\n  display: inline-flex;\n  align-items: center;\n  gap: var(--space-2);\n  text-decoration: none;\n  color: var(--color-text-primary);\n}\n.novel-navbar__username {\n  font-size: var(--font-size-small);\n  color: var(--color-text-secondary);\n}\n.novel-navbar__login-btn {\n  padding: var(--space-2) var(--space-4);\n  border: 1px solid var(--color-border-default);\n  border-radius: var(--radius-full);\n  background: var(--color-bg-surface);\n  color: var(--color-text-primary);\n  font-size: var(--font-size-small);\n  cursor: pointer;\n  transition: all var(--dur-fast) var(--ease-standard);\n}\n.novel-navbar__login-btn:hover {\n  border-color: var(--color-brand);\n  color: var(--color-brand);\n}\n.novel-navbar__login-btn:active {\n  transform: scale(0.95);\n}\n.novel-navbar__login-btn:disabled {\n  opacity: 0.5;\n  cursor: not-allowed;\n}\n\n/* 响应式：H5 隐藏用户名与搜索框文案 */\n@media (max-width: 640px) {\n  .novel-navbar__nav,\n  .novel-navbar__username,\n  .novel-navbar__logo-text {\n    display: none;\n  }\n  .novel-navbar__search-btn {\n    padding: 0 var(--space-3);\n  }\n}\n"],["STYLE",{},"/* ============================================================\n * Footer · C 端底部信息栏（品牌化升级）\n * ============================================================ */\n\n.novel-footer {\n  margin-top: var(--space-16);\n  padding: var(--space-10) 0 var(--space-8);\n  background: var(--color-bg-surface);\n  border-top: 1px solid var(--color-border-subtle);\n}\n\n.novel-footer__inner {\n  display: flex;\n  flex-direction: column;\n  gap: var(--space-8);\n}\n\n/* ---------- 品牌区 ---------- */\n.novel-footer__brand {\n  display: flex;\n  flex-direction: column;\n  gap: var(--space-3);\n  max-width: 320px;\n}\n\n.novel-footer__logo-wrap {\n  display: flex;\n  align-items: center;\n  gap: var(--space-2);\n}\n\n.novel-footer__logo-mark {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  width: 32px;\n  height: 32px;\n  border-radius: var(--radius-md);\n  background: linear-gradient(135deg, var(--color-brand), var(--color-accent));\n  color: var(--color-text-inverse);\n  flex-shrink: 0;\n}\n\n.novel-footer__logo-text {\n  font-family: var(--font-serif);\n  font-size: var(--font-size-h4);\n  font-weight: var(--font-weight-semibold);\n  color: var(--color-text-primary);\n}\n\n.novel-footer__slogan {\n  margin: 0;\n  font-size: var(--font-size-small);\n  color: var(--color-text-secondary);\n}\n\n.novel-footer__features {\n  list-style: none;\n  margin: 0;\n  padding: 0;\n  display: flex;\n  flex-direction: column;\n  gap: var(--space-2);\n}\n\n.novel-footer__features li {\n  display: flex;\n  align-items: center;\n  gap: var(--space-2);\n  font-size: var(--font-size-xs);\n  color: var(--color-text-tertiary);\n}\n\n.novel-footer__features svg {\n  color: var(--color-brand);\n  flex-shrink: 0;\n}\n\n/* ---------- 导航列 ---------- */\n.novel-footer__cols {\n  display: grid;\n  grid-template-columns: repeat(2, 1fr);\n  gap: var(--space-6);\n}\n\n.novel-footer__col {\n  display: flex;\n  flex-direction: column;\n  gap: var(--space-2);\n}\n\n.novel-footer__col-title {\n  font-size: var(--font-size-caption);\n  font-weight: var(--font-weight-semibold);\n  color: var(--color-text-tertiary);\n  text-transform: uppercase;\n  letter-spacing: 0.06em;\n  margin-bottom: var(--space-1);\n}\n\n.novel-footer__col a {\n  font-size: var(--font-size-small);\n  color: var(--color-text-secondary);\n  text-decoration: none;\n  padding: var(--space-1) 0;\n  transition:\n    color var(--dur-fast) var(--ease-standard),\n    padding-left var(--dur-fast) var(--ease-standard);\n}\n\n.novel-footer__col a:hover {\n  color: var(--color-brand);\n  padding-left: var(--space-2);\n}\n\n/* ---------- 底部元信息 ---------- */\n.novel-footer__meta {\n  padding-top: var(--space-6);\n  border-top: 1px solid var(--color-border-subtle);\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: var(--space-1);\n  text-align: center;\n}\n\n.novel-footer__copy {\n  margin: 0;\n  font-size: var(--font-size-xs);\n  color: var(--color-text-tertiary);\n}\n\n.novel-footer__icp {\n  margin: 0;\n  font-size: var(--font-size-xs);\n  color: var(--color-text-disabled);\n}\n\n/* ---------- 响应式 ---------- */\n@media (min-width: 640px) {\n  .novel-footer__inner {\n    flex-direction: row;\n    justify-content: space-between;\n    align-items: flex-start;\n  }\n\n  .novel-footer__cols {\n    grid-template-columns: repeat(2, 140px);\n  }\n\n  .novel-footer__meta {\n    align-items: flex-end;\n    justify-content: flex-end;\n  }\n}\n\n@media (max-width: 768px) {\n  .novel-footer__cols {\n    grid-template-columns: repeat(2, 1fr);\n  }\n}\n"],["STYLE",{},"/* ============================================================\n * BottomTabBar · P7-1\n * 48px 高度 + 安全区底部内边距；触控热区 ≥ 44×44px\n * 仅 ≤768px 显示（桌面端走顶部 NavBar）\n * ============================================================ */\n\n.bottom-tab-bar {\n  position: fixed;\n  left: 0;\n  right: 0;\n  bottom: 0;\n  z-index: var(--z-index-sticky);\n  background: var(--color-bg-surface);\n  border-top: 1px solid var(--color-border-subtle);\n  /* P7-7 安全区：底部 Home Indicator 让位 */\n  padding-bottom: env(safe-area-inset-bottom, 0px);\n  box-shadow: var(--sh-1);\n  /* 桌面端隐藏 */\n  display: none;\n}\n\n@media (max-width: 768px) {\n  .bottom-tab-bar {\n    display: block;\n  }\n}\n\n.bottom-tab-bar__list {\n  display: grid;\n  grid-template-columns: repeat(4, 1fr);\n  list-style: none;\n  margin: 0;\n  padding: 0;\n  height: 48px;\n}\n\n.bottom-tab-bar__item {\n  display: flex;\n  align-items: stretch;\n  justify-content: center;\n}\n\n.bottom-tab-bar__link {\n  /* P7-2 触控热区 ≥ 44×44px */\n  min-width: 44px;\n  min-height: 44px;\n  display: inline-flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  gap: 2px;\n  padding: 2px var(--space-2);\n  color: var(--color-text-tertiary);\n  text-decoration: none;\n  border-radius: var(--radius-md);\n  transition: color var(--dur-fast) var(--ease-standard);\n}\n\n.bottom-tab-bar__link.is-active {\n  color: var(--color-brand);\n}\n\n.bottom-tab-bar__label {\n  font-size: var(--font-size-overline);\n  line-height: 1;\n}\n\n/* 焦点可见（P8-A3） */\n.bottom-tab-bar__link:focus-visible {\n  outline: none;\n  box-shadow: 0 0 0 2px var(--color-brand-bg);\n}\n\n/* 高对比模式（P8-A5）：增强描边 */\n@media (prefers-contrast: more) {\n  .bottom-tab-bar {\n    border-top-width: 2px;\n    border-top-color: var(--color-text-primary);\n  }\n  .bottom-tab-bar__link.is-active {\n    color: var(--color-brand);\n    font-weight: var(--font-weight-bold);\n  }\n}\n"],["STYLE",{},".error-state {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  gap: var(--space-3);\n  padding: var(--space-8) var(--space-4);\n  text-align: center;\n  color: var(--color-text-secondary);\n}\n\n.error-state__icon {\n  color: var(--color-text-tertiary);\n  opacity: 0.6;\n}\n\n.error-state__title {\n  margin: 0;\n  font-size: var(--font-size-body);\n  font-weight: var(--font-weight-semibold);\n  color: var(--color-text-primary);\n}\n\n.error-state__desc {\n  margin: 0;\n  font-size: var(--font-size-caption);\n  color: var(--color-text-tertiary);\n}\n\n.error-state__retry {\n  margin-top: var(--space-2);\n  padding: var(--space-2) var(--space-6);\n  border: 1px solid var(--color-border-default);\n  border-radius: var(--radius-md);\n  background: var(--color-bg-surface);\n  color: var(--color-brand);\n  font-size: var(--font-size-small);\n  cursor: pointer;\n  transition:\n    background var(--dur-fast) var(--ease-standard),\n    border-color var(--dur-fast) var(--ease-standard);\n}\n\n.error-state__retry:hover {\n  background: var(--color-brand-bg);\n  border-color: var(--color-brand);\n}\n.error-state__retry:active {\n  transform: scale(0.97);\n}\n"],["STYLE",{},"/* PWA 新版本提示浮条（P7-6） */\n\n.novel-update-prompt {\n  position: fixed;\n  left: 50%;\n  bottom: var(--space-6);\n  transform: translateX(-50%);\n  z-index: var(--z-index-toast);\n  display: flex;\n  align-items: center;\n  gap: var(--space-3);\n  padding: var(--space-3) var(--space-4);\n  background: var(--color-bg-surface);\n  border: 1px solid var(--color-border-subtle);\n  border-radius: var(--radius-md);\n  box-shadow: var(--sh-2);\n}\n\n.novel-update-prompt__text {\n  font-size: var(--font-size-body);\n  color: var(--color-text-primary);\n}\n\n.novel-update-prompt__btn {\n  padding: var(--space-1) var(--space-3);\n  border: none;\n  border-radius: var(--radius-sm);\n  background: var(--color-brand);\n  color: var(--color-text-inverse);\n  font-size: var(--font-size-body);\n  cursor: pointer;\n}\n"],["STYLE",{},"/* ============================================================\n * Atlas Design System · Tokens Aggregator\n * 一站式引入：primitive + semantic + reader-theme\n * 用法：import '@novel/tokens/styles/tokens.css';\n * ============================================================ */\n\n/* ============================================================\n * Atlas Design System · L1 Primitive Tokens\n * 不可变原子值，全局唯一真值。组件禁止直接引用本层。\n * Source: 01-前端底层设计.md §13.1\n * Version: V1.0.0 · 2026.07\n * ============================================================ */\n\n:root {\n  /* ---------- L1 Primitive · 品牌（Ant Design blue 基准） ---------- */\n  --brand-1: #F0F9FF;\n  --brand-2: #E6F7FF;\n  --brand-3: #BAE7FF;\n  --brand-4: #91D5FF;\n  --brand-5: #69C0FF;\n  --brand-6: #40A9FF;\n  --brand-7: #1890FF;\n  --brand-8: #096DD9;\n  --brand-9: #0050B3;\n  --brand-10: #003A8C;\n\n  /* ---------- L1 Primitive · 强调（C 端 accent，钴蓝） ---------- */\n  --accent-1: #EEF2FF;\n  --accent-2: #DCE3FF;\n  --accent-3: #B9C7FF;\n  --accent-4: #8FA5FF;\n  --accent-5: #6A82FF;\n  --accent-6: #4566FF;\n  --accent-7: #245BFF;\n  --accent-8: #1A47D9;\n  --accent-9: #1238A8;\n  --accent-10: #0B2470;\n\n  /* ---------- L1 Primitive · 暖橙（C 端营销扩展色，03 §3.2.1） ---------- */\n  --orange-1: #FFF4E6;\n  --orange-2: #FFD9B3;\n  --orange-3: #E37318;\n  --orange-4: #F08528;\n  --orange-5: #C9640F;\n\n  /* ---------- L1 Primitive · 功能色 ---------- */\n  --success-1: #F6FFED;\n  --success-2: #B7EB8F;\n  --success-3: #52C41A;\n  --success-4: #389E0D;\n  --success-5: #237804;\n\n  --warning-1: #FFFBE6;\n  --warning-2: #FFE58F;\n  --warning-3: #FAAD14;\n  --warning-4: #D48806;\n  --warning-5: #AD6800;\n\n  --error-1: #FFF1F0;\n  --error-2: #FFA39E;\n  --error-3: #F5222D;\n  --error-4: #CF1322;\n  --error-5: #A8071A;\n\n  --info-1: #E6F7FF;\n  --info-2: #91D5FF;\n  --info-3: #1890FF;\n  --info-4: #096DD9;\n  --info-5: #0050B3;\n\n  /* ---------- L1 Primitive · 中性色 14 级 ---------- */\n  --gray-1: #F7F7F8;\n  --gray-2: #EDEDF0;\n  --gray-3: #E2E2E7;\n  --gray-4: #D3D3DA;\n  --gray-5: #B8B8C1;\n  --gray-6: #9999A5;\n  --gray-7: #7A7A86;\n  --gray-8: #5E5E6A;\n  --gray-9: #45454F;\n  --gray-10: #2F2F37;\n  --gray-11: #1F1F25;\n  --gray-12: #15151B;\n  --gray-13: #0E0E13;\n  --gray-14: #0A0B12;\n\n  /* ---------- L1 Primitive · 阅读主题色（独立于通用 gray） ---------- */\n  --read-bg-day: #FFFFFF;\n  --read-bg-night: #1A1A1A;\n  --read-bg-sepia: #F5EDDC;\n  --read-bg-parchment: #F4ECD8;\n\n  --read-text-day: #2A2B33;\n  --read-text-night: #E0E0E0;\n  --read-text-sepia: #5B4636;\n  --read-text-parchment: #5B4636;\n\n  --read-text-secondary-day: #5E5E6A;\n  --read-text-secondary-night: #888888;\n  --read-text-secondary-sepia: #8C7355;\n  --read-text-secondary-parchment: #8C7355;\n\n  /* ---------- L1 Primitive · 图表色板（独立于 UI 语义色，02 §4.1 / 04 §7.1） ---------- */\n  --chart-1: #1890FF;  /* 主序列，对齐 brand-7 */\n  --chart-2: #52C41A;  /* 对齐 success-3 */\n  --chart-3: #FAAD14;  /* 对齐 warning-3 */\n  --chart-4: #F5222D;  /* 对齐 error-3 */\n  --chart-5: #722ED1;  /* 紫色序列 */\n  --chart-6: #13C2C2;  /* 青色序列 */\n\n  /* ---------- L1 Primitive · 渐变色 ---------- */\n  --gradient-brand-subtle: linear-gradient(135deg, #E6F7FF 0%, #F0F9FF 100%);\n  --gradient-brand-strong: linear-gradient(135deg, #1890FF 0%, #096DD9 100%);\n  --gradient-warm: linear-gradient(135deg, #FFF4E6 0%, #FFE4B5 100%);\n  --gradient-rose: linear-gradient(135deg, #FF6B6B 0%, #F5222D 100%);\n  --gradient-gold: linear-gradient(135deg, #FFD700 0%, #FFA500 100%);\n  --gradient-surface: linear-gradient(180deg, #FFFFFF 0%, #F7F7F8 100%);\n  --gradient-surface-dark: linear-gradient(180deg, #15151B 0%, #0E0E13 100%);\n}\n/* ============================================================\n * Atlas Design System · L2 Semantic Tokens\n * 按用途命名，引用 L1 Primitive，随主题切换。\n * 组件层推荐引用本层（var(--color-*)）。\n * Source: 01-前端底层设计.md §13.1\n * ============================================================ */\n\n:root {\n  color-scheme: light dark;\n\n  /* ---------- L2 Semantic · 文本 ---------- */\n  --color-text-primary: var(--gray-14);\n  --color-text-secondary: var(--gray-8);\n  --color-text-tertiary: var(--gray-6);\n  --color-text-disabled: var(--gray-5);\n  --color-text-inverse: var(--gray-1);\n  --color-text-link: var(--brand-7);\n  --color-text-link-hover: var(--brand-6);\n\n  /* ---------- L2 Semantic · 背景 ---------- */\n  --color-bg-page: var(--gray-1);\n  --color-bg-surface: #FFFFFF;\n  --color-bg-subtle: var(--gray-2);\n  --color-bg-elevated: #FFFFFF;\n  --color-bg-mask: rgba(10, 11, 18, 0.45);\n\n  /* ---------- L2 Semantic · 边框 ---------- */\n  --color-border-default: var(--gray-4);\n  --color-border-subtle: var(--gray-3);\n  --color-border-focus: var(--brand-7);\n  --color-border-strong: var(--gray-6);\n\n  /* ---------- L2 Semantic · 品牌 ---------- */\n  --color-brand: var(--brand-7);\n  --color-brand-hover: var(--brand-8);\n  --color-brand-active: var(--brand-9);\n  --color-brand-bg: var(--brand-2);\n  --color-brand-border: var(--brand-3);\n\n  /* ---------- L2 Semantic · 表面层级（新增 raised / overlay / tooltip） ---------- */\n  --color-bg-raised: #FFFFFF;\n  --color-bg-overlay: #FFFFFF;\n  --color-bg-tooltip: var(--gray-14);\n\n  /* ---------- L2 Semantic · 渐变（引用 L1 Gradient） ---------- */\n  --gradient-brand-subtle: var(--gradient-brand-subtle);\n  --gradient-brand-strong: var(--gradient-brand-strong);\n  --gradient-warm: var(--gradient-warm);\n  --gradient-rose: var(--gradient-rose);\n  --gradient-gold: var(--gradient-gold);\n  --gradient-surface: var(--gradient-surface);\n\n  /* ---------- L2 Semantic · 品牌发光（光晕/按钮辉光等视觉装饰，随主题切换） ---------- */\n  --color-brand-glow-0: rgba(24, 144, 255, 0);\n  --color-brand-glow-20: rgba(24, 144, 255, 0.2);\n  --color-brand-glow-25: rgba(24, 144, 255, 0.25);\n  --color-brand-glow-30: rgba(24, 144, 255, 0.3);\n  --color-brand-glow-35: rgba(24, 144, 255, 0.35);\n  --color-brand-glow-40: rgba(24, 144, 255, 0.4);\n\n  /* ---------- L2 Semantic · 强调（C 端 accent） ---------- */\n  --color-accent: var(--accent-7);\n  --color-accent-hover: var(--accent-8);\n  --color-accent-active: var(--accent-9);\n\n  /* ---------- L2 Semantic · 强调暖橙（C 端营销色，03 §3.2.1） ---------- */\n  --color-accent-orange: var(--orange-3);\n  --color-accent-orange-hover: var(--orange-4);\n  --color-accent-orange-active: var(--orange-5);\n  --color-accent-orange-bg: var(--orange-1);\n\n  /* ---------- L2 Semantic · 玫红（C 端互动色，03 §3.2.2） ---------- */\n  --color-rose: var(--error-3);\n  --color-rose-light: #FF6B6B;\n  --color-rose-gradient: linear-gradient(135deg, var(--error-3) 0%, #FF6B6B 100%);\n  --color-rose-bg: var(--error-1);\n\n  /* ---------- L2 Semantic · 排行榜 Top3 奖牌色（03 §6.3 排行榜） ---------- */\n  --color-rank-gold-gradient: linear-gradient(135deg, #FFD700, #FFA500);\n  --color-rank-silver-gradient: linear-gradient(135deg, #C0C0C0, #A0A0A0);\n  --color-rank-bronze-gradient: linear-gradient(135deg, #CD7F32, #A06030);\n\n  /* ---------- L2 Semantic · 排行榜 Top3 奖牌阴影（03 §6.3） ---------- */\n  --color-rank-gold-shadow: rgba(255, 215, 0, 0.3);\n  --color-rank-silver-shadow: rgba(192, 192, 192, 0.3);\n  --color-rank-bronze-shadow: rgba(205, 127, 50, 0.3);\n\n  /* ---------- L2 Semantic · 遮罩 / 覆盖层（轮播图、卡片悬浮控件） ---------- */\n  --color-overlay-gradient: linear-gradient(180deg, transparent 40%, rgba(0, 0, 0, 0.72) 100%);\n  --color-overlay-medium: rgba(0, 0, 0, 0.4);\n  --color-overlay-strong: rgba(0, 0, 0, 0.6);\n  --color-overlay-dot: rgba(255, 255, 255, 0.5);\n\n  /* ---------- L2 Semantic · 装饰光泽 / 阴影（按钮涟漪、卡片光泽、轻阴影） ---------- */\n  --color-overlay-white-10: rgba(255, 255, 255, 0.1);\n  --color-overlay-white-12: rgba(255, 255, 255, 0.12);\n  --color-overlay-white-15: rgba(255, 255, 255, 0.15);\n  --color-overlay-white-20: rgba(255, 255, 255, 0.2);\n  --color-overlay-white-25: rgba(255, 255, 255, 0.25);\n  --color-overlay-white-30: rgba(255, 255, 255, 0.3);\n  --color-shadow-soft-10: rgba(0, 0, 0, 0.1);\n  --color-shadow-soft-15: rgba(0, 0, 0, 0.15);\n\n  /* ---------- L2 Semantic · 反馈 ---------- */\n  --color-feedback-success: var(--success-3);\n  --color-feedback-success-bg: var(--success-1);\n  --color-feedback-warning: var(--warning-3);\n  --color-feedback-warning-bg: var(--warning-1);\n  --color-feedback-error: var(--error-3);\n  --color-feedback-error-bg: var(--error-1);\n  --color-feedback-info: var(--info-3);\n  --color-feedback-info-bg: var(--info-1);\n\n  /* ---------- 字体 ---------- */\n  --font-sans: 'Noto Sans SC', 'PingFang SC', 'Microsoft YaHei', system-ui, -apple-system, sans-serif;\n  --font-serif: 'Noto Serif SC', 'Source Han Serif SC', 'Songti SC', serif;\n  --font-mono: 'JetBrains Mono', 'SFMono-Regular', Consolas, 'Liberation Mono', monospace;\n\n  --font-size-display: 64px;\n  --font-size-h1: 40px;\n  --font-size-h2: 28px;\n  --font-size-h3: 20px;\n  --font-size-body: 16px;\n  --font-size-small: 14px;\n  --font-size-caption: 13px;\n  --font-size-xs: 12px;\n  --font-size-overline: 11px;\n  --font-size-tiny: 10px;\n  --font-size-button: 14px;\n  --font-size-body-lg: 17px;\n  --font-size-h4: 18px;\n\n  /* ---------- 字号语义化（用途命名） ---------- */\n  --font-size-prose: var(--font-size-body);\n  --font-size-prose-lg: var(--font-size-body-lg);\n  --font-size-eyebrow: var(--font-size-overline);\n  --font-size-label: var(--font-size-caption);\n\n  --font-weight-light: 300;\n  --font-weight-regular: 400;\n  --font-weight-medium: 500;\n  --font-weight-semibold: 600;\n  --font-weight-bold: 700;\n  --font-weight-extrabold: 800;\n\n  /* ---------- 字重语义化（按层级用途） ---------- */\n  --font-weight-heading: var(--font-weight-bold);\n  --font-weight-subheading: var(--font-weight-semibold);\n  --font-weight-body: var(--font-weight-regular);\n  --font-weight-emphasis: var(--font-weight-medium);\n  --font-weight-caption: var(--font-weight-medium);\n\n  /* ---------- 行高（5 级，按内容类型） ---------- */\n  --line-height-tighter: 1.1;   /* display / hero title */\n  --line-height-tight: 1.2;     /* heading 1-2 */\n  --line-height-snug: 1.35;     /* heading 3-4 / UI title */\n  --line-height-normal: 1.5;    /* body / input */\n  --line-height-relaxed: 1.7;   /* prose / long-form */\n  --line-height-loose: 1.85;    /* 阅读类正文 */\n\n  /* ---------- 行高语义化 ---------- */\n  --line-height-display: var(--line-height-tighter);\n  --line-height-heading: var(--line-height-tight);\n  --line-height-subheading: var(--line-height-snug);\n  --line-height-ui: var(--line-height-snug);\n  --line-height-prose: var(--line-height-relaxed);\n\n  /* ---------- 字间距（6 级） ---------- */\n  --letter-spacing-tighter: -0.04em;\n  --letter-spacing-tight: -0.02em;\n  --letter-spacing-normal: 0;\n  --letter-spacing-wide: 0.02em;\n  --letter-spacing-wider: 0.05em;\n  --letter-spacing-widest: 0.1em;\n\n  /* ---------- 字间距语义化 ---------- */\n  --letter-spacing-heading: var(--letter-spacing-tight);\n  --letter-spacing-display: var(--letter-spacing-tighter);\n  --letter-spacing-body: var(--letter-spacing-normal);\n  --letter-spacing-caption: var(--letter-spacing-wide);\n  --letter-spacing-eyebrow: var(--letter-spacing-wider);\n  --letter-spacing-uppercase: var(--letter-spacing-widest);\n\n  /* ---------- 小说正文 ---------- */\n  --novel-font-family: var(--font-serif);\n  --novel-font-size: 18px;\n  --novel-line-height: 1.8;\n  --novel-paragraph-spacing: 1em;\n  --novel-text-color: var(--gray-11);\n  --novel-measure: 42ch;\n\n  /* ---------- 阅读主题（L2 Semantic，切换时仅改这一层） ---------- */\n  --novel-read-bg: var(--read-bg-day);\n  --novel-read-text: var(--read-text-day);\n  --novel-read-text-secondary: var(--read-text-secondary-day);\n\n  /* ---------- 阅读器交互区 ---------- */\n  --reader-tap-zone: 80px;\n  --reader-tap-center: 40%;\n  --reader-toolbar-height: 56px;\n  --reader-progress-height: 3px;\n  --reader-chapter-gap: var(--space-12);\n  --reader-paragraph-indent: 2em;\n  --reader-line-spacing-extra: 0.05em;\n\n  /* ---------- 阅读器字体族（L2，由 ReaderSettings 切换；03 §4.6） ---------- */\n  --reader-font-family: var(--font-serif);\n  --reader-font-family-serif: 'Noto Serif SC', serif;\n  --reader-font-family-song: 'SimSun', 'Noto Serif SC', serif;\n  --reader-font-family-hei: 'SimHei', 'Noto Sans SC', sans-serif;\n  --reader-font-family-kai: 'KaiTi', 'Noto Serif SC', serif;\n\n  /* ---------- 阅读器行距分档（03 §6.13 ReaderSettings） ---------- */\n  --reader-line-height-compact: 1.5;\n  --reader-line-height-standard: 1.8;\n  --reader-line-height-loose: 2.1;\n\n  /* ---------- 间距（13 档，4px 基准） ---------- */\n  --space-1: 4px;\n  --space-2: 8px;\n  --space-3: 12px;\n  --space-4: 16px;\n  --space-5: 20px;\n  --space-6: 24px;\n  --space-8: 32px;\n  --space-10: 40px;\n  --space-12: 48px;\n  --space-16: 64px;\n  --space-20: 80px;\n  --space-24: 96px;\n  --space-32: 128px;\n\n  /* ---------- 圆角（8 档） ---------- */\n  --radius-none: 0;\n  --radius-xs: 2px;\n  --radius-sm: 4px;\n  --radius-md: 8px;\n  --radius-lg: 12px;\n  --radius-xl: 16px;\n  --radius-2xl: 24px;\n  --radius-full: 9999px;\n\n  /* ---------- 阴影（5 级） ---------- */\n  --sh-1: 0 1px 2px 0 rgba(0, 0, 0, 0.04);\n  --sh-2: 0 2px 8px 0 rgba(0, 0, 0, 0.08);\n  --sh-3: 0 4px 12px 0 rgba(0, 0, 0, 0.10);\n  --sh-4: 0 8px 24px 0 rgba(0, 0, 0, 0.12);\n  --sh-5: 0 16px 48px 0 rgba(0, 0, 0, 0.16);\n\n  /* ---------- 阴影增强（发光、内阴影、按压） ---------- */\n  --sh-glow-brand: 0 0 12px rgba(24, 144, 255, 0.3);\n  --sh-glow-rose: 0 0 12px rgba(245, 34, 45, 0.2);\n  --sh-inner: inset 0 1px 3px rgba(0, 0, 0, 0.06);\n  --sh-pressed: inset 0 1px 4px rgba(0, 0, 0, 0.12);\n\n  /* ---------- 动效 ---------- */\n  --ease-standard: cubic-bezier(0.4, 0, 0.2, 1);\n  --ease-emphasized: cubic-bezier(0.2, 0, 0, 1);\n  --ease-decelerate: cubic-bezier(0, 0, 0.2, 1);\n  --ease-accelerate: cubic-bezier(0.4, 0, 1, 1);\n  --ease-spring: cubic-bezier(0.34, 1.56, 0.64, 1);\n  --ease-smooth: cubic-bezier(0.65, 0, 0.35, 1);\n\n  --dur-instant: 90ms;\n  --dur-fast: 150ms;\n  --dur-normal: 240ms;\n  --dur-slow: 360ms;\n  --dur-deliberate: 540ms;\n\n  /* ---------- 过渡简写（组合 duration + easing） ---------- */\n  --transition-fade: opacity var(--dur-fast) var(--ease-standard);\n  --transition-slide: transform var(--dur-normal) var(--ease-decelerate);\n  --transition-spring: transform var(--dur-normal) var(--ease-spring);\n  --transition-expand: grid-template-rows var(--dur-normal) var(--ease-standard);\n\n  /* ---------- 层级 z-index（6 级） ---------- */\n  --z-index-base: 0;\n  --z-index-dropdown: 1000;\n  --z-index-sticky: 1100;\n  --z-index-drawer: 1200;\n  --z-index-modal: 1300;\n  --z-index-toast: 1400;\n\n  /* ---------- 主题切换过渡 ---------- */\n  --theme-transition: background-color 0.3s ease, color 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;\n\n  /* ---------- 图标尺寸 ---------- */\n  --icon-size-xs: 12px;\n  --icon-size-sm: 14px;\n  --icon-size-md: 16px;\n  --icon-size-lg: 20px;\n  --icon-size-xl: 24px;\n  --icon-size-2xl: 32px;\n\n  /* ---------- L2 Semantic · 图表色板（02 §4.1 / 04 §7.1） ---------- */\n  --color-chart-1: var(--chart-1);\n  --color-chart-2: var(--chart-2);\n  --color-chart-3: var(--chart-3);  /* 暗色提亮为 #8AA2B8（见下方 dark 块，P9-D3） */\n  --color-chart-4: var(--chart-4);\n  --color-chart-5: var(--chart-5);\n  --color-chart-6: var(--chart-6);\n}\n\n/* ============================================================\n * Dark Theme · 仅覆盖 L2 语义层与阴影\n * 触发：[data-theme='dark']\n * ============================================================ */\n[data-theme='dark'] {\n  color-scheme: dark;\n\n  --color-text-primary: var(--gray-1);\n  --color-text-secondary: var(--gray-5);\n  --color-text-tertiary: var(--gray-6);\n  --color-text-disabled: var(--gray-7);\n  --color-text-inverse: var(--gray-14);\n  --color-text-link: var(--brand-6);\n  --color-text-link-hover: var(--brand-5);\n\n  --color-bg-page: var(--gray-14);\n  --color-bg-surface: var(--gray-12);\n  --color-bg-subtle: var(--gray-11);\n  --color-bg-elevated: var(--gray-12);\n  --color-bg-mask: rgba(0, 0, 0, 0.65);\n\n  --color-border-default: var(--gray-10);\n  --color-border-subtle: var(--gray-11);\n  --color-border-focus: var(--brand-6);\n  --color-border-strong: var(--gray-8);\n\n  --color-brand: var(--brand-6);\n  --color-brand-hover: var(--brand-7);\n  --color-brand-active: var(--brand-8);\n  --color-brand-bg: rgba(24, 144, 255, 0.16);\n  --color-brand-border: rgba(24, 144, 255, 0.32);\n\n  /* 品牌发光暗色重定义：跟随暗色主品牌色 #40A9FF（brand-6） */\n  --color-brand-glow-0: rgba(64, 169, 255, 0);\n  --color-brand-glow-20: rgba(64, 169, 255, 0.2);\n  --color-brand-glow-25: rgba(64, 169, 255, 0.25);\n  --color-brand-glow-30: rgba(64, 169, 255, 0.3);\n  --color-brand-glow-35: rgba(64, 169, 255, 0.35);\n  --color-brand-glow-40: rgba(64, 169, 255, 0.4);\n\n  --color-accent: var(--accent-6);\n  --color-accent-hover: var(--accent-7);\n  --color-accent-active: var(--accent-8);\n\n  /* 暖橙暗色提亮（03 §3.2.1：保证对比度） */\n  --color-accent-orange: var(--orange-4);\n  --color-accent-orange-hover: var(--orange-3);\n  --color-accent-orange-active: var(--orange-5);\n  --color-accent-orange-bg: rgba(240, 133, 40, 0.16);\n\n  /* 玫红暗色微调 */\n  --color-rose-bg: rgba(245, 34, 45, 0.16);\n\n  --color-bg-raised: var(--gray-11);\n  --color-bg-overlay: var(--gray-11);\n  --color-bg-tooltip: var(--gray-2);\n\n  --gradient-surface: var(--gradient-surface-dark);\n\n  --color-feedback-success: var(--success-2);\n  --color-feedback-success-bg: rgba(82, 196, 26, 0.16);\n  --color-feedback-warning: var(--warning-2);\n  --color-feedback-warning-bg: rgba(250, 173, 20, 0.16);\n  --color-feedback-error: var(--error-2);\n  --color-feedback-error-bg: rgba(245, 34, 45, 0.16);\n  --color-feedback-info: var(--info-2);\n  --color-feedback-info-bg: rgba(24, 144, 255, 0.16);\n\n  --novel-text-color: var(--gray-3);\n\n  /* 阅读主题：系统暗色时默认指向夜间主题 */\n  --novel-read-bg: var(--read-bg-night);\n  --novel-read-text: var(--read-text-night);\n  --novel-read-text-secondary: var(--read-text-secondary-night);\n\n  /* 图表色板暗色覆盖：chart-3 提亮保证对比度（P9-D3 / 04 §7.1） */\n  --color-chart-3: #8AA2B8;\n\n  --sh-1: 0 1px 2px 0 rgba(0, 0, 0, 0.40);\n  --sh-2: 0 2px 8px 0 rgba(0, 0, 0, 0.44);\n  --sh-3: 0 4px 12px 0 rgba(0, 0, 0, 0.48);\n  --sh-4: 0 8px 24px 0 rgba(0, 0, 0, 0.52);\n  --sh-5: 0 16px 48px 0 rgba(0, 0, 0, 0.56);\n}\n\n/* ============================================================\n * 系统暗色模式自动触发（匹配用户 OS 偏好）\n * ============================================================ */\n@media (prefers-color-scheme: dark) {\n  :root:not([data-theme='light']) {\n    color-scheme: dark;\n\n    --color-text-primary: var(--gray-1);\n    --color-text-secondary: var(--gray-5);\n    --color-text-tertiary: var(--gray-6);\n    --color-text-disabled: var(--gray-7);\n    --color-text-inverse: var(--gray-14);\n    --color-text-link: var(--brand-6);\n    --color-text-link-hover: var(--brand-5);\n\n    --color-bg-page: var(--gray-14);\n    --color-bg-surface: var(--gray-12);\n    --color-bg-subtle: var(--gray-11);\n    --color-bg-elevated: var(--gray-12);\n    --color-bg-mask: rgba(0, 0, 0, 0.65);\n\n    --color-border-default: var(--gray-10);\n    --color-border-subtle: var(--gray-11);\n    --color-border-focus: var(--brand-6);\n    --color-border-strong: var(--gray-8);\n\n    --color-brand: var(--brand-6);\n    --color-brand-hover: var(--brand-7);\n    --color-brand-active: var(--brand-8);\n    --color-brand-bg: rgba(24, 144, 255, 0.16);\n    --color-brand-border: rgba(24, 144, 255, 0.32);\n\n    --color-brand-glow-0: rgba(64, 169, 255, 0);\n    --color-brand-glow-20: rgba(64, 169, 255, 0.2);\n    --color-brand-glow-25: rgba(64, 169, 255, 0.25);\n    --color-brand-glow-30: rgba(64, 169, 255, 0.3);\n    --color-brand-glow-35: rgba(64, 169, 255, 0.35);\n    --color-brand-glow-40: rgba(64, 169, 255, 0.4);\n\n    --color-accent: var(--accent-6);\n    --color-accent-hover: var(--accent-7);\n    --color-accent-active: var(--accent-8);\n\n    --color-accent-orange: var(--orange-4);\n    --color-accent-orange-hover: var(--orange-3);\n    --color-accent-orange-active: var(--orange-5);\n    --color-accent-orange-bg: rgba(240, 133, 40, 0.16);\n\n--color-rose-bg: rgba(245, 34, 45, 0.16);\n\n  --color-bg-raised: var(--gray-11);\n  --color-bg-overlay: var(--gray-11);\n  --color-bg-tooltip: var(--gray-2);\n\n  --gradient-surface: var(--gradient-surface-dark);\n\n    --color-feedback-success: var(--success-2);\n    --color-feedback-success-bg: rgba(82, 196, 26, 0.16);\n    --color-feedback-warning: var(--warning-2);\n    --color-feedback-warning-bg: rgba(250, 173, 20, 0.16);\n    --color-feedback-error: var(--error-2);\n    --color-feedback-error-bg: rgba(245, 34, 45, 0.16);\n    --color-feedback-info: var(--info-2);\n    --color-feedback-info-bg: rgba(24, 144, 255, 0.16);\n\n    --novel-text-color: var(--gray-3);\n\n    --novel-read-bg: var(--read-bg-night);\n    --novel-read-text: var(--read-text-night);\n    --novel-read-text-secondary: var(--read-text-secondary-night);\n\n    --color-chart-3: #8AA2B8;\n\n    --sh-1: 0 1px 2px 0 rgba(0, 0, 0, 0.40);\n    --sh-2: 0 2px 8px 0 rgba(0, 0, 0, 0.44);\n    --sh-3: 0 4px 12px 0 rgba(0, 0, 0, 0.48);\n    --sh-4: 0 8px 24px 0 rgba(0, 0, 0, 0.52);\n    --sh-5: 0 16px 48px 0 rgba(0, 0, 0, 0.56);\n  }\n}\n\n/* ---------- 高对比偏好（无障碍，03 §10） ---------- */\n@media (prefers-contrast: more) {\n  :root {\n    --color-border-default: var(--gray-7);\n    --color-border-subtle: var(--gray-6);\n  }\n  [data-theme='dark'] {\n    --color-border-default: var(--gray-5);\n    --color-border-subtle: var(--gray-6);\n  }\n  @media (prefers-color-scheme: dark) {\n    :root:not([data-theme='light']) {\n      --color-border-default: var(--gray-5);\n      --color-border-subtle: var(--gray-6);\n    }\n  }\n}\n\n/* ---------- 减弱动效（无障碍，01 §10.3） ---------- */\n@media (prefers-reduced-motion: reduce) {\n  :root {\n    --dur-instant: 0ms;\n    --dur-fast: 0ms;\n    --dur-normal: 0ms;\n    --dur-slow: 0ms;\n    --dur-deliberate: 0ms;\n  }\n}\n/* ============================================================\n * Atlas Design System · Reader Theme Tokens\n * 4 阅读主题（日/夜/护眼/羊皮纸），切换时仅改 L2 Semantic 层。\n * 触发：[data-reader-theme='day|night|sepia|parchment']\n * Source: 01-前端底层设计.md §5.6 / 03-C端专项设计.md §3.4\n * ============================================================ */\n\n/* 日间（默认，与系统浅色一致） */\n[data-reader-theme='day'] {\n  --novel-read-bg: var(--read-bg-day);\n  --novel-read-text: var(--read-text-day);\n  --novel-read-text-secondary: var(--read-text-secondary-day);\n}\n\n/* 夜间 */\n[data-reader-theme='night'] {\n  --novel-read-bg: var(--read-bg-night);\n  --novel-read-text: var(--read-text-night);\n  --novel-read-text-secondary: var(--read-text-secondary-night);\n}\n\n/* 护眼（sepia） */\n[data-reader-theme='sepia'] {\n  --novel-read-bg: var(--read-bg-sepia);\n  --novel-read-text: var(--read-text-sepia);\n  --novel-read-text-secondary: var(--read-text-secondary-sepia);\n}\n\n/* 羊皮纸（parchment） */\n[data-reader-theme='parchment'] {\n  --novel-read-bg: var(--read-bg-parchment);\n  --novel-read-text: var(--read-text-parchment);\n  --novel-read-text-secondary: var(--read-text-secondary-parchment);\n}\n\n/* 阅读主题切换强制 instant（90ms），避免色彩流动干扰阅读 */\n[data-reader-theme] {\n  transition:\n    background-color var(--dur-instant) var(--ease-standard),\n    color var(--dur-instant) var(--ease-standard);\n}\n/* ============================================================\n * Atlas Design System · 通用组件样式入口\n * 用法：import '@novel/components/styles.css'\n * 前置：需先引入 '@novel/tokens/styles/tokens.css'\n * ============================================================ */\n\n/* 工具类：BEM 风格变体辅助 */\n.novel-utils-sr-only,\n.sr-only {\n  position: absolute;\n  width: 1px;\n  height: 1px;\n  padding: 0;\n  margin: -1px;\n  overflow: hidden;\n  clip: rect(0, 0, 0, 0);\n  white-space: nowrap;\n  border: 0;\n}\n\n/* P8-A8 屏幕阅读器：焦点时恢复可见（跳转链接/出现位置） */\n.sr-only-focusable:focus,\n.sr-only-focusable:focus-visible {\n  position: static;\n  width: auto;\n  height: auto;\n  overflow: visible;\n  clip: auto;\n  white-space: normal;\n}\n\n/* 减弱动效时禁用所有过渡 */\n@media (prefers-reduced-motion: reduce) {\n  .novel-utils-no-motion,\n  .novel-utils-no-motion * {\n    transition: none !important;\n    animation: none !important;\n  }\n}\n\n/* ============================================================\n * Button · 02 §1.1\n * 5 变体 × 3 尺寸；令牌消费；focus-visible + loading\n * ============================================================ */\n\n.novel-btn {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: var(--space-2);\n  border: 1px solid transparent;\n  border-radius: var(--radius-md);\n  font-family: var(--font-sans);\n  font-weight: var(--font-weight-medium);\n  line-height: 1;\n  white-space: nowrap;\n  cursor: pointer;\n  -webkit-user-select: none;\n     -moz-user-select: none;\n          user-select: none;\n  transition:\n    background-color var(--dur-fast) var(--ease-standard),\n    border-color var(--dur-fast) var(--ease-standard),\n    color var(--dur-fast) var(--ease-standard),\n    box-shadow var(--dur-fast) var(--ease-standard),\n    transform var(--dur-fast) var(--ease-standard);\n}\n\n.novel-btn:focus-visible {\n  outline: none;\n  border-color: var(--color-border-focus);\n  box-shadow: var(--sh-1), 0 0 0 2px var(--color-brand-bg);\n}\n\n.novel-btn:active {\n  transform: translateY(1px);\n}\n\n/* ---------- 尺寸 ---------- */\n.novel-btn--sm {\n  height: 24px;\n  padding: 0 var(--space-3);\n  font-size: var(--font-size-overline);\n}\n.novel-btn--md {\n  height: 32px;\n  padding: 0 var(--space-4);\n  font-size: var(--font-size-caption);\n}\n.novel-btn--lg {\n  height: 40px;\n  padding: 0 var(--space-6);\n  font-size: var(--font-size-body);\n}\n\n/* ---------- 变体 ---------- */\n.novel-btn--primary {\n  background: var(--color-brand);\n  color: var(--color-text-inverse);\n}\n.novel-btn--primary:hover {\n  background: var(--color-brand-hover);\n}\n.novel-btn--primary:active {\n  background: var(--color-brand-active);\n}\n\n.novel-btn--secondary {\n  background: var(--color-bg-surface);\n  color: var(--color-brand);\n  border-color: var(--color-border-default);\n}\n.novel-btn--secondary:hover {\n  border-color: var(--color-brand);\n  background: var(--color-brand-bg);\n}\n.novel-btn--secondary:active {\n  background: var(--color-brand-bg);\n  border-color: var(--color-brand-active);\n}\n\n.novel-btn--ghost {\n  background: transparent;\n  color: var(--color-text-primary);\n}\n.novel-btn--ghost:hover {\n  background: var(--color-bg-subtle);\n}\n.novel-btn--ghost:active {\n  background: var(--color-bg-subtle);\n}\n\n.novel-btn--danger {\n  background: var(--color-feedback-error);\n  color: var(--color-text-inverse);\n}\n.novel-btn--danger:hover {\n  background: var(--color-feedback-error);\n  filter: brightness(1.08);\n}\n.novel-btn--danger:active {\n  filter: brightness(0.92);\n}\n\n.novel-btn--link {\n  background: transparent;\n  color: var(--color-text-link);\n  height: auto;\n  padding: 0;\n  border-color: transparent;\n}\n.novel-btn--link:hover {\n  color: var(--color-text-link-hover);\n  text-decoration: underline;\n}\n.novel-btn--link:focus-visible {\n  box-shadow: none;\n  text-decoration: underline;\n}\n\n/* ---------- 禁用 ---------- */\n.novel-btn:disabled,\n.novel-btn.is-disabled {\n  opacity: 0.5;\n  cursor: not-allowed;\n  pointer-events: none;\n}\n\n/* ---------- 加载态 ---------- */\n.novel-btn.is-loading {\n  cursor: progress;\n  pointer-events: none;\n  /* 加载态下保持内容最小宽度，避免 spinner 替换文字导致抖动 */\n  min-width: 64px;\n}\n.novel-btn--sm.is-loading {\n  min-width: 48px;\n}\n.novel-btn__spin {\n  display: inline-block;\n  width: 1em;\n  height: 1em;\n  border: 1.5px solid currentColor;\n  border-right-color: transparent;\n  border-radius: 50%;\n  animation: novel-btn-spin 0.6s linear infinite;\n  flex-shrink: 0;\n}\n@keyframes novel-btn-spin {\n  to { transform: rotate(360deg); }\n}\n\n/* ---------- 细节边缘 ---------- */\n\n/* 图标按钮（仅图标无文字）：缩小内边距避免失衡 */\n.novel-btn--icon-only {\n  padding: 0;\n  width: 32px;\n}\n.novel-btn--icon-only.novel-btn--sm {\n  width: 24px;\n}\n.novel-btn--icon-only.novel-btn--lg {\n  width: 40px;\n}\n\n/* danger 在暗色下保持对比度 */\n[data-theme='dark'] .novel-btn--danger {\n  filter: brightness(1.15);\n}\n\n/* 长文案按钮：允许换行而非截断 */\n.novel-btn--wrap {\n  white-space: normal;\n  word-break: break-word;\n  line-height: var(--line-height-snug);\n  height: auto;\n  min-height: 32px;\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .novel-btn {\n    transition: none;\n  }\n  .novel-btn:active {\n    transform: none;\n  }\n}\n\n/* ============================================================\n * Input · 02 §1.2\n * 受控单行输入；3 尺寸；3 校验态；prefix 容器\n * ============================================================ */\n\n.novel-input {\n  display: inline-flex;\n  align-items: center;\n  width: 100%;\n  background: var(--color-bg-surface);\n  border: 1px solid var(--color-border-default);\n  border-radius: var(--radius-md);\n  color: var(--color-text-primary);\n  font-family: var(--font-sans);\n  transition:\n    border-color var(--dur-fast) var(--ease-standard),\n    box-shadow var(--dur-fast) var(--ease-standard),\n    background-color var(--dur-fast) var(--ease-standard);\n}\n\n.novel-input:hover {\n  border-color: var(--color-border-strong);\n}\n\n.novel-input:focus-within {\n  border-color: var(--color-border-focus);\n  box-shadow: var(--sh-1);\n}\n\n.novel-input__input {\n  flex: 1;\n  min-width: 0;\n  border: none;\n  outline: none;\n  background: transparent;\n  color: var(--color-text-primary);\n  font-family: inherit;\n  font-size: inherit;\n  line-height: 1;\n}\n.novel-input__input::-moz-placeholder {\n  color: var(--color-text-tertiary);\n}\n.novel-input__input::placeholder {\n  color: var(--color-text-tertiary);\n}\n\n.novel-input__prefix,\n.novel-input__suffix {\n  display: inline-flex;\n  align-items: center;\n  color: var(--color-text-tertiary);\n  flex-shrink: 0;\n}\n\n/* ---------- 尺寸 ---------- */\n.novel-input--sm {\n  height: 24px;\n  font-size: var(--font-size-overline);\n  border-radius: var(--radius-sm);\n}\n.novel-input--sm .novel-input__prefix,\n.novel-input--sm .novel-input__suffix {\n  padding: 0 var(--space-2);\n}\n.novel-input--sm .novel-input__input {\n  padding: 0 var(--space-2);\n}\n\n.novel-input--md {\n  height: 32px;\n  font-size: var(--font-size-caption);\n}\n.novel-input--md .novel-input__prefix,\n.novel-input--md .novel-input__suffix {\n  padding: 0 var(--space-3);\n}\n.novel-input--md .novel-input__input {\n  padding: 0 var(--space-3);\n}\n\n.novel-input--lg {\n  height: 40px;\n  font-size: var(--font-size-body);\n}\n.novel-input--lg .novel-input__prefix,\n.novel-input--lg .novel-input__suffix {\n  padding: 0 var(--space-3);\n}\n.novel-input--lg .novel-input__input {\n  padding: 0 var(--space-4);\n}\n\n/* ---------- 校验态 ---------- */\n.novel-input--error {\n  border-color: var(--color-feedback-error);\n}\n.novel-input--error:focus-within {\n  box-shadow: 0 0 0 2px var(--color-feedback-error-bg);\n}\n.novel-input--warning {\n  border-color: var(--color-feedback-warning);\n}\n.novel-input--warning:focus-within {\n  box-shadow: 0 0 0 2px var(--color-feedback-warning-bg);\n}\n\n/* ---------- 禁用 ---------- */\n.novel-input.is-disabled {\n  background: var(--color-bg-subtle);\n  border-color: var(--color-border-subtle);\n  color: var(--color-text-disabled);\n  cursor: not-allowed;\n}\n.novel-input.is-disabled .novel-input__input {\n  cursor: not-allowed;\n}\n.novel-input.is-disabled:hover {\n  border-color: var(--color-border-subtle);\n}\n.novel-input.is-disabled .novel-input__input::-moz-placeholder {\n  color: var(--color-text-disabled);\n}\n.novel-input.is-disabled .novel-input__input::placeholder {\n  color: var(--color-text-disabled);\n}\n\n/* ---------- 细节边缘 ---------- */\n\n/* 浏览器自动填充：修复黄底背景（WebKit 无 hover 选择器方案） */\n.novel-input__input:-webkit-autofill,\n.novel-input__input:-webkit-autofill:hover,\n.novel-input__input:-webkit-autofill:focus {\n  -webkit-text-fill-color: var(--color-text-primary);\n  -webkit-box-shadow: 0 0 0 1000px var(--color-bg-surface) inset;\n  -webkit-transition: background-color 9999s ease-in-out 0s;\n  transition: background-color 9999s ease-in-out 0s;\n  caret-color: var(--color-brand);\n}\n[data-theme='dark'] .novel-input__input:-webkit-autofill,\n[data-theme='dark'] .novel-input__input:-webkit-autofill:hover,\n[data-theme='dark'] .novel-input__input:-webkit-autofill:focus {\n  -webkit-text-fill-color: var(--color-text-primary);\n  -webkit-box-shadow: 0 0 0 1000px var(--color-bg-surface) inset;\n}\n\n/* type=number：隐藏原生上下 spinner，保持视觉统一 */\n.novel-input__input::-webkit-outer-spin-button,\n.novel-input__input::-webkit-inner-spin-button {\n  -webkit-appearance: none;\n  margin: 0;\n}\n.novel-input__input[type='number'] {\n  -moz-appearance: textfield;\n  -webkit-appearance: textfield;\n          appearance: textfield;\n}\n\n/* type=date / time / month：暗色下修复原生控件图标对比度 */\n.novel-input__input[type='date'],\n.novel-input__input[type='time'],\n.novel-input__input[type='month'],\n.novel-input__input[type='datetime-local'] {\n  color-scheme: light;\n}\n[data-theme='dark'] .novel-input__input[type='date'],\n[data-theme='dark'] .novel-input__input[type='time'],\n[data-theme='dark'] .novel-input__input[type='month'],\n[data-theme='dark'] .novel-input__input[type='datetime-local'] {\n  color-scheme: dark;\n}\n\n/* ============================================================\n * Tag · 02 §1.7\n * 5 语义色；可选关闭\n * ============================================================ */\n\n.novel-tag {\n  display: inline-flex;\n  align-items: center;\n  gap: var(--space-1);\n  height: 22px;\n  padding: 0 var(--space-2);\n  border-radius: var(--radius-sm);\n  font-family: var(--font-sans);\n  font-size: var(--font-size-overline);\n  line-height: 1;\n  white-space: nowrap;\n}\n\n.novel-tag--default {\n  background: var(--color-bg-subtle);\n  color: var(--color-text-secondary);\n}\n.novel-tag--success {\n  background: var(--color-feedback-success-bg);\n  color: var(--color-feedback-success);\n}\n.novel-tag--warning {\n  background: var(--color-feedback-warning-bg);\n  color: var(--color-feedback-warning);\n}\n.novel-tag--error {\n  background: var(--color-feedback-error-bg);\n  color: var(--color-feedback-error);\n}\n.novel-tag--primary {\n  background: var(--color-brand-bg);\n  color: var(--color-brand);\n}\n\n.novel-tag__close {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  width: 14px;\n  height: 14px;\n  margin-left: var(--space-1);\n  margin-right: calc(var(--space-1) * -1);\n  border: none;\n  background: transparent;\n  color: currentColor;\n  opacity: 0.6;\n  cursor: pointer;\n  border-radius: var(--radius-xs);\n  transition: opacity var(--dur-fast) var(--ease-standard);\n}\n.novel-tag__close:hover {\n  opacity: 1;\n}\n.novel-tag__close:focus-visible {\n  outline: none;\n  opacity: 1;\n  box-shadow: 0 0 0 2px var(--color-brand-bg);\n}\n\n/* ============================================================\n * Badge · 02 §1.7\n * 计数 / 小红点 / 溢出 99+\n * ============================================================ */\n\n.novel-badge {\n  position: relative;\n  display: inline-flex;\n}\n\n.novel-badge__count {\n  position: absolute;\n  top: 0;\n  right: 0;\n  transform: translate(50%, -50%);\n  min-width: 16px;\n  height: 16px;\n  padding: 0 4px;\n  box-sizing: border-box;\n  border-radius: var(--radius-full);\n  background: var(--color-feedback-error);\n  color: var(--color-text-inverse);\n  font-family: var(--font-sans);\n  font-size: 10px;\n  font-weight: var(--font-weight-semibold);\n  line-height: 16px;\n  text-align: center;\n  z-index: 1;\n}\n\n.novel-badge__dot {\n  position: absolute;\n  top: 2px;\n  right: 2px;\n  width: 8px;\n  height: 8px;\n  border-radius: 50%;\n  background: var(--color-feedback-error);\n  box-shadow: 0 0 0 1.5px var(--color-bg-surface);\n  z-index: 1;\n}\n\n/* ============================================================\n * Avatar · 02 §1.10\n * 图片 / 首字兜底；3 尺寸；2 形状\n * ============================================================ */\n\n.novel-avatar {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  overflow: hidden;\n  background: var(--color-brand-bg);\n  color: var(--color-brand);\n  font-family: var(--font-sans);\n  font-weight: var(--font-weight-semibold);\n  line-height: 1;\n  flex-shrink: 0;\n  -webkit-user-select: none;\n     -moz-user-select: none;\n          user-select: none;\n}\n\n.novel-avatar--sm {\n  width: 24px;\n  height: 24px;\n  font-size: var(--font-size-overline);\n}\n.novel-avatar--md {\n  width: 32px;\n  height: 32px;\n  font-size: var(--font-size-caption);\n}\n.novel-avatar--lg {\n  width: 48px;\n  height: 48px;\n  font-size: var(--font-size-body);\n}\n\n.novel-avatar--circle {\n  border-radius: var(--radius-full);\n}\n.novel-avatar--square {\n  border-radius: var(--radius-md);\n}\n\n.novel-avatar__img {\n  width: 100%;\n  height: 100%;\n  -o-object-fit: cover;\n     object-fit: cover;\n  display: block;\n  /* 图片加载完成前保持占位背景，避免破图/白闪 */\n  background: var(--color-bg-subtle);\n}\n\n/* ---------- 细节边缘 ---------- */\n\n/* 图片加载失败时隐藏破损图占位（配合组件 onError 逻辑切换到文字回退） */\n.novel-avatar__img.is-error {\n  display: none;\n}\n\n.novel-avatar__fallback-text {\n  font-size: 0.45em;\n  color: var(--color-brand);\n  max-width: 80%;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n  padding: 0 4px;\n}\n\n/* 图片淡入：避免加载完成瞬间突兀 */\n.novel-avatar__img.is-loaded {\n  animation: novel-avatar-fade-in var(--dur-fast) var(--ease-decelerate);\n}\n\n@keyframes novel-avatar-fade-in {\n  from { opacity: 0; }\n  to { opacity: 1; }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .novel-avatar__img.is-loaded {\n    animation: none;\n  }\n}\n\n/* ============================================================\n * Switch · 02 §1.11\n * 二元开关；2 尺寸；brand 开启色\n * ============================================================ */\n\n.novel-switch {\n  position: relative;\n  display: inline-flex;\n  flex-shrink: 0;\n  border: none;\n  background: var(--color-bg-subtle);\n  border-radius: var(--radius-full);\n  cursor: pointer;\n  padding: 0;\n  transition: background-color var(--dur-fast) var(--ease-standard);\n}\n\n.novel-switch__thumb {\n  position: absolute;\n  top: 50%;\n  left: 2px;\n  transform: translateY(-50%);\n  background: var(--color-bg-surface);\n  border-radius: 50%;\n  box-shadow: var(--sh-1);\n  transition: left var(--dur-fast) var(--ease-standard);\n}\n\n/* sm: 28×16，圆点 12 */\n.novel-switch--sm {\n  width: 28px;\n  height: 16px;\n}\n.novel-switch--sm .novel-switch__thumb {\n  width: 12px;\n  height: 12px;\n}\n.novel-switch--sm.is-checked .novel-switch__thumb {\n  left: 14px;\n}\n\n/* md: 40×22，圆点 18 */\n.novel-switch--md {\n  width: 40px;\n  height: 22px;\n}\n.novel-switch--md .novel-switch__thumb {\n  width: 18px;\n  height: 18px;\n}\n.novel-switch--md.is-checked .novel-switch__thumb {\n  left: 20px;\n}\n\n.novel-switch.is-checked {\n  background: var(--color-brand);\n}\n\n.novel-switch:focus-visible {\n  outline: 2px solid var(--color-border-focus);\n  outline-offset: 2px;\n}\n.novel-switch:active .novel-switch__thumb {\n  transform: scale(0.92);\n}\n.novel-switch:hover:not(:disabled) {\n  opacity: 0.9;\n}\n\n.novel-switch.is-disabled {\n  opacity: 0.5;\n  cursor: not-allowed;\n}\n\n/* ============================================================\n * Checkbox · 02 §1.12\n * 多选 + indeterminate 半选\n * ============================================================ */\n\n.novel-checkbox {\n  display: inline-flex;\n  align-items: center;\n  gap: var(--space-2);\n  cursor: pointer;\n  font-family: var(--font-sans);\n  font-size: var(--font-size-caption);\n  color: var(--color-text-primary);\n  -webkit-user-select: none;\n     -moz-user-select: none;\n          user-select: none;\n}\n\n.novel-checkbox__box {\n  position: relative;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  width: 16px;\n  height: 16px;\n  border: 1.5px solid var(--color-border-strong);\n  border-radius: var(--radius-xs);\n  background: var(--color-bg-surface);\n  flex-shrink: 0;\n  transition:\n    background-color var(--dur-fast) var(--ease-standard),\n    border-color var(--dur-fast) var(--ease-standard);\n}\n\n.novel-checkbox__check {\n  width: 10px;\n  height: 10px;\n  color: var(--color-text-inverse);\n  opacity: 0;\n  transform: scale(0.6);\n  transition: opacity var(--dur-fast) var(--ease-standard), transform var(--dur-fast) var(--ease-standard);\n}\n\n.novel-checkbox__indeterminate {\n  width: 10px;\n  height: 2px;\n  background: var(--color-text-inverse);\n  border-radius: 1px;\n  opacity: 0;\n  transition: opacity var(--dur-fast) var(--ease-standard);\n}\n\n.novel-checkbox.is-checked .novel-checkbox__box {\n  background: var(--color-brand);\n  border-color: var(--color-brand);\n}\n.novel-checkbox.is-checked .novel-checkbox__check {\n  opacity: 1;\n  transform: scale(1);\n}\n\n.novel-checkbox.is-indeterminate .novel-checkbox__box {\n  background: var(--color-brand);\n  border-color: var(--color-brand);\n}\n.novel-checkbox.is-indeterminate .novel-checkbox__indeterminate {\n  opacity: 1;\n}\n\n.novel-checkbox:hover:not(.is-disabled) .novel-checkbox__box {\n  border-color: var(--color-brand);\n}\n\n.novel-checkbox:focus-within .novel-checkbox__box {\n  box-shadow: 0 0 0 2px var(--color-brand-bg);\n}\n\n.novel-checkbox:focus-visible {\n  outline: 2px solid var(--color-border-focus);\n  outline-offset: 2px;\n  border-radius: var(--radius-sm);\n}\n.novel-checkbox:active {\n  transform: scale(0.95);\n}\n\n.novel-checkbox.is-disabled {\n  opacity: 0.5;\n  cursor: not-allowed;\n}\n\n.novel-checkbox__input {\n  position: absolute;\n  opacity: 0;\n  width: 0;\n  height: 0;\n  pointer-events: none;\n}\n\n/* ============================================================\n * Radio · 02 §1.12\n * Radio.Group 单选组\n * ============================================================ */\n\n.novel-radio {\n  display: inline-flex;\n  align-items: center;\n  gap: var(--space-2);\n  cursor: pointer;\n  font-family: var(--font-sans);\n  font-size: var(--font-size-caption);\n  color: var(--color-text-primary);\n  -webkit-user-select: none;\n     -moz-user-select: none;\n          user-select: none;\n}\n\n.novel-radio__box {\n  position: relative;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  width: 16px;\n  height: 16px;\n  border: 1.5px solid var(--color-border-strong);\n  border-radius: 50%;\n  background: var(--color-bg-surface);\n  flex-shrink: 0;\n  transition:\n    border-color var(--dur-fast) var(--ease-standard);\n}\n\n.novel-radio__dot {\n  width: 8px;\n  height: 8px;\n  border-radius: 50%;\n  background: var(--color-text-inverse);\n  opacity: 0;\n  transform: scale(0.4);\n  transition: opacity var(--dur-fast) var(--ease-standard), transform var(--dur-fast) var(--ease-standard);\n}\n\n.novel-radio.is-checked .novel-radio__box {\n  border-color: var(--color-brand);\n  background: var(--color-brand);\n}\n.novel-radio.is-checked .novel-radio__dot {\n  opacity: 1;\n  transform: scale(1);\n}\n\n.novel-radio:hover:not(.is-disabled) .novel-radio__box {\n  border-color: var(--color-brand);\n}\n\n.novel-radio:focus-within .novel-radio__box {\n  box-shadow: 0 0 0 2px var(--color-brand-bg);\n}\n\n.novel-radio:focus-visible {\n  outline: 2px solid var(--color-border-focus);\n  outline-offset: 2px;\n  border-radius: var(--radius-full);\n}\n.novel-radio:active {\n  transform: scale(0.95);\n}\n\n.novel-radio.is-disabled {\n  opacity: 0.5;\n  cursor: not-allowed;\n}\n\n.novel-radio__input {\n  position: absolute;\n  opacity: 0;\n  width: 0;\n  height: 0;\n  pointer-events: none;\n}\n\n/* ---------- Group ---------- */\n.novel-radio-group {\n  display: inline-flex;\n  gap: var(--space-6);\n  flex-wrap: wrap;\n}\n.novel-radio-group--vertical {\n  flex-direction: column;\n  gap: var(--space-3);\n}\n\n/* ============================================================\n * Tooltip · 02 §1.8\n * 纯文本提示；hover/focus 触发；dur-fast 渐显\n * ============================================================ */\n\n.novel-tooltip {\n  max-width: 240px;\n  padding: var(--space-1) var(--space-2);\n  background: var(--color-bg-tooltip);\n  color: var(--color-text-inverse);\n  font-family: var(--font-sans);\n  font-size: var(--font-size-overline);\n  line-height: var(--line-height-normal);\n  border-radius: var(--radius-sm);\n  box-shadow: var(--sh-2);\n  z-index: var(--z-index-dropdown);\n  opacity: 0;\n  transform: translateY(4px);\n  transition:\n    opacity var(--dur-fast) var(--ease-standard),\n    transform var(--dur-fast) var(--ease-standard);\n}\n\n.novel-tooltip.is-ready {\n  opacity: 1;\n  transform: translateY(0);\n}\n\n.novel-tooltip--bottom {\n  transform: translateY(-4px);\n}\n.novel-tooltip--bottom.is-ready {\n  transform: translateY(0);\n}\n\n/* ============================================================\n * Popover · 02 §1.8\n * 富内容；hover/click 触发\n * ============================================================ */\n\n.novel-popover {\n  max-width: 320px;\n  background: var(--color-bg-surface);\n  color: var(--color-text-primary);\n  font-family: var(--font-sans);\n  font-size: var(--font-size-caption);\n  border-radius: var(--radius-md);\n  box-shadow: var(--sh-2);\n  z-index: var(--z-index-dropdown);\n  opacity: 0;\n  transform: translateY(4px);\n  transition:\n    opacity var(--dur-fast) var(--ease-standard),\n    transform var(--dur-fast) var(--ease-standard);\n}\n\n.novel-popover.is-ready {\n  opacity: 1;\n  transform: translateY(0);\n}\n\n.novel-popover__header {\n  padding: var(--space-3) var(--space-4);\n  border-bottom: 1px solid var(--color-border-subtle);\n  font-weight: var(--font-weight-semibold);\n  font-size: var(--font-size-caption);\n  color: var(--color-text-primary);\n}\n\n.novel-popover__body {\n  padding: var(--space-3) var(--space-4);\n  color: var(--color-text-secondary);\n}\n\n.novel-popover--bottom {\n  transform: translateY(-4px);\n}\n.novel-popover--bottom.is-ready {\n  transform: translateY(0);\n}\n\n/* ============================================================\n * Dropdown · 02 §1.9\n * 下拉菜单；items + danger + divider\n * ============================================================ */\n\n.novel-dropdown__menu {\n  min-width: 160px;\n  max-height: 280px;\n  overflow-y: auto;\n  background: var(--color-bg-surface);\n  border-radius: var(--radius-md);\n  box-shadow: var(--sh-3);\n  z-index: var(--z-index-dropdown);\n  padding: var(--space-1) 0;\n  opacity: 0;\n  transform: translateY(-4px);\n  transition:\n    opacity var(--dur-fast) var(--ease-standard),\n    transform var(--dur-fast) var(--ease-standard);\n}\n\n.novel-dropdown__menu.is-ready {\n  opacity: 1;\n  transform: translateY(0);\n}\n\n.novel-dropdown__item {\n  display: flex;\n  align-items: center;\n  gap: var(--space-2);\n  padding: var(--space-2) var(--space-4);\n  font-family: var(--font-sans);\n  font-size: var(--font-size-caption);\n  color: var(--color-text-primary);\n  cursor: pointer;\n  border: none;\n  background: transparent;\n  width: 100%;\n  text-align: left;\n}\n.novel-dropdown__item:focus-visible {\n  outline: 2px solid var(--color-border-focus);\n  outline-offset: -2px;\n  border-radius: var(--radius-sm);\n}\n.novel-dropdown__item:active {\n  background: var(--color-bg-subtle);\n}\n.novel-dropdown__item:hover:not(.is-disabled) {\n  background: var(--color-bg-subtle);\n}\n.novel-dropdown__item.is-disabled {\n  color: var(--color-text-disabled);\n  cursor: not-allowed;\n}\n.novel-dropdown__item.is-danger {\n  color: var(--color-feedback-error);\n}\n.novel-dropdown__item.is-disabled.is-danger {\n  color: var(--color-text-disabled);\n}\n\n.novel-dropdown__divider {\n  height: 1px;\n  margin: var(--space-1) 0;\n  background: var(--color-border-subtle);\n}\n\n/* ============================================================\n * Alert / Message / Notification · 02 §1.13\n * ============================================================ */\n\n/* ---------- Alert 内联提示 ---------- */\n.novel-alert {\n  display: flex;\n  gap: var(--space-3);\n  padding: var(--space-3) var(--space-4);\n  border-radius: var(--radius-md);\n  font-family: var(--font-sans);\n  font-size: var(--font-size-caption);\n  position: relative;\n  overflow: hidden;\n}\n\n.novel-alert::before {\n  content: '';\n  position: absolute;\n  left: 0;\n  top: 0;\n  bottom: 0;\n  width: 4px;\n}\n\n.novel-alert--info {\n  background: var(--color-feedback-info-bg);\n  color: var(--color-text-primary);\n}\n.novel-alert--info::before { background: var(--color-feedback-info); }\n\n.novel-alert--success {\n  background: var(--color-feedback-success-bg);\n  color: var(--color-text-primary);\n}\n.novel-alert--success::before { background: var(--color-feedback-success); }\n\n.novel-alert--warning {\n  background: var(--color-feedback-warning-bg);\n  color: var(--color-text-primary);\n}\n.novel-alert--warning::before { background: var(--color-feedback-warning); }\n\n.novel-alert--error {\n  background: var(--color-feedback-error-bg);\n  color: var(--color-text-primary);\n}\n.novel-alert--error::before { background: var(--color-feedback-error); }\n\n.novel-alert__icon {\n  flex-shrink: 0;\n  width: 16px;\n  height: 16px;\n  margin-top: 1px;\n}\n.novel-alert--info .novel-alert__icon { color: var(--color-feedback-info); }\n.novel-alert--success .novel-alert__icon { color: var(--color-feedback-success); }\n.novel-alert--warning .novel-alert__icon { color: var(--color-feedback-warning); }\n.novel-alert--error .novel-alert__icon { color: var(--color-feedback-error); }\n\n.novel-alert__body {\n  flex: 1;\n  min-width: 0;\n}\n.novel-alert__message {\n  font-weight: var(--font-weight-medium);\n  color: var(--color-text-primary);\n  line-height: var(--line-height-normal);\n}\n.novel-alert__description {\n  margin-top: var(--space-1);\n  color: var(--color-text-secondary);\n  font-size: var(--font-size-overline);\n  line-height: var(--line-height-normal);\n}\n\n.novel-alert__close {\n  flex-shrink: 0;\n  border: none;\n  background: transparent;\n  color: var(--color-text-tertiary);\n  cursor: pointer;\n  padding: 0;\n  display: inline-flex;\n  align-items: center;\n}\n.novel-alert__close:hover { color: var(--color-text-primary); }\n\n/* ---------- Message 顶部居中 ---------- */\n.novel-message-container {\n  position: fixed;\n  top: var(--space-6);\n  left: 50%;\n  transform: translateX(-50%);\n  z-index: var(--z-index-toast);\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: var(--space-2);\n  pointer-events: none;\n}\n.novel-message {\n  display: inline-flex;\n  align-items: center;\n  gap: var(--space-2);\n  padding: var(--space-2) var(--space-4);\n  background: var(--color-bg-tooltip);\n  color: var(--color-text-inverse);\n  font-family: var(--font-sans);\n  font-size: var(--font-size-caption);\n  border-radius: var(--radius-md);\n  box-shadow: var(--sh-2);\n  pointer-events: auto;\n  opacity: 0;\n  transform: translateY(-8px);\n  transition:\n    opacity var(--dur-normal) var(--ease-standard),\n    transform var(--dur-normal) var(--ease-standard);\n}\n.novel-message.is-ready {\n  opacity: 1;\n  transform: translateY(0);\n}\n.novel-message__icon {\n  width: 16px;\n  height: 16px;\n  flex-shrink: 0;\n}\n\n/* ---------- Notification 右上角 ---------- */\n.novel-notification-container {\n  position: fixed;\n  top: var(--space-6);\n  right: var(--space-6);\n  z-index: var(--z-index-toast);\n  display: flex;\n  flex-direction: column;\n  gap: var(--space-3);\n  pointer-events: none;\n  max-width: 360px;\n}\n.novel-notification {\n  display: flex;\n  gap: var(--space-3);\n  padding: var(--space-4);\n  background: var(--color-bg-surface);\n  color: var(--color-text-primary);\n  font-family: var(--font-sans);\n  font-size: var(--font-size-caption);\n  border-radius: var(--radius-md);\n  box-shadow: var(--sh-3);\n  pointer-events: auto;\n  opacity: 0;\n  transform: translateX(8px);\n  transition:\n    opacity var(--dur-normal) var(--ease-standard),\n    transform var(--dur-normal) var(--ease-standard);\n}\n.novel-notification.is-ready {\n  opacity: 1;\n  transform: translateX(0);\n}\n.novel-notification__body {\n  flex: 1;\n  min-width: 0;\n}\n.novel-notification__title {\n  font-weight: var(--font-weight-semibold);\n  color: var(--color-text-primary);\n  line-height: var(--line-height-normal);\n}\n.novel-notification__description {\n  margin-top: var(--space-1);\n  color: var(--color-text-secondary);\n  font-size: var(--font-size-overline);\n  line-height: var(--line-height-normal);\n}\n.novel-notification__close {\n  flex-shrink: 0;\n  border: none;\n  background: transparent;\n  color: var(--color-text-tertiary);\n  cursor: pointer;\n  padding: 0;\n  display: inline-flex;\n  align-items: center;\n}\n.novel-notification__close:hover { color: var(--color-text-primary); }\n\n/* ============================================================\n * EmptyState / Skeleton · 02 §1.14\n * ============================================================ */\n\n.novel-empty {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  padding: var(--space-12) var(--space-6);\n  text-align: center;\n}\n\n.novel-empty__illustration {\n  width: 120px;\n  height: 120px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  color: var(--color-text-tertiary);\n  /* 轻微浮动：空状态插画更生动 */\n  animation: novel-empty-float 3s var(--ease-standard) infinite;\n}\n\n@keyframes novel-empty-float {\n  0%, 100% { transform: translateY(0); }\n  50% { transform: translateY(-6px); }\n}\n\n.novel-empty__title {\n  margin-top: var(--space-4);\n  font-family: var(--font-sans);\n  font-size: var(--font-size-body);\n  font-weight: var(--font-weight-medium);\n  color: var(--color-text-primary);\n}\n\n.novel-empty__description {\n  margin-top: var(--space-2);\n  font-family: var(--font-sans);\n  font-size: var(--font-size-caption);\n  color: var(--color-text-tertiary);\n  line-height: var(--line-height-normal);\n  max-width: 320px;\n}\n\n.novel-empty__actions {\n  margin-top: var(--space-6);\n  display: flex;\n  gap: var(--space-3);\n}\n\n/* ---------- 细节边缘 ---------- */\n\n/* 空状态整卡进入动画 */\n.novel-empty.is-enter {\n  animation: novel-empty-enter var(--dur-normal) var(--ease-decelerate) both;\n}\n\n@keyframes novel-empty-enter {\n  from {\n    opacity: 0;\n    transform: translateY(12px);\n  }\n  to {\n    opacity: 1;\n    transform: translateY(0);\n  }\n}\n\n/* 暗色模式：插画颜色提亮，避免灰底上不可见 */\n[data-theme='dark'] .novel-empty__illustration {\n  color: var(--color-text-secondary);\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .novel-empty__illustration,\n  .novel-empty.is-enter {\n    animation: none;\n  }\n}\n\n/* ---------- Skeleton ---------- */\n.novel-skeleton {\n  width: 100%;\n}\n\n.novel-skeleton__line {\n  height: 14px;\n  margin-bottom: var(--space-2);\n  background: var(--color-bg-subtle);\n  border-radius: var(--radius-sm);\n  position: relative;\n  overflow: hidden;\n}\n\n.novel-skeleton__line:last-child {\n  margin-bottom: 0;\n  width: 60%;\n}\n\n.novel-skeleton__avatar {\n  width: 40px;\n  height: 40px;\n  background: var(--color-bg-subtle);\n  border-radius: 50%;\n  flex-shrink: 0;\n  position: relative;\n  overflow: hidden;\n}\n\n.novel-skeleton__row {\n  display: flex;\n  gap: var(--space-3);\n  margin-bottom: var(--space-3);\n}\n\n.novel-skeleton.is-active .novel-skeleton__line,\n.novel-skeleton.is-active .novel-skeleton__avatar {\n  background: linear-gradient(\n    90deg,\n    var(--color-bg-subtle) 0%,\n    var(--color-bg-elevated) 50%,\n    var(--color-bg-subtle) 100%\n  );\n  background-size: 200% 100%;\n  animation: novel-skeleton-shimmer var(--dur-slow) var(--ease-standard) infinite;\n}\n\n@keyframes novel-skeleton-shimmer {\n  0% { background-position: 200% 0; }\n  100% { background-position: -200% 0; }\n}\n\n/* ---------- 细节边缘：骨架屏首尾呼吸 ---------- */\n.novel-skeleton__line:first-child {\n  width: 40%;\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .novel-skeleton.is-active .novel-skeleton__line,\n  .novel-skeleton.is-active .novel-skeleton__avatar {\n    animation: none;\n  }\n}\n\n/* ============================================================\n * Modal · 02 §1.4\n * 遮罩 + 缩放渐显；Esc 关闭；focus trap（简化版）\n * ============================================================ */\n\n.novel-modal__mask {\n  position: fixed;\n  inset: 0;\n  background: var(--color-bg-mask);\n  z-index: var(--z-index-modal);\n  opacity: 0;\n  transition: opacity var(--dur-normal) var(--ease-standard);\n}\n.novel-modal__mask.is-ready {\n  opacity: 1;\n}\n\n.novel-modal {\n  position: fixed;\n  top: 50%;\n  left: 50%;\n  transform: translate(-50%, -50%) scale(0.96);\n  background: var(--color-bg-surface);\n  border-radius: var(--radius-lg);\n  box-shadow: var(--sh-4);\n  z-index: calc(var(--z-index-modal) + 1);\n  opacity: 0;\n  transition:\n    opacity var(--dur-normal) var(--ease-standard),\n    transform var(--dur-normal) var(--ease-standard);\n  max-height: calc(100vh - var(--space-16) * 2);\n  display: flex;\n  flex-direction: column;\n}\n.novel-modal.is-ready {\n  opacity: 1;\n  transform: translate(-50%, -50%) scale(1);\n}\n\n.novel-modal__header {\n  padding: var(--space-4) var(--space-6);\n  border-bottom: 1px solid var(--color-border-subtle);\n  font-family: var(--font-sans);\n  font-size: var(--font-size-body);\n  font-weight: var(--font-weight-semibold);\n  color: var(--color-text-primary);\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n}\n\n.novel-modal__close {\n  border: none;\n  background: transparent;\n  color: var(--color-text-tertiary);\n  cursor: pointer;\n  padding: var(--space-1);\n  display: inline-flex;\n  border-radius: var(--radius-sm);\n}\n.novel-modal__close:hover {\n  color: var(--color-text-primary);\n  background: var(--color-bg-subtle);\n}\n\n.novel-modal__body {\n  padding: var(--space-6);\n  font-family: var(--font-sans);\n  font-size: var(--font-size-caption);\n  color: var(--color-text-secondary);\n  line-height: var(--line-height-normal);\n  overflow-y: auto;\n  flex: 1;\n}\n\n.novel-modal__footer {\n  padding: var(--space-4) var(--space-6);\n  border-top: 1px solid var(--color-border-subtle);\n  display: flex;\n  justify-content: flex-end;\n  gap: var(--space-2);\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .novel-modal,\n  .novel-modal__mask {\n    transition: opacity var(--dur-instant) var(--ease-standard);\n  }\n  .novel-modal {\n    transform: translate(-50%, -50%);\n  }\n}\n\n/* ============================================================\n * Drawer · 02 §1.5\n * 侧边滑入；header/body/footer 分层；移动端自动撑满\n * ============================================================ */\n\n.novel-drawer__mask {\n  position: fixed;\n  inset: 0;\n  background: var(--color-bg-mask);\n  z-index: var(--z-index-drawer);\n  opacity: 0;\n  transition: opacity var(--dur-normal) var(--ease-standard);\n}\n.novel-drawer__mask.is-ready {\n  opacity: 1;\n}\n\n.novel-drawer {\n  position: fixed;\n  top: 0;\n  bottom: 0;\n  background: var(--color-bg-surface);\n  box-shadow: var(--sh-4);\n  z-index: calc(var(--z-index-drawer) + 1);\n  display: flex;\n  flex-direction: column;\n  transition: transform var(--dur-normal) var(--ease-standard);\n}\n\n/* ---------- 方向 ---------- */\n.novel-drawer--right {\n  right: 0;\n  transform: translateX(100%);\n}\n.novel-drawer--right.is-ready {\n  transform: translateX(0);\n}\n.novel-drawer--left {\n  left: 0;\n  transform: translateX(-100%);\n}\n.novel-drawer--left.is-ready {\n  transform: translateX(0);\n}\n\n/* ---------- 头部 ---------- */\n.novel-drawer__header {\n  padding: var(--space-4) var(--space-6);\n  border-bottom: 1px solid var(--color-border-subtle);\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: var(--space-4);\n  flex-shrink: 0;\n}\n.novel-drawer__title {\n  font-family: var(--font-sans);\n  font-size: var(--font-size-body);\n  font-weight: var(--font-weight-semibold);\n  color: var(--color-text-primary);\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n.novel-drawer__close {\n  border: none;\n  background: transparent;\n  color: var(--color-text-tertiary);\n  cursor: pointer;\n  padding: var(--space-1);\n  display: inline-flex;\n  border-radius: var(--radius-sm);\n  flex-shrink: 0;\n}\n.novel-drawer__close:hover {\n  color: var(--color-text-primary);\n  background: var(--color-bg-subtle);\n}\n\n/* ---------- 内容区（内部滚动） ---------- */\n.novel-drawer__body {\n  padding: var(--space-6);\n  font-family: var(--font-sans);\n  font-size: var(--font-size-caption);\n  color: var(--color-text-secondary);\n  line-height: var(--line-height-normal);\n  overflow-y: auto;\n  flex: 1;\n}\n\n/* ---------- 底部 ---------- */\n.novel-drawer__footer {\n  padding: var(--space-4) var(--space-6);\n  border-top: 1px solid var(--color-border-subtle);\n  background: var(--color-bg-subtle);\n  display: flex;\n  justify-content: flex-end;\n  gap: var(--space-2);\n  flex-shrink: 0;\n}\n\n/* ---------- 移动端：自动撑满 ---------- */\n@media (max-width: 575px) {\n  .novel-drawer {\n    width: 100% !important;\n  }\n}\n\n/* ---------- 减弱动效 ---------- */\n@media (prefers-reduced-motion: reduce) {\n  .novel-drawer,\n  .novel-drawer__mask {\n    transition: opacity var(--dur-instant) var(--ease-standard);\n  }\n  .novel-drawer--right,\n  .novel-drawer--left {\n    transform: translateX(0);\n  }\n}\n\n/* ============================================================\n * Tabs · 02 §1.6\n * line / card 两种样式；底部指示条；溢出滚动\n * ============================================================ */\n\n.novel-tabs {\n  display: flex;\n  flex-direction: column;\n}\n\n/* ---------- 尺寸 ---------- */\n.novel-tabs--sm .novel-tabs__tab {\n  padding: var(--space-2) var(--space-3);\n  font-size: var(--font-size-overline);\n}\n.novel-tabs--md .novel-tabs__tab {\n  padding: var(--space-3) var(--space-4);\n  font-size: var(--font-size-caption);\n}\n.novel-tabs--lg .novel-tabs__tab {\n  padding: var(--space-4) var(--space-6);\n  font-size: var(--font-size-body);\n}\n\n/* ---------- 导航区 ---------- */\n.novel-tabs__nav {\n  position: relative;\n  display: flex;\n  align-items: stretch;\n  overflow-x: auto;\n  scrollbar-width: none;\n}\n.novel-tabs__nav::-webkit-scrollbar {\n  display: none;\n}\n\n/* ---------- Tab 项 ---------- */\n.novel-tabs__tab {\n  position: relative;\n  border: none;\n  background: transparent;\n  cursor: pointer;\n  font-family: var(--font-sans);\n  font-weight: var(--font-weight-medium);\n  color: var(--color-text-secondary);\n  white-space: nowrap;\n  transition: color var(--dur-fast) var(--ease-standard);\n  flex-shrink: 0;\n}\n.novel-tabs__tab:hover:not(.is-disabled):not(.is-active) {\n  color: var(--color-text-primary);\n}\n.novel-tabs__tab:focus-visible {\n  outline: 2px solid var(--color-border-focus);\n  outline-offset: 2px;\n  border-radius: var(--radius-sm);\n}\n.novel-tabs__tab:active {\n  opacity: 0.8;\n}\n.novel-tabs__tab.is-active {\n  color: var(--color-brand);\n  font-weight: var(--font-weight-semibold);\n}\n.novel-tabs__tab.is-disabled {\n  color: var(--color-text-disabled);\n  cursor: not-allowed;\n}\n\n/* ---------- line 样式：底部指示条 ---------- */\n.novel-tabs--line .novel-tabs__nav {\n  border-bottom: 1px solid var(--color-border-subtle);\n}\n.novel-tabs__indicator {\n  position: absolute;\n  bottom: -1px;\n  left: 0;\n  height: 2px;\n  background: var(--color-brand);\n  border-radius: var(--radius-full);\n  transition: transform var(--dur-normal) var(--ease-standard),\n    width var(--dur-normal) var(--ease-standard);\n}\n\n/* ---------- card 样式 ---------- */\n.novel-tabs--card .novel-tabs__tab {\n  border: 1px solid transparent;\n  border-bottom: none;\n  border-radius: var(--radius-md) var(--radius-md) 0 0;\n  background: transparent;\n  margin-right: var(--space-1);\n}\n.novel-tabs--card .novel-tabs__tab.is-active {\n  background: var(--color-bg-surface);\n  border-color: var(--color-border-subtle);\n  color: var(--color-text-primary);\n}\n.novel-tabs--card .novel-tabs__nav {\n  border-bottom: 1px solid var(--color-border-subtle);\n  gap: var(--space-1);\n}\n\n/* ---------- 内容区 ---------- */\n.novel-tabs__content {\n  padding-top: var(--space-4);\n}\n\n/* ---------- 减弱动效 ---------- */\n@media (prefers-reduced-motion: reduce) {\n  .novel-tabs__indicator {\n    transition: none;\n  }\n}\n\n/* ============================================================\n * Pagination · 02 §1.15\n * ============================================================ */\n\n.novel-pagination {\n  display: flex;\n  align-items: center;\n  gap: var(--space-4);\n  font-family: var(--font-sans);\n  font-size: var(--font-size-caption);\n  color: var(--color-text-secondary);\n}\n\n.novel-pagination__total {\n  color: var(--color-text-tertiary);\n}\n\n.novel-pagination__list {\n  display: flex;\n  align-items: center;\n  gap: var(--space-1);\n  list-style: none;\n  margin: 0;\n  padding: 0;\n}\n\n.novel-pagination__item {\n  min-width: 32px;\n  height: 32px;\n  padding: 0 var(--space-2);\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  border: 1px solid transparent;\n  border-radius: var(--radius-md);\n  background: transparent;\n  color: var(--color-text-secondary);\n  cursor: pointer;\n  font-family: inherit;\n  font-size: inherit;\n  transition: all var(--dur-fast) var(--ease-standard);\n}\n.novel-pagination__item:hover:not(.is-active):not(:disabled) {\n  color: var(--color-brand);\n  background: var(--color-brand-bg);\n}\n.novel-pagination__item:focus-visible {\n  outline: 2px solid var(--color-border-focus);\n  outline-offset: 2px;\n  border-radius: var(--radius-sm);\n}\n.novel-pagination__item:active:not(:disabled) {\n  transform: scale(0.95);\n}\n.novel-pagination__item.is-active {\n  background: var(--color-brand);\n  color: var(--color-text-inverse);\n  font-weight: var(--font-weight-medium);\n  cursor: default;\n}\n.novel-pagination__item:disabled {\n  color: var(--color-text-disabled);\n  cursor: not-allowed;\n}\n\n.novel-pagination__ellipsis {\n  min-width: 32px;\n  letter-spacing: 2px;\n  cursor: default;\n}\n.novel-pagination__ellipsis:hover {\n  background: transparent;\n  color: var(--color-text-secondary);\n}\n\n.novel-pagination__nav {\n  padding: 0 var(--space-2);\n}\n\n.novel-pagination__jumper {\n  display: inline-flex;\n  align-items: center;\n  gap: var(--space-2);\n  color: var(--color-text-tertiary);\n}\n.novel-pagination__jumper-input {\n  width: 48px;\n  height: 32px;\n  padding: 0 var(--space-2);\n  text-align: center;\n  border: 1px solid var(--color-border-default);\n  border-radius: var(--radius-md);\n  background: var(--color-bg-surface);\n  color: var(--color-text-primary);\n  font-family: inherit;\n  font-size: inherit;\n  transition: border-color var(--dur-fast) var(--ease-standard);\n}\n.novel-pagination__jumper-input:focus {\n  outline: none;\n  border-color: var(--color-border-focus);\n}\n/* 隐藏 number 输入框的箭头 */\n.novel-pagination__jumper-input::-webkit-outer-spin-button,\n.novel-pagination__jumper-input::-webkit-inner-spin-button {\n  -webkit-appearance: none;\n  margin: 0;\n}\n.novel-pagination__jumper-input {\n  -moz-appearance: textfield;\n}\n\n/* ============================================================\n * Select · 02 §1.3\n * 单选 / 多选 / 搜索；远程 loading\n * ============================================================ */\n\n.novel-select {\n  display: inline-flex;\n  position: relative;\n  font-family: var(--font-sans);\n}\n\n/* ---------- 尺寸 ---------- */\n.novel-select--sm .novel-select__selector {\n  height: 24px;\n  font-size: var(--font-size-overline);\n}\n.novel-select--md .novel-select__selector {\n  height: 32px;\n  font-size: var(--font-size-caption);\n}\n.novel-select--lg .novel-select__selector {\n  height: 40px;\n  font-size: var(--font-size-body);\n}\n\n/* ---------- 选择器表面 ---------- */\n.novel-select__selector {\n  display: inline-flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: var(--space-2);\n  min-width: 160px;\n  padding: 0 var(--space-3);\n  border: 1px solid var(--color-border-default);\n  border-radius: var(--radius-md);\n  background: var(--color-bg-surface);\n  color: var(--color-text-primary);\n  cursor: pointer;\n  font-family: inherit;\n  font-size: inherit;\n  text-align: left;\n  transition: border-color var(--dur-fast) var(--ease-standard),\n    box-shadow var(--dur-fast) var(--ease-standard);\n}\n.novel-select__selector:hover:not(:disabled) {\n  border-color: var(--color-brand);\n}\n.novel-select__selector:focus-visible {\n  outline: none;\n  border-color: var(--color-border-focus);\n  box-shadow: 0 0 0 2px var(--color-brand-bg);\n}\n.novel-select.is-open .novel-select__selector {\n  border-color: var(--color-border-focus);\n  box-shadow: 0 0 0 2px var(--color-brand-bg);\n}\n.novel-select.is-disabled .novel-select__selector {\n  opacity: 0.5;\n  cursor: not-allowed;\n  background: var(--color-bg-subtle);\n}\n\n.novel-select__surface {\n  flex: 1;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n.novel-select__placeholder {\n  color: var(--color-text-tertiary);\n}\n.novel-select__value {\n  color: var(--color-text-primary);\n}\n.novel-select__suffix {\n  display: inline-flex;\n  align-items: center;\n  color: var(--color-text-tertiary);\n  flex-shrink: 0;\n}\n\n/* ---------- 多选 Tag ---------- */\n.novel-select__tags {\n  display: inline-flex;\n  flex-wrap: wrap;\n  gap: var(--space-1);\n  padding: var(--space-1) 0;\n}\n.novel-select--sm .novel-select__tags,\n.novel-select--md .novel-select__tags {\n  /* 让多选 selector 自适应高度 */\n  align-items: center;\n}\n.novel-select__tag {\n  display: inline-flex;\n  align-items: center;\n  gap: var(--space-1);\n  padding: 0 var(--space-2);\n  height: 22px;\n  border-radius: var(--radius-sm);\n  background: var(--color-bg-subtle);\n  color: var(--color-text-primary);\n  font-size: var(--font-size-overline);\n  line-height: 1;\n}\n.novel-select__tag-close {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  width: 14px;\n  height: 14px;\n  border: none;\n  background: transparent;\n  color: var(--color-text-tertiary);\n  cursor: pointer;\n  border-radius: var(--radius-xs);\n  padding: 0;\n}\n.novel-select__tag-close:hover {\n  color: var(--color-text-primary);\n  background: var(--color-bg-elevated);\n}\n\n/* ---------- Spin ---------- */\n.novel-select__spin {\n  display: inline-block;\n  width: 14px;\n  height: 14px;\n  border: 1.5px solid var(--color-text-tertiary);\n  border-right-color: transparent;\n  border-radius: 50%;\n  animation: novel-select-spin 0.6s linear infinite;\n}\n@keyframes novel-select-spin {\n  to { transform: rotate(360deg); }\n}\n\n/* ---------- 下拉面板 ---------- */\n.novel-select__dropdown {\n  min-width: 160px;\n  max-height: 320px;\n  background: var(--color-bg-surface);\n  border-radius: var(--radius-md);\n  box-shadow: var(--sh-3);\n  overflow: hidden;\n  display: flex;\n  flex-direction: column;\n  z-index: var(--z-index-dropdown);\n  opacity: 0;\n  transform: translateY(-4px);\n  transition: opacity var(--dur-fast) var(--ease-standard),\n    transform var(--dur-fast) var(--ease-standard);\n}\n.novel-select__dropdown.is-ready {\n  opacity: 1;\n  transform: translateY(0);\n}\n\n.novel-select__search {\n  padding: var(--space-2);\n  border-bottom: 1px solid var(--color-border-subtle);\n}\n.novel-select__search-input {\n  width: 100%;\n  height: 28px;\n  padding: 0 var(--space-2);\n  border: 1px solid var(--color-border-default);\n  border-radius: var(--radius-sm);\n  background: var(--color-bg-surface);\n  color: var(--color-text-primary);\n  font-family: inherit;\n  font-size: var(--font-size-caption);\n  transition: border-color var(--dur-fast) var(--ease-standard);\n}\n.novel-select__search-input:focus {\n  outline: none;\n  border-color: var(--color-border-focus);\n}\n\n.novel-select__options {\n  overflow-y: auto;\n  max-height: 256px;\n  padding: var(--space-1);\n}\n\n.novel-select__option {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: var(--space-2);\n  width: 100%;\n  padding: var(--space-2) var(--space-3);\n  border: none;\n  background: transparent;\n  color: var(--color-text-primary);\n  font-family: inherit;\n  font-size: var(--font-size-caption);\n  cursor: pointer;\n  border-radius: var(--radius-sm);\n  text-align: left;\n  transition: background var(--dur-fast) var(--ease-standard);\n}\n.novel-select__option:hover:not(.is-disabled) {\n  background: var(--color-bg-subtle);\n}\n.novel-select__option.is-selected {\n  color: var(--color-brand);\n  font-weight: var(--font-weight-medium);\n}\n.novel-select__option.is-disabled {\n  color: var(--color-text-disabled);\n  cursor: not-allowed;\n}\n.novel-select__option-check {\n  display: inline-flex;\n  color: var(--color-brand);\n}\n\n.novel-select__loading,\n.novel-select__empty {\n  padding: var(--space-4) var(--space-3);\n  text-align: center;\n  color: var(--color-text-tertiary);\n  font-size: var(--font-size-caption);\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .novel-select__dropdown,\n  .novel-select__spin {\n    transition: none;\n    animation-duration: 0s;\n  }\n}\n\n/* ============================================================\n * BookMeta · 02 §1.16\n * detailed / compact 变体；书名 serif，统计数字 mono\n * ============================================================ */\n\n.book-meta {\n  display: flex;\n  flex-direction: column;\n  gap: var(--space-2);\n  font-family: var(--font-sans);\n  min-width: 0;\n}\n\n.book-meta--compact {\n  gap: var(--space-1);\n}\n\n/* ---------- 书名行 ---------- */\n.book-meta__title-row {\n  display: flex;\n  align-items: center;\n  gap: var(--space-2);\n  min-width: 0;\n}\n\n.book-meta__title {\n  font-family: var(--font-serif);\n  font-size: var(--font-size-h3);\n  line-height: 28px;\n  color: var(--color-text-primary);\n  font-weight: var(--font-weight-semibold);\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n  min-width: 0;\n}\n.book-meta__title[role='button'] {\n  cursor: pointer;\n  transition: color var(--dur-fast) var(--ease-standard);\n}\n.book-meta__title[role='button']:hover {\n  color: var(--color-brand);\n}\n.book-meta__title[role='button']:focus-visible {\n  outline: none;\n  border-radius: var(--radius-sm);\n  box-shadow: 0 0 0 2px var(--color-brand-bg);\n}\n\n.book-meta--compact .book-meta__title {\n  font-size: var(--font-size-caption);\n  line-height: 22px;\n}\n\n/* ---------- 作者行 ---------- */\n.book-meta__author {\n  font-family: var(--font-sans);\n  font-size: var(--font-size-caption);\n  line-height: 20px;\n  color: var(--color-text-secondary);\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n/* ---------- 统计行 ---------- */\n.book-meta__stats {\n  display: flex;\n  align-items: center;\n  gap: var(--space-2);\n  font-family: var(--font-mono);\n  font-size: var(--font-size-caption);\n  line-height: 20px;\n  color: var(--color-text-tertiary);\n  flex-wrap: wrap;\n}\n.book-meta--compact .book-meta__stats {\n  font-size: var(--font-size-overline);\n  line-height: 18px;\n}\n.book-meta__stat {\n  display: inline-flex;\n  align-items: center;\n  gap: var(--space-2);\n}\n.book-meta__stats-separator {\n  color: var(--color-text-tertiary);\n  font-family: var(--font-sans);\n}\n\n/* ---------- 标签行 ---------- */\n.book-meta__tags {\n  display: flex;\n  flex-wrap: wrap;\n  gap: var(--space-1);\n}\n\n/* ============================================================\n * ContentStatus · 02 §1.17\n * 5 种状态枚举 × 2 种尺寸；颜色映射强约束\n * ============================================================ */\n\n.novel-content-status {\n  display: inline-flex;\n  align-items: center;\n  gap: var(--space-1);\n  border-radius: var(--radius-full);\n  font-family: var(--font-sans);\n  font-weight: var(--font-weight-medium);\n  line-height: 1;\n  white-space: nowrap;\n}\n\n/* ---------- 尺寸 ---------- */\n.novel-content-status--sm {\n  padding: var(--space-1) var(--space-2);\n  font-size: var(--font-size-overline);\n  height: 22px;\n}\n.novel-content-status--md {\n  padding: var(--space-1) var(--space-2);\n  font-size: var(--font-size-caption);\n  height: 24px;\n}\n\n/* ---------- 圆点 ---------- */\n.novel-content-status__dot {\n  width: 6px;\n  height: 6px;\n  border-radius: 50%;\n  background: currentColor;\n  flex-shrink: 0;\n}\n\n/* ---------- 状态色映射（强约束，禁止业务覆盖） ---------- */\n.novel-content-status--ongoing {\n  color: var(--color-feedback-success);\n  background: var(--color-feedback-success-bg);\n}\n.novel-content-status--completed {\n  color: var(--color-brand);\n  background: var(--color-brand-bg);\n}\n.novel-content-status--paused {\n  color: var(--color-feedback-warning);\n  background: var(--color-feedback-warning-bg);\n}\n.novel-content-status--reviewing {\n  color: var(--color-text-tertiary);\n  background: var(--color-bg-subtle);\n}\n.novel-content-status--offline {\n  color: var(--color-feedback-error);\n  background: var(--color-feedback-error-bg);\n  /* 下架状态额外描边强调严重性 */\n  border: 1px solid var(--color-border-default);\n}\n\n/* ============================================================\n * RatingStars · 03 §6.4\n * 半星图层裁剪；sm 12 / md 16 / lg 24；分布柱状图\n * ============================================================ */\n\n.novel-rating__wrap {\n  display: inline-flex;\n  align-items: center;\n  gap: var(--space-2);\n  font-family: var(--font-sans);\n  vertical-align: middle;\n}\n\n/* ---------- 星星轨道（双层裁剪核心） ---------- */\n.novel-rating {\n  position: relative;\n  display: inline-flex;\n  line-height: 1;\n  /* 默认 currentColor 指向空星灰 */\n  color: var(--color-text-tertiary);\n}\n\n.novel-rating__layer {\n  display: inline-flex;\n  align-items: center;\n  gap: 2px;\n  white-space: nowrap;\n}\n\n.novel-rating__layer--empty {\n  color: var(--color-text-disabled);\n}\n\n.novel-rating__layer--filled {\n  position: absolute;\n  inset: 0;\n  overflow: hidden;\n  color: var(--color-brand);\n}\n\n.novel-rating__star {\n  display: inline-flex;\n  flex-shrink: 0;\n}\n\n/* ---------- 尺寸（sm 12 / md 16 / lg 24，03 §6.4 规格） ---------- */\n.novel-rating--sm {\n  font-size: var(--font-size-xs);\n}\n.novel-rating--md {\n  font-size: var(--font-size-body);\n}\n.novel-rating--lg {\n  font-size: 24px;\n}\n\n/* ---------- 交互态 ---------- */\n.novel-rating.is-interactive {\n  cursor: pointer;\n}\n.novel-rating.is-interactive:focus-visible {\n  outline: none;\n  border-radius: var(--radius-sm);\n  box-shadow: 0 0 0 2px var(--color-brand-bg);\n}\n\n.novel-rating.is-disabled {\n  cursor: not-allowed;\n  opacity: 0.6;\n}\n.novel-rating.is-disabled .novel-rating__layer--filled {\n  color: var(--color-text-disabled);\n}\n\n/* ---------- 数字表达（无障碍双重表达） ---------- */\n.novel-rating__value {\n  font-family: var(--font-mono);\n  font-size: var(--font-size-caption);\n  line-height: 1;\n  color: var(--color-text-primary);\n  font-weight: var(--font-weight-medium);\n}\n.novel-rating--sm + .novel-rating__value,\n.novel-rating__wrap:has(.novel-rating--sm) .novel-rating__value {\n  font-size: var(--font-size-overline);\n}\n\n/* ---------- 评分分布柱状图 ---------- */\n.novel-rating__dist {\n  display: flex;\n  flex-direction: column;\n  gap: var(--space-1);\n  width: 100%;\n  min-width: 180px;\n  margin-top: var(--space-2);\n}\n\n.novel-rating__dist-row {\n  display: flex;\n  align-items: center;\n  gap: var(--space-2);\n}\n\n.novel-rating__dist-label {\n  flex-shrink: 0;\n  width: 36px;\n  font-family: var(--font-sans);\n  font-size: var(--font-size-overline);\n  color: var(--color-text-tertiary);\n}\n\n.novel-rating__dist-track {\n  flex: 1;\n  height: 6px;\n  border-radius: var(--radius-full);\n  background: var(--color-bg-subtle);\n  overflow: hidden;\n}\n\n.novel-rating__dist-bar {\n  display: block;\n  height: 100%;\n  border-radius: var(--radius-full);\n  /* brand-bg → brand-7 渐变（03 §6.4 规格） */\n  background: linear-gradient(90deg, var(--color-brand-bg) 0%, var(--color-brand) 100%);\n  transition: width var(--dur-normal) var(--ease-standard);\n}\n\n.novel-rating__dist-count {\n  flex-shrink: 0;\n  min-width: 32px;\n  text-align: right;\n  font-family: var(--font-mono);\n  font-size: var(--font-size-overline);\n  color: var(--color-text-secondary);\n}\n\n/* ============================================================\n * BookCard · 03 §6.1\n * grid / list / horizontal 三变体；封面 3:4；hover scale(1.02)+sh-2\n * ============================================================ */\n\n.novel-book-card {\n  display: flex;\n  background: var(--color-bg-surface);\n  border: 1px solid var(--color-border-subtle);\n  border-radius: var(--radius-lg);\n  overflow: hidden;\n  font-family: var(--font-sans);\n  transition: box-shadow var(--dur-fast) var(--ease-standard),\n    border-color var(--dur-fast) var(--ease-standard);\n}\n\n.novel-book-card.is-clickable {\n  cursor: pointer;\n}\n.novel-book-card.is-clickable:hover {\n  box-shadow: var(--sh-2);\n  border-color: var(--color-border-default);\n}\n.novel-book-card.is-clickable:focus-visible {\n  outline: none;\n  border-color: var(--color-brand);\n  box-shadow: 0 0 0 2px var(--color-brand-bg);\n}\n\n/* ---------- 封面（3:4 固定比例） ---------- */\n.novel-book-card__cover {\n  position: relative;\n  flex-shrink: 0;\n  aspect-ratio: 3 / 4;\n  background: var(--color-bg-subtle);\n  border-radius: var(--radius-md);\n  overflow: hidden;\n}\n.novel-book-card__cover img {\n  width: 100%;\n  height: 100%;\n  -o-object-fit: cover;\n     object-fit: cover;\n  display: block;\n  transition: transform var(--dur-fast) var(--ease-standard);\n}\n.novel-book-card.is-clickable:hover .novel-book-card__cover img {\n  transform: scale(1.02);\n}\n.novel-book-card.is-clickable:active .novel-book-card__cover img {\n  transform: scale(0.98);\n}\n\n/* 封面兜底（无图或加载失败） */\n.novel-book-card__cover-fallback {\n  width: 100%;\n  height: 100%;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  background: var(--color-brand-bg);\n  color: var(--color-brand);\n  font-family: var(--font-serif);\n  font-size: var(--font-size-h2);\n  font-weight: var(--font-weight-semibold);\n}\n\n/* 「已加入」角标 */\n.novel-book-card__added {\n  position: absolute;\n  top: var(--space-1);\n  left: var(--space-1);\n  padding: 2px var(--space-1);\n  border-radius: var(--radius-sm);\n  background: var(--color-brand-bg);\n  color: var(--color-brand);\n  font-size: var(--font-size-overline);\n  font-weight: var(--font-weight-medium);\n  line-height: 14px;\n}\n\n/* 追更红点 */\n.novel-book-card__update-dot {\n  position: absolute;\n  top: var(--space-1);\n  right: var(--space-1);\n  width: 8px;\n  height: 8px;\n  border-radius: 50%;\n  background: var(--color-rose);\n  box-shadow: 0 0 0 1.5px var(--color-bg-surface);\n}\n\n/* ---------- 信息区 ---------- */\n.novel-book-card__info {\n  flex: 1;\n  min-width: 0;\n  display: flex;\n  flex-direction: column;\n  gap: var(--space-1);\n}\n\n.novel-book-card__title {\n  font-family: var(--font-serif);\n  font-weight: var(--font-weight-semibold);\n  color: var(--color-text-primary);\n  overflow: hidden;\n  text-overflow: ellipsis;\n  display: -webkit-box;\n  -webkit-box-orient: vertical;\n  -webkit-line-clamp: 2;\n  line-clamp: 2;\n}\n\n.novel-book-card__author {\n  font-family: var(--font-sans);\n  color: var(--color-text-secondary);\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.novel-book-card__intro {\n  font-family: var(--font-sans);\n  color: var(--color-text-tertiary);\n  overflow: hidden;\n  display: -webkit-box;\n  -webkit-box-orient: vertical;\n  -webkit-line-clamp: 2;\n  line-clamp: 2;\n}\n\n.novel-book-card__tags {\n  display: flex;\n  flex-wrap: wrap;\n  gap: var(--space-1);\n  margin-top: var(--space-1);\n}\n\n/* ---------- grid 变体：封面在上 ---------- */\n.novel-book-card--grid {\n  flex-direction: column;\n  padding: var(--space-3);\n  gap: var(--space-3);\n}\n.novel-book-card--grid .novel-book-card__cover {\n  width: 100%;\n}\n.novel-book-card--grid .novel-book-card__title {\n  font-size: var(--font-size-body);\n  line-height: 22px;\n}\n.novel-book-card--grid .novel-book-card__author {\n  font-size: var(--font-size-caption);\n  line-height: 20px;\n}\n.novel-book-card--grid .novel-book-card__intro {\n  font-size: var(--font-size-caption);\n  line-height: 20px;\n}\n\n/* ---------- list 变体：封面在左，信息详尽 ---------- */\n.novel-book-card--list {\n  flex-direction: row;\n  padding: var(--space-3);\n  gap: var(--space-3);\n  align-items: flex-start;\n}\n.novel-book-card--list .novel-book-card__title {\n  font-size: var(--font-size-h3);\n  line-height: 26px;\n  -webkit-line-clamp: 1;\n  line-clamp: 1;\n}\n.novel-book-card--list .novel-book-card__author {\n  font-size: var(--font-size-caption);\n  line-height: 20px;\n}\n.novel-book-card--list .novel-book-card__intro {\n  font-size: var(--font-size-caption);\n  line-height: 22px;\n  margin-top: var(--space-1);\n}\n\n/* ---------- horizontal 变体：紧凑横滚 ---------- */\n.novel-book-card--horizontal {\n  flex-direction: row;\n  padding: var(--space-2);\n  gap: var(--space-2);\n  align-items: flex-start;\n  background: transparent;\n  border: none;\n  border-radius: var(--radius-md);\n}\n.novel-book-card--horizontal.is-clickable:hover {\n  box-shadow: none;\n  background: var(--color-bg-subtle);\n}\n.novel-book-card--horizontal .novel-book-card__title {\n  font-size: var(--font-size-caption);\n  line-height: 20px;\n  -webkit-line-clamp: 2;\n  line-clamp: 2;\n}\n\n/* ---------- size 调整（影响 list/horizontal 封面宽度，grid 自适应） ---------- */\n.novel-book-card--sm .novel-book-card__info {\n  gap: 2px;\n}\n\n/* ---------- 骨架屏 ---------- */\n.novel-book-card.is-skeleton {\n  pointer-events: none;\n}\n.novel-book-card__cover--skeleton {\n  background: var(--color-bg-subtle);\n}\n.novel-book-card.is-skeleton .novel-book-card__cover--skeleton,\n.novel-book-card__skeleton-line {\n  background: linear-gradient(\n    90deg,\n    var(--color-bg-subtle) 0%,\n    var(--color-bg-elevated) 50%,\n    var(--color-bg-subtle) 100%\n  );\n  background-size: 200% 100%;\n  animation: novel-skeleton-shimmer var(--dur-slow) var(--ease-standard) infinite;\n}\n.novel-book-card__skeleton-line {\n  height: 14px;\n  border-radius: var(--radius-sm);\n}\n.novel-book-card__skeleton-line--title {\n  width: 80%;\n  height: 18px;\n}\n.novel-book-card__skeleton-line--author {\n  width: 50%;\n}\n.novel-book-card__skeleton-line--short {\n  width: 30%;\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .novel-book-card.is-skeleton .novel-book-card__cover--skeleton,\n  .novel-book-card__skeleton-line {\n    animation: none;\n  }\n}\n\n/* ============================================================\n * NotificationBadge · 03 §6.12\n * 左侧 rose 红点 / 已读弱化 / hover 忽略 / 多条聚合\n * ============================================================ */\n\n.novel-notify {\n  position: relative;\n  display: flex;\n  align-items: center;\n  gap: var(--space-3);\n  padding: var(--space-3) var(--space-4);\n  background: var(--color-bg-surface);\n  border: 1px solid var(--color-border-subtle);\n  border-radius: var(--radius-lg);\n  font-family: var(--font-sans);\n  transition: background var(--dur-fast) var(--ease-standard);\n}\n\n.novel-notify.is-clickable {\n  cursor: pointer;\n}\n.novel-notify.is-clickable:hover {\n  background: var(--color-bg-subtle);\n}\n.novel-notify.is-clickable:focus-visible {\n  outline: none;\n  border-color: var(--color-brand);\n  box-shadow: 0 0 0 2px var(--color-brand-bg);\n}\n\n/* 已读弱化 */\n.novel-notify.is-read {\n  background: var(--color-bg-subtle);\n}\n.novel-notify.is-read .novel-notify__title {\n  color: var(--color-text-secondary);\n  font-weight: var(--font-weight-regular);\n}\n.novel-notify.is-read .novel-notify__dot {\n  background: var(--color-text-tertiary);\n}\n\n/* ---------- 左侧红点（8px，未读 rose） ---------- */\n.novel-notify__dot {\n  flex-shrink: 0;\n  width: 8px;\n  height: 8px;\n  border-radius: 50%;\n  background: var(--color-rose);\n}\n\n/* ---------- 主体 ---------- */\n.novel-notify__body {\n  flex: 1;\n  min-width: 0;\n  display: flex;\n  flex-direction: column;\n  gap: 2px;\n}\n\n.novel-notify__title-row {\n  display: flex;\n  align-items: baseline;\n  gap: var(--space-2);\n  min-width: 0;\n}\n\n.novel-notify__title {\n  font-family: var(--font-serif);\n  font-size: var(--font-size-caption);\n  font-weight: var(--font-weight-semibold);\n  color: var(--color-text-primary);\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n/* 「更新 N 章」暖橙 */\n.novel-notify__count {\n  flex-shrink: 0;\n  font-family: var(--font-sans);\n  font-size: var(--font-size-overline);\n  font-weight: var(--font-weight-medium);\n  color: var(--color-accent-orange);\n}\n\n.novel-notify__time {\n  font-family: var(--font-mono);\n  font-size: var(--font-size-overline);\n  color: var(--color-text-tertiary);\n}\n\n/* ---------- 忽略按钮（hover 显现） ---------- */\n.novel-notify__dismiss {\n  flex-shrink: 0;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  width: 24px;\n  height: 24px;\n  padding: 0;\n  border: none;\n  border-radius: var(--radius-sm);\n  background: transparent;\n  color: var(--color-text-tertiary);\n  cursor: pointer;\n  opacity: 0;\n  transition: opacity var(--dur-fast) var(--ease-standard),\n    background var(--dur-fast) var(--ease-standard);\n}\n.novel-notify:hover .novel-notify__dismiss {\n  opacity: 1;\n}\n.novel-notify__dismiss:hover {\n  background: var(--color-bg-elevated);\n  color: var(--color-text-secondary);\n}\n.novel-notify__dismiss:focus-visible {\n  outline: none;\n  opacity: 1;\n  box-shadow: 0 0 0 2px var(--color-brand-bg);\n}\n\n/* ---------- 聚合卡片 ---------- */\n.novel-notify--aggregate {\n  gap: var(--space-2);\n}\n.novel-notify__aggregate-text {\n  flex: 1;\n  font-family: var(--font-sans);\n  font-size: var(--font-size-caption);\n  font-weight: var(--font-weight-medium);\n  color: var(--color-text-primary);\n}\n.novel-notify__chevron {\n  flex-shrink: 0;\n  color: var(--color-text-tertiary);\n  font-size: var(--font-size-body);\n  line-height: 1;\n}\n\n/* ============================================================\n * ChapterList · 03 §6.2\n * 列表项 48px；当前章 brand 高亮 + 左竖条；VIP 暖橙；虚拟滚动\n * ============================================================ */\n\n.novel-chapter-list {\n  font-family: var(--font-sans);\n  background: var(--color-bg-surface);\n  border-radius: var(--radius-md);\n}\n\n/* ---------- 工具栏（排序切换） ---------- */\n.novel-chapter-list__toolbar {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  padding: var(--space-2) var(--space-3);\n  border-bottom: 1px solid var(--color-border-subtle);\n}\n\n.novel-chapter-list__order-btn {\n  display: inline-flex;\n  align-items: center;\n  gap: var(--space-1);\n  padding: var(--space-1) var(--space-2);\n  border: 1px solid var(--color-border-subtle);\n  border-radius: var(--radius-sm);\n  background: var(--color-bg-surface);\n  color: var(--color-text-secondary);\n  font-family: var(--font-sans);\n  font-size: var(--font-size-overline);\n  cursor: pointer;\n  transition: color var(--dur-fast) var(--ease-standard),\n    border-color var(--dur-fast) var(--ease-standard);\n}\n.novel-chapter-list__order-btn:hover {\n  color: var(--color-brand);\n  border-color: var(--color-brand-border);\n}\n.novel-chapter-list__order-btn:focus-visible {\n  outline: none;\n  box-shadow: 0 0 0 2px var(--color-brand-bg);\n}\n\n.novel-chapter-list__count {\n  font-family: var(--font-mono);\n  font-size: var(--font-size-overline);\n  color: var(--color-text-tertiary);\n}\n\n/* ---------- 视口 ---------- */\n.novel-chapter-list__viewport {\n  outline: none;\n}\n.novel-chapter-list__viewport::-webkit-scrollbar {\n  width: 6px;\n}\n.novel-chapter-list__viewport::-webkit-scrollbar-thumb {\n  background: var(--color-border-default);\n  border-radius: var(--radius-full);\n}\n\n/* ---------- 列表项（固定 48px） ---------- */\n.novel-chapter-list__item {\n  display: flex;\n  align-items: center;\n  gap: var(--space-3);\n  width: 100%;\n  padding: 0 var(--space-4);\n  border: none;\n  border-left: 3px solid transparent;\n  background: var(--color-bg-surface);\n  color: var(--color-text-primary);\n  font-family: var(--font-sans);\n  font-size: var(--font-size-body);\n  text-align: left;\n  cursor: pointer;\n  transition: background var(--dur-fast) var(--ease-standard),\n    color var(--dur-fast) var(--ease-standard);\n  box-sizing: border-box;\n}\n.novel-chapter-list__item:hover {\n  background: var(--color-bg-subtle);\n}\n.novel-chapter-list__item:focus-visible {\n  outline: none;\n  box-shadow: inset 0 0 0 2px var(--color-brand-bg);\n}\n\n/* 当前阅读章：brand 文字 + 左侧 3px brand 竖条 */\n.novel-chapter-list__item.is-active {\n  color: var(--color-brand);\n  border-left-color: var(--color-brand);\n  background: var(--color-brand-bg);\n  font-weight: var(--font-weight-medium);\n}\n\n/* 已读弱化 */\n.novel-chapter-list__item.is-read {\n  color: var(--color-text-tertiary);\n}\n.novel-chapter-list__item.is-read.is-active {\n  color: var(--color-brand);\n}\n\n/* ---------- 章节序号 ---------- */\n.novel-chapter-list__index {\n  flex-shrink: 0;\n  width: 40px;\n  font-family: var(--font-mono);\n  font-size: var(--font-size-overline);\n  color: var(--color-text-tertiary);\n  text-align: right;\n}\n.novel-chapter-list__item.is-active .novel-chapter-list__index {\n  color: var(--color-brand);\n}\n\n/* ---------- 章节标题 ---------- */\n.novel-chapter-list__title {\n  flex: 1;\n  min-width: 0;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n  line-height: 20px;\n}\n\n/* ---------- VIP 标记（暖橙） ---------- */\n.novel-chapter-list__vip {\n  flex-shrink: 0;\n  display: inline-flex;\n  align-items: center;\n  gap: 2px;\n  padding: 2px var(--space-1);\n  border-radius: var(--radius-sm);\n  background: var(--color-accent-orange-bg);\n  color: var(--color-accent-orange);\n  font-size: var(--font-size-overline);\n  font-weight: var(--font-weight-medium);\n  line-height: 14px;\n}\n\n/* ---------- 字数元信息 ---------- */\n.novel-chapter-list__meta {\n  flex-shrink: 0;\n  font-family: var(--font-mono);\n  font-size: var(--font-size-overline);\n  color: var(--color-text-tertiary);\n  text-align: right;\n}\n\n/* ---------- 加载更多 ---------- */\n.novel-chapter-list__load-more {\n  display: flex;\n  justify-content: center;\n  padding: var(--space-3);\n}\n\n.novel-chapter-list__load-more-btn {\n  display: inline-flex;\n  align-items: center;\n  gap: var(--space-1);\n  padding: var(--space-2) var(--space-4);\n  border: 1px solid var(--color-border-subtle);\n  border-radius: var(--radius-full);\n  background: var(--color-bg-surface);\n  color: var(--color-text-secondary);\n  font-family: var(--font-sans);\n  font-size: var(--font-size-caption);\n  cursor: pointer;\n  transition: color var(--dur-fast) var(--ease-standard),\n    border-color var(--dur-fast) var(--ease-standard);\n}\n.novel-chapter-list__load-more-btn:hover:not(:disabled) {\n  color: var(--color-brand);\n  border-color: var(--color-brand-border);\n}\n.novel-chapter-list__load-more-btn:disabled {\n  cursor: not-allowed;\n  opacity: 0.6;\n}\n.novel-chapter-list__load-more-btn:focus-visible {\n  outline: none;\n  box-shadow: 0 0 0 2px var(--color-brand-bg);\n}\n\n/* ---------- 加载 spinner ---------- */\n.novel-chapter-list__spinner {\n  animation: novel-chapter-list-spin var(--dur-normal) linear infinite;\n}\n\n@keyframes novel-chapter-list-spin {\n  from { transform: rotate(0deg); }\n  to { transform: rotate(360deg); }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .novel-chapter-list__spinner {\n    animation: none;\n  }\n}\n\n/* ============================================================\n * Bookshelf · 03 §6.5\n * grid：xs2 / sm3 / md4 / lg5 / xl6 列；list：单列含进度\n * 分组标题 14px text-secondary uppercase；控件 icon-only 置右\n * ============================================================ */\n\n.novel-bookshelf {\n  font-family: var(--font-sans);\n  background: var(--color-bg-surface);\n  border-radius: var(--radius-lg);\n}\n\n/* ---------- 工具栏 ---------- */\n.novel-bookshelf__toolbar {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: var(--space-3);\n  padding: var(--space-3) var(--space-4);\n  border-bottom: 1px solid var(--color-border-subtle);\n  flex-wrap: wrap;\n}\n\n/* Tab 列表 */\n.novel-bookshelf__tabs {\n  display: inline-flex;\n  gap: var(--space-1);\n  flex-wrap: wrap;\n}\n.novel-bookshelf__tab {\n  padding: var(--space-1) var(--space-3);\n  border: 1px solid transparent;\n  border-radius: var(--radius-full);\n  background: transparent;\n  color: var(--color-text-secondary);\n  font-family: var(--font-sans);\n  font-size: var(--font-size-caption);\n  line-height: 20px;\n  cursor: pointer;\n  transition: color var(--dur-fast) var(--ease-standard),\n    background var(--dur-fast) var(--ease-standard),\n    border-color var(--dur-fast) var(--ease-standard);\n}\n.novel-bookshelf__tab:hover {\n  color: var(--color-brand);\n  background: var(--color-brand-bg);\n}\n.novel-bookshelf__tab.is-active {\n  color: var(--color-brand);\n  border-color: var(--color-brand-border);\n  background: var(--color-brand-bg);\n  font-weight: var(--font-weight-medium);\n}\n.novel-bookshelf__tab:focus-visible {\n  outline: none;\n  box-shadow: 0 0 0 2px var(--color-brand-bg);\n}\n\n/* 右侧控件组 */\n.novel-bookshelf__controls {\n  display: inline-flex;\n  align-items: center;\n  gap: var(--space-2);\n}\n\n.novel-bookshelf__control {\n  position: relative;\n  display: inline-flex;\n  align-items: center;\n  gap: var(--space-1);\n  padding: 0 var(--space-2);\n  height: 28px;\n  border: 1px solid var(--color-border-subtle);\n  border-radius: var(--radius-sm);\n  background: var(--color-bg-surface);\n  color: var(--color-text-secondary);\n  cursor: pointer;\n  transition: color var(--dur-fast) var(--ease-standard),\n    border-color var(--dur-fast) var(--ease-standard);\n}\n.novel-bookshelf__control:hover {\n  color: var(--color-brand);\n  border-color: var(--color-brand-border);\n}\n.novel-bookshelf__control:focus-within {\n  border-color: var(--color-brand-border);\n  box-shadow: 0 0 0 2px var(--color-brand-bg);\n}\n.novel-bookshelf__control-icon {\n  display: inline-flex;\n  align-items: center;\n  color: var(--color-text-tertiary);\n  pointer-events: none;\n}\n.novel-bookshelf__select {\n  -webkit-appearance: none;\n     -moz-appearance: none;\n          appearance: none;\n  border: none;\n  background: transparent;\n  padding-right: var(--space-2);\n  font-family: var(--font-sans);\n  font-size: var(--font-size-overline);\n  color: var(--color-text-secondary);\n  cursor: pointer;\n}\n.novel-bookshelf__select:focus {\n  outline: none;\n}\n\n/* 视图切换：icon-only 按钮组 */\n.novel-bookshelf__view-toggle {\n  display: inline-flex;\n  border: 1px solid var(--color-border-subtle);\n  border-radius: var(--radius-sm);\n  overflow: hidden;\n}\n.novel-bookshelf__view-btn {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  width: 28px;\n  height: 28px;\n  border: none;\n  background: var(--color-bg-surface);\n  color: var(--color-text-tertiary);\n  cursor: pointer;\n  transition: color var(--dur-fast) var(--ease-standard),\n    background var(--dur-fast) var(--ease-standard);\n}\n.novel-bookshelf__view-btn:hover {\n  color: var(--color-brand);\n  background: var(--color-brand-bg);\n}\n.novel-bookshelf__view-btn.is-active {\n  color: var(--color-brand);\n  background: var(--color-brand-bg);\n}\n.novel-bookshelf__view-btn:focus-visible {\n  outline: none;\n  box-shadow: inset 0 0 0 2px var(--color-brand-border);\n}\n\n/* ---------- 追更通知区 ---------- */\n.novel-bookshelf__notify {\n  padding: var(--space-2) var(--space-4);\n  border-bottom: 1px solid var(--color-border-subtle);\n}\n\n/* ---------- 主体 ---------- */\n.novel-bookshelf__body {\n  padding: var(--space-3) var(--space-4) var(--space-4);\n  display: flex;\n  flex-direction: column;\n  gap: var(--space-4);\n}\n\n/* ---------- 分组 ---------- */\n.novel-bookshelf__group {\n  display: flex;\n  flex-direction: column;\n  gap: var(--space-2);\n}\n\n.novel-bookshelf__group-header {\n  display: inline-flex;\n  align-items: center;\n  gap: var(--space-2);\n  align-self: flex-start;\n  padding: var(--space-1) var(--space-2);\n  border: none;\n  background: transparent;\n  color: var(--color-text-secondary);\n  font-family: var(--font-sans);\n  font-size: var(--font-size-caption);\n  text-transform: uppercase;\n  letter-spacing: 0.04em;\n  cursor: pointer;\n  border-radius: var(--radius-sm);\n  transition: color var(--dur-fast) var(--ease-standard),\n    background var(--dur-fast) var(--ease-standard);\n}\n.novel-bookshelf__group-header:hover {\n  color: var(--color-text-primary);\n  background: var(--color-bg-subtle);\n}\n.novel-bookshelf__group-header:focus-visible {\n  outline: none;\n  box-shadow: 0 0 0 2px var(--color-brand-bg);\n}\n.novel-bookshelf__group-title {\n  font-weight: var(--font-weight-medium);\n}\n.novel-bookshelf__group-count {\n  font-family: var(--font-mono);\n  font-size: var(--font-size-overline);\n  color: var(--color-text-tertiary);\n  padding: 0 var(--space-1);\n  background: var(--color-bg-subtle);\n  border-radius: var(--radius-full);\n  min-width: 18px;\n  text-align: center;\n  text-transform: none;\n  letter-spacing: 0;\n}\n\n/* ---------- grid 视图：响应式列数 ---------- */\n.novel-bookshelf__grid {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  gap: var(--space-3);\n}\n@media (min-width: 480px) {\n  .novel-bookshelf__grid {\n    grid-template-columns: repeat(3, minmax(0, 1fr));\n  }\n}\n@media (min-width: 768px) {\n  .novel-bookshelf__grid {\n    grid-template-columns: repeat(4, minmax(0, 1fr));\n  }\n}\n@media (min-width: 1024px) {\n  .novel-bookshelf__grid {\n    grid-template-columns: repeat(5, minmax(0, 1fr));\n  }\n}\n@media (min-width: 1280px) {\n  .novel-bookshelf__grid {\n    grid-template-columns: repeat(6, minmax(0, 1fr));\n  }\n}\n\n/* ---------- list 视图 ---------- */\n.novel-bookshelf__list {\n  list-style: none;\n  margin: 0;\n  padding: 0;\n  display: flex;\n  flex-direction: column;\n  gap: var(--space-2);\n}\n.novel-bookshelf__list-item {\n  display: flex;\n  align-items: center;\n  gap: var(--space-3);\n  padding: var(--space-2);\n  border-radius: var(--radius-md);\n  background: var(--color-bg-surface);\n  border: 1px solid var(--color-border-subtle);\n  transition: border-color var(--dur-fast) var(--ease-standard),\n    box-shadow var(--dur-fast) var(--ease-standard);\n}\n.novel-bookshelf__list-item:hover {\n  border-color: var(--color-brand-border);\n  box-shadow: var(--sh-1);\n}\n.novel-bookshelf__list-item > .novel-book-card {\n  flex: 1;\n  min-width: 0;\n}\n\n/* list 视图元信息 */\n.novel-bookshelf__meta {\n  flex-shrink: 0;\n  display: flex;\n  flex-direction: column;\n  align-items: flex-end;\n  gap: var(--space-1);\n  min-width: 140px;\n}\n\n.novel-bookshelf__progress {\n  display: flex;\n  align-items: center;\n  gap: var(--space-2);\n  width: 100%;\n}\n.novel-bookshelf__progress-bar {\n  flex: 1;\n  height: 4px;\n  background: var(--color-bg-subtle);\n  border-radius: var(--radius-full);\n  overflow: hidden;\n}\n.novel-bookshelf__progress-fill {\n  height: 100%;\n  background: linear-gradient(\n    90deg,\n    var(--color-brand) 0%,\n    var(--color-accent) 100%\n  );\n  border-radius: var(--radius-full);\n  transition: width var(--dur-normal) var(--ease-standard);\n}\n.novel-bookshelf__progress-text {\n  font-family: var(--font-mono);\n  font-size: var(--font-size-overline);\n  color: var(--color-text-secondary);\n  min-width: 32px;\n  text-align: right;\n}\n\n.novel-bookshelf__last-read {\n  font-family: var(--font-sans);\n  font-size: var(--font-size-overline);\n  color: var(--color-text-tertiary);\n  white-space: nowrap;\n}\n\n.novel-bookshelf__remove {\n  padding: var(--space-1) var(--space-2);\n  border: 1px solid var(--color-border-subtle);\n  border-radius: var(--radius-sm);\n  background: transparent;\n  color: var(--color-text-tertiary);\n  font-family: var(--font-sans);\n  font-size: var(--font-size-overline);\n  cursor: pointer;\n  transition: color var(--dur-fast) var(--ease-standard),\n    border-color var(--dur-fast) var(--ease-standard);\n}\n.novel-bookshelf__remove:hover {\n  color: var(--color-rose);\n  border-color: var(--color-rose);\n}\n.novel-bookshelf__remove:focus-visible {\n  outline: none;\n  box-shadow: 0 0 0 2px var(--color-rose-bg);\n}\n\n/* ---------- 空状态 ---------- */\n.novel-bookshelf__empty {\n  padding: var(--space-8) var(--space-4);\n}\n.novel-bookshelf__discover-btn {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  padding: var(--space-2) var(--space-4);\n  border-radius: var(--radius-full);\n  background: var(--color-brand);\n  color: var(--color-text-inverse);\n  font-family: var(--font-sans);\n  font-size: var(--font-size-caption);\n  font-weight: var(--font-weight-medium);\n  text-decoration: none;\n  transition: background var(--dur-fast) var(--ease-standard);\n}\n.novel-bookshelf__discover-btn:hover {\n  background: var(--color-brand-hover);\n}\n.novel-bookshelf__discover-btn:focus-visible {\n  outline: none;\n  box-shadow: 0 0 0 2px var(--color-brand-bg);\n}\n\n/* ---------- 响应式：xs 隐藏部分控件 ---------- */\n@media (max-width: 479px) {\n  .novel-bookshelf__toolbar {\n    padding: var(--space-2) var(--space-3);\n  }\n  .novel-bookshelf__meta {\n    min-width: 96px;\n  }\n  .novel-bookshelf__progress-text {\n    min-width: 28px;\n  }\n}\n\n/* ---------- 暗色模式：list 项边框增强 ---------- */\n[data-theme='dark'] .novel-bookshelf__list-item {\n  background: var(--color-bg-elevated);\n}\n\n/* ============================================================\n * ReadingProgress · 03 §6.11\n * 顶部 2px 细条 brand-7 填充；桌面 8px 圆点拖拽 seek；H5 只读\n * 章节信息「第 N 章 / 共 M 章」font-sans 12px text-tertiary\n * ============================================================ */\n\n.novel-reading-progress {\n  position: relative;\n  width: 100%;\n  padding: 0 var(--space-4);\n  box-sizing: border-box;\n  z-index: var(--z-index-sticky);\n}\n\n/* ---------- 进度条轨道（2px 高，不挤压正文） ---------- */\n.novel-reading-progress__track {\n  position: relative;\n  width: 100%;\n  height: 2px;\n  background: var(--color-bg-subtle);\n  border-radius: var(--radius-full);\n  outline: none;\n}\n.novel-reading-progress__track:focus-visible {\n  box-shadow: 0 0 0 2px var(--color-brand-bg);\n  border-radius: var(--radius-sm);\n}\n\n/* 填充 */\n.novel-reading-progress__fill {\n  position: absolute;\n  top: 0;\n  left: 0;\n  height: 100%;\n  background: var(--color-brand);\n  border-radius: var(--radius-full);\n}\n\n/* ---------- 拖拽手柄（仅 seekable 时显示） ---------- */\n.novel-reading-progress__handle {\n  position: absolute;\n  top: 50%;\n  width: 8px;\n  height: 8px;\n  border-radius: 50%;\n  background: var(--color-brand);\n  border: 2px solid var(--color-bg-surface);\n  transform: translate(-50%, -50%);\n  box-shadow: var(--sh-1);\n  opacity: 0;\n  transition: opacity var(--dur-fast) var(--ease-standard);\n}\n.novel-reading-progress.is-seekable:hover .novel-reading-progress__handle,\n.novel-reading-progress.is-dragging .novel-reading-progress__handle {\n  opacity: 1;\n}\n\n/* ---------- 拖拽预览气泡 ---------- */\n.novel-reading-progress__bubble {\n  position: absolute;\n  top: -32px;\n  transform: translateX(-50%);\n  padding: var(--space-1) var(--space-2);\n  background: var(--color-bg-elevated);\n  color: var(--color-text-primary);\n  font-family: var(--font-sans);\n  font-size: var(--font-size-overline);\n  white-space: nowrap;\n  border-radius: var(--radius-sm);\n  box-shadow: var(--sh-2);\n  pointer-events: none;\n}\n.novel-reading-progress__bubble::after {\n  content: '';\n  position: absolute;\n  bottom: -4px;\n  left: 50%;\n  transform: translateX(-50%);\n  width: 0;\n  height: 0;\n  border-left: 4px solid transparent;\n  border-right: 4px solid transparent;\n  border-top: 4px solid var(--color-bg-elevated);\n}\n\n/* ---------- 章节信息 ---------- */\n.novel-reading-progress__info {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: var(--space-3);\n  margin-top: var(--space-1);\n  font-family: var(--font-sans);\n  font-size: var(--font-size-overline);\n  color: var(--color-text-tertiary);\n}\n.novel-reading-progress__chapter {\n  font-family: var(--font-mono);\n}\n.novel-reading-progress__done {\n  color: var(--color-brand);\n}\n\n/* ---------- 完成态：填充微亮 ---------- */\n.novel-reading-progress.is-complete .novel-reading-progress__fill {\n  background: var(--color-brand);\n  opacity: 1;\n}\n\n/* ---------- H5：无拖拽，仅展示 ---------- */\n@media (max-width: 479px) {\n  .novel-reading-progress {\n    padding: 0 var(--space-2);\n  }\n}\n\n/* ============================================================\n * ReaderSettings · 03 §6.13\n * 半屏面板：底部滑入 dur-normal 240ms ease-out\n * 遮罩半透明 text-primary 45%；字号滑块 + 分段控件 + 主题色块\n * ============================================================ */\n\n.novel-reader-settings {\n  position: fixed;\n  left: 0;\n  right: 0;\n  bottom: 0;\n  max-height: 50vh;\n  padding: var(--space-6) var(--space-4) calc(var(--space-6) + env(safe-area-inset-bottom, 0px));\n  background: var(--color-bg-surface);\n  border-radius: var(--radius-2xl) var(--radius-2xl) var(--radius-none) var(--radius-none);\n  box-shadow: var(--sh-3);\n  transform: translateY(100%);\n  transition: transform var(--dur-normal) var(--ease-decelerate);\n  z-index: var(--z-index-modal);\n  outline: none;\n  overflow-y: auto;\n}\n.novel-reader-settings.is-visible {\n  transform: translateY(0);\n}\n\n/* 遮罩 */\n.novel-reader-settings__overlay {\n  position: fixed;\n  inset: 0;\n  background: var(--color-text-primary);\n  opacity: 0.45;\n  z-index: var(--z-index-modal);\n}\n\n/* 拖拽手柄（视觉提示可下滑关闭） */\n.novel-reader-settings__handle {\n  width: 32px;\n  height: 4px;\n  margin: 0 auto var(--space-4);\n  background: var(--color-border-default);\n  border-radius: var(--radius-full);\n}\n\n/* 主体 */\n.novel-reader-settings__body {\n  display: flex;\n  flex-direction: column;\n  gap: var(--space-5);\n}\n\n/* ---------- 行 ---------- */\n.novel-reader-settings__row {\n  display: flex;\n  flex-direction: column;\n  gap: var(--space-2);\n}\n.novel-reader-settings__row-label {\n  font-family: var(--font-sans);\n  font-size: var(--font-size-caption);\n  font-weight: var(--font-weight-medium);\n  color: var(--color-text-secondary);\n}\n.novel-reader-settings__row-content {\n  display: flex;\n  align-items: center;\n  gap: var(--space-3);\n}\n\n/* ---------- 字号三件式 ---------- */\n.novel-reader-settings__font-size {\n  display: flex;\n  align-items: center;\n  gap: var(--space-3);\n  width: 100%;\n}\n.novel-reader-settings__step-btn {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  width: 36px;\n  height: 36px;\n  border: 1px solid var(--color-border-subtle);\n  border-radius: var(--radius-md);\n  background: var(--color-bg-surface);\n  color: var(--color-text-secondary);\n  font-family: var(--font-sans);\n  font-size: var(--font-size-caption);\n  cursor: pointer;\n  transition: color var(--dur-fast) var(--ease-standard),\n    border-color var(--dur-fast) var(--ease-standard),\n    background var(--dur-fast) var(--ease-standard);\n}\n.novel-reader-settings__step-btn:hover:not(:disabled) {\n  color: var(--color-brand);\n  border-color: var(--color-brand-border);\n  background: var(--color-brand-bg);\n}\n.novel-reader-settings__step-btn:disabled {\n  opacity: 0.4;\n  cursor: not-allowed;\n}\n.novel-reader-settings__step-btn:focus-visible {\n  outline: none;\n  box-shadow: 0 0 0 2px var(--color-brand-bg);\n}\n\n/* 滑块 */\n.novel-reader-settings__slider {\n  flex: 1;\n  height: 4px;\n  -webkit-appearance: none;\n     -moz-appearance: none;\n          appearance: none;\n  background: var(--color-bg-subtle);\n  border-radius: var(--radius-full);\n  outline: none;\n  cursor: pointer;\n}\n.novel-reader-settings__slider::-webkit-slider-thumb {\n  -webkit-appearance: none;\n          appearance: none;\n  width: 16px;\n  height: 16px;\n  border-radius: 50%;\n  background: var(--color-brand);\n  border: 2px solid var(--color-bg-surface);\n  box-shadow: var(--sh-1);\n  cursor: grab;\n}\n.novel-reader-settings__slider::-webkit-slider-thumb:active {\n  cursor: grabbing;\n}\n.novel-reader-settings__slider::-moz-range-thumb {\n  width: 16px;\n  height: 16px;\n  border-radius: 50%;\n  background: var(--color-brand);\n  border: 2px solid var(--color-bg-surface);\n  box-shadow: var(--sh-1);\n  cursor: grab;\n}\n.novel-reader-settings__slider:focus-visible {\n  box-shadow: 0 0 0 2px var(--color-brand-bg);\n  border-radius: var(--radius-sm);\n}\n\n/* 当前值 */\n.novel-reader-settings__value {\n  flex-shrink: 0;\n  min-width: 3em;\n  text-align: center;\n  font-family: var(--font-mono);\n  font-size: var(--font-size-body);\n  color: var(--color-text-primary);\n  font-weight: var(--font-weight-medium);\n}\n\n/* ---------- 分段控件（行距/字体/翻页） ---------- */\n.novel-reader-settings__segmented {\n  display: inline-flex;\n  gap: var(--space-1);\n  padding: var(--space-1);\n  background: var(--color-bg-subtle);\n  border-radius: var(--radius-md);\n}\n.novel-reader-settings__segment {\n  padding: var(--space-2) var(--space-4);\n  border: 1px solid transparent;\n  border-radius: var(--radius-sm);\n  background: transparent;\n  color: var(--color-text-secondary);\n  font-family: var(--font-sans);\n  font-size: var(--font-size-caption);\n  cursor: pointer;\n  transition: color var(--dur-fast) var(--ease-standard),\n    background var(--dur-fast) var(--ease-standard),\n    border-color var(--dur-fast) var(--ease-standard);\n}\n.novel-reader-settings__segment:hover {\n  color: var(--color-text-primary);\n}\n.novel-reader-settings__segment.is-active {\n  border: 2px solid var(--color-brand);\n  background: var(--color-bg-surface);\n  color: var(--color-text-primary);\n  font-weight: var(--font-weight-medium);\n  padding: calc(var(--space-2) - 1px) calc(var(--space-4) - 1px);\n}\n.novel-reader-settings__segment:focus-visible {\n  outline: none;\n  box-shadow: 0 0 0 2px var(--color-brand-bg);\n}\n\n/* ---------- 主题色块（四选一） ---------- */\n.novel-reader-settings__themes {\n  display: flex;\n  gap: var(--space-3);\n}\n.novel-reader-settings__theme-swatch {\n  position: relative;\n  width: 56px;\n  height: 56px;\n  border: 2px solid var(--color-border-default);\n  border-radius: var(--radius-md);\n  cursor: pointer;\n  overflow: hidden;\n  display: flex;\n  align-items: flex-end;\n  justify-content: center;\n  padding-bottom: var(--space-1);\n  transition: border-color var(--dur-fast) var(--ease-standard),\n    box-shadow var(--dur-fast) var(--ease-standard);\n}\n.novel-reader-settings__theme-swatch.is-active {\n  border-color: var(--color-brand);\n  box-shadow: 0 0 0 3px var(--color-brand-bg);\n}\n.novel-reader-settings__theme-swatch:focus-visible {\n  outline: none;\n  box-shadow: 0 0 0 3px var(--color-brand-bg);\n}\n.novel-reader-settings__theme-label {\n  font-family: var(--font-sans);\n  font-size: var(--font-size-overline);\n  font-weight: var(--font-weight-medium);\n}\n\n/* ---------- H5 适配：行布局更紧凑 ---------- */\n@media (max-width: 479px) {\n  .novel-reader-settings {\n    padding: var(--space-4) var(--space-3) calc(var(--space-4) + env(safe-area-inset-bottom, 0px));\n  }\n  .novel-reader-settings__themes {\n    gap: var(--space-2);\n  }\n  .novel-reader-settings__theme-swatch {\n    width: 48px;\n    height: 48px;\n  }\n}\n\n/* ---------- 减弱动效 ---------- */\n@media (prefers-reduced-motion: reduce) {\n  .novel-reader-settings {\n    transition: none;\n  }\n}\n\n/* ============================================================\n * Reader · 03 §5.3 / §6.3\n * 容器：全屏沉浸；正文 756px 居中；控制栏浮层闲置 3s 淡出\n * 翻页：slide transform / scroll 原生 / click 淡入\n * ============================================================ */\n\n.novel-reader {\n  position: relative;\n  width: 100%;\n  height: 100%;\n  min-height: 100vh;\n  overflow: hidden;\n  font-family: var(--font-sans);\n}\n\n/* ---------- 章节加载条（顶部 2px，不遮挡正文） ---------- */\n.novel-reader__loading-bar {\n  position: absolute;\n  top: 0;\n  left: 0;\n  right: 0;\n  height: 2px;\n  background: var(--color-brand-bg);\n  overflow: hidden;\n  z-index: var(--z-index-sticky);\n}\n.novel-reader__loading-bar-fill {\n  width: 40%;\n  height: 100%;\n  background: var(--color-brand);\n  border-radius: var(--radius-full);\n  animation: novel-reader-loading var(--dur-slow) var(--ease-standard) infinite;\n}\n@keyframes novel-reader-loading {\n  0% { transform: translateX(-100%); }\n  100% { transform: translateX(350%); }\n}\n@media (prefers-reduced-motion: reduce) {\n  .novel-reader__loading-bar-fill {\n    animation: none;\n    width: 100%;\n    opacity: 0.6;\n  }\n}\n\n/* ---------- 正文区 ---------- */\n.novel-reader__content {\n  position: relative;\n  width: 100%;\n  height: 100%;\n  overflow-y: auto;\n  overflow-x: hidden;\n  -webkit-overflow-scrolling: touch;\n}\n/* 自定义细滚动条 */\n.novel-reader__content::-webkit-scrollbar {\n  width: 4px;\n}\n.novel-reader__content::-webkit-scrollbar-track {\n  background: transparent;\n}\n.novel-reader__content::-webkit-scrollbar-thumb {\n  background: var(--color-border-default);\n  border-radius: var(--radius-full);\n}\n\n/* 正文内层：居中 + 最大行宽 756px */\n.novel-reader__inner {\n  max-width: 756px;\n  margin: 0 auto;\n  padding: var(--space-8) var(--space-4);\n  /* P7-7 安全区：顶部状态栏 + 底部 Home Indicator 让位 */\n  padding-top: calc(var(--space-8) + env(safe-area-inset-top, 0px));\n  padding-bottom: calc(var(--space-8) + env(safe-area-inset-bottom, 0px));\n  box-sizing: border-box;\n  /* P8-A4 字号无上限：最大 24px 时段落不溢出，自动换行 */\n  overflow-wrap: break-word;\n  word-break: break-word;\n}\n@media (min-width: 768px) {\n  .novel-reader__inner {\n    padding-left: var(--space-8);\n    padding-right: var(--space-8);\n  }\n}\n\n/* 章节标题 */\n.novel-reader__chapter-title {\n  margin: 0 0 var(--space-6);\n  font-family: var(--font-serif);\n  font-size: var(--font-size-h3);\n  font-weight: var(--font-weight-medium);\n  color: var(--novel-read-text);\n  text-align: center;\n}\n\n/* 正文段落 */\n.novel-reader__article-body {\n  color: var(--novel-read-text);\n}\n.novel-reader__article-body p {\n  margin: 0 0 1em;\n  text-indent: 2em;\n  text-align: justify;\n  word-break: break-word;\n}\n.novel-reader__article-body p:last-child {\n  margin-bottom: 0;\n}\n\n/* 章末操作区 */\n.novel-reader__chapter-end {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: var(--space-3);\n  margin-top: var(--space-12);\n  padding-top: var(--space-8);\n  border-top: 1px solid var(--color-border-subtle);\n}\n.novel-reader__nav-btn {\n  min-width: 160px;\n  padding: var(--space-2) var(--space-6);\n  border: 1px solid var(--color-border-default);\n  border-radius: var(--radius-full);\n  background: transparent;\n  color: var(--novel-read-text);\n  font-family: var(--font-sans);\n  font-size: var(--font-size-caption);\n  cursor: pointer;\n  transition: color var(--dur-fast) var(--ease-standard),\n    border-color var(--dur-fast) var(--ease-standard),\n    background var(--dur-fast) var(--ease-standard);\n}\n.novel-reader__nav-btn:hover:not(:disabled) {\n  border-color: var(--color-brand-border);\n  color: var(--color-brand);\n}\n.novel-reader__nav-btn:disabled {\n  opacity: 0.4;\n  cursor: not-allowed;\n}\n.novel-reader__nav-btn:focus-visible {\n  outline: none;\n  box-shadow: 0 0 0 2px var(--color-brand-bg);\n}\n.novel-reader__nav-btn--primary {\n  background: var(--color-brand);\n  border-color: var(--color-brand);\n  color: var(--color-text-inverse);\n}\n.novel-reader__nav-btn--primary:hover:not(:disabled) {\n  background: var(--color-brand-hover);\n  border-color: var(--color-brand-hover);\n  color: var(--color-text-inverse);\n}\n\n/* 加载占位 */\n.novel-reader__placeholder {\n  height: 60vh;\n}\n\n/* 错误态 */\n.novel-reader__error {\n  text-align: center;\n  padding: var(--space-12) var(--space-4);\n  color: var(--color-feedback-error);\n  font-family: var(--font-sans);\n}\n.novel-reader__error-detail {\n  margin-top: var(--space-2);\n  font-size: var(--font-size-caption);\n  color: var(--novel-read-text-secondary);\n}\n\n/* ---------- 点击翻页：左右半屏点击区（不可见，仅命中） ---------- */\n.novel-reader__tap-zone {\n  position: absolute;\n  top: 0;\n  bottom: 0;\n  width: 30%;\n  z-index: 1;\n  /* 不可见但可点击 */\n  background: transparent;\n}\n.novel-reader__tap-zone--left {\n  left: 0;\n}\n.novel-reader__tap-zone--right {\n  right: 0;\n}\n\n/* ---------- 顶部栏（浮层） ---------- */\n.novel-reader__topbar {\n  position: fixed;\n  top: 0;\n  left: 0;\n  right: 0;\n  display: flex;\n  align-items: center;\n  gap: var(--space-3);\n  height: var(--reader-toolbar-height);\n  padding: 0 var(--space-3);\n  background: var(--novel-read-bg);\n  border-bottom: 1px solid var(--color-border-subtle);\n  z-index: var(--z-index-sticky);\n  opacity: 0;\n  transform: translateY(-100%);\n  transition: opacity var(--dur-normal) var(--ease-standard),\n    transform var(--dur-normal) var(--ease-standard);\n  pointer-events: none;\n  /* 毛玻璃背景 */\n  backdrop-filter: saturate(180%) blur(12px);\n  -webkit-backdrop-filter: saturate(180%) blur(12px);\n}\n.novel-reader.is-controls-visible .novel-reader__topbar {\n  opacity: 1;\n  transform: translateY(0);\n  pointer-events: auto;\n}\n.novel-reader__topbar-title-wrap {\n  flex: 1;\n  min-width: 0;\n  display: flex;\n  flex-direction: column;\n  gap: 1px;\n  overflow: hidden;\n}\n.novel-reader__topbar-chapter-num {\n  font-size: var(--font-size-overline);\n  font-weight: var(--font-weight-semibold);\n  letter-spacing: var(--letter-spacing-wider);\n  color: var(--color-brand);\n  line-height: 1;\n}\n.novel-reader__topbar-title {\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n  font-family: var(--font-serif);\n  font-size: var(--font-size-caption);\n  font-weight: var(--font-weight-medium);\n  color: var(--novel-read-text);\n  text-align: center;\n  line-height: 1.3;\n  letter-spacing: var(--letter-spacing-tight);\n}\n.novel-reader__topbar-elapsed {\n  font-size: var(--font-size-overline);\n  font-family: var(--font-mono);\n  font-weight: var(--font-weight-emphasis);\n  font-variant-numeric: tabular-nums;\n  letter-spacing: var(--letter-spacing-caption);\n  color: var(--color-text-tertiary);\n  min-width: 2.5em;\n  text-align: right;\n}\n.novel-reader__topbar-right {\n  display: inline-flex;\n  align-items: center;\n  min-width: 36px;\n  gap: 2px;\n}\n\n/* ---------- 底部控制栏（浮层） ---------- */\n.novel-reader__bottombar {\n  position: fixed;\n  bottom: 0;\n  left: 0;\n  right: 0;\n  display: flex;\n  align-items: center;\n  justify-content: space-around;\n  gap: var(--space-1);\n  height: var(--reader-toolbar-height);\n  padding: 0 var(--space-2) env(safe-area-inset-bottom, 0px);\n  background: var(--novel-read-bg);\n  border-top: 1px solid var(--color-border-subtle);\n  z-index: var(--z-index-sticky);\n  opacity: 0;\n  transform: translateY(100%);\n  transition: opacity var(--dur-normal) var(--ease-standard),\n    transform var(--dur-normal) var(--ease-standard);\n  pointer-events: none;\n}\n.novel-reader.is-controls-visible .novel-reader__bottombar {\n  opacity: 1;\n  transform: translateY(0);\n  pointer-events: auto;\n}\n\n/* 控制栏按钮 */\n.novel-reader__bar-btn {\n  display: inline-flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 2px;\n  padding: var(--space-1) var(--space-2);\n  border: none;\n  background: transparent;\n  color: var(--novel-read-text);\n  font-family: var(--font-sans);\n  font-size: var(--font-size-overline);\n  cursor: pointer;\n  border-radius: var(--radius-sm);\n  transition: color var(--dur-fast) var(--ease-standard),\n    background var(--dur-fast) var(--ease-standard);\n}\n.novel-reader__bar-btn:hover:not(:disabled) {\n  color: var(--color-brand);\n  background: var(--color-brand-bg);\n}\n.novel-reader__bar-btn:disabled {\n  opacity: 0.4;\n  cursor: not-allowed;\n}\n.novel-reader__bar-btn:focus-visible {\n  outline: none;\n  box-shadow: 0 0 0 2px var(--color-brand-bg);\n}\n\n/* 顶部栏图标按钮 */\n.novel-reader__icon-btn {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  width: 36px;\n  height: 36px;\n  border: none;\n  background: transparent;\n  color: var(--novel-read-text);\n  cursor: pointer;\n  border-radius: var(--radius-sm);\n  transition: color var(--dur-fast) var(--ease-standard),\n    background var(--dur-fast) var(--ease-standard);\n}\n.novel-reader__icon-btn:hover {\n  color: var(--color-brand);\n  background: var(--color-brand-bg);\n}\n.novel-reader__icon-btn:focus-visible {\n  outline: none;\n  box-shadow: 0 0 0 2px var(--color-brand-bg);\n}\n\n/* ---------- 翻页动画（slide/click） ---------- */\n/* slide 模式：章节切换时正文淡入位移 */\n.novel-reader--slide .novel-reader__inner {\n  animation: novel-reader-slide-in var(--dur-normal) var(--ease-standard);\n}\n@keyframes novel-reader-slide-in {\n  0% { opacity: 0; transform: translateX(20px); }\n  100% { opacity: 1; transform: translateX(0); }\n}\n\n/* click 模式：章节切换淡入淡出 */\n.novel-reader--click .novel-reader__inner {\n  animation: novel-reader-fade-in var(--dur-normal) var(--ease-standard);\n}\n@keyframes novel-reader-fade-in {\n  0% { opacity: 0; }\n  100% { opacity: 1; }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .novel-reader--slide .novel-reader__inner,\n  .novel-reader--click .novel-reader__inner {\n    animation: none;\n  }\n  .novel-reader__topbar,\n  .novel-reader__bottombar {\n    transition: opacity var(--dur-fast) var(--ease-standard);\n    transform: none;\n  }\n}\n\n/* ---------- 下一章预览卡 ---------- */\n.novel-reader__next-chapter-preview {\n  margin-top: var(--space-8);\n  padding: var(--space-5);\n  background: linear-gradient(\n    135deg,\n    var(--color-brand-bg) 0%,\n    var(--color-bg-surface) 100%\n  );\n  border: 1px solid var(--color-brand-border);\n  border-radius: var(--radius-lg);\n  box-shadow: var(--sh-2);\n}\n.novel-reader__next-chapter-preview-label {\n  display: flex;\n  align-items: center;\n  gap: var(--space-2);\n  margin-bottom: var(--space-3);\n}\n.novel-reader__next-chapter-preview-badge {\n  display: inline-flex;\n  align-items: center;\n  padding: 2px var(--space-2);\n  border-radius: var(--radius-full);\n  background: var(--color-brand);\n  color: var(--color-text-inverse);\n  font-size: var(--font-size-overline);\n  font-weight: var(--font-weight-bold);\n  letter-spacing: var(--letter-spacing-wider);\n}\n.novel-reader__next-chapter-preview-title {\n  font-family: var(--font-serif);\n  font-size: var(--font-size-body-lg);\n  font-weight: var(--font-weight-semibold);\n  color: var(--novel-read-text);\n  letter-spacing: var(--letter-spacing-tight);\n}\n.novel-reader__next-chapter-preview-text {\n  margin: 0 0 var(--space-4);\n  font-size: var(--font-size-caption);\n  line-height: var(--line-height-relaxed);\n  color: var(--novel-read-text-secondary);\n  text-align: justify;\n  text-indent: 2em;\n}\n\n/* ---------- 响应式：xs/sm 全屏沉浸 ---------- */\n@media (max-width: 767px) {\n  .novel-reader__inner {\n    max-width: 100%;\n    padding: var(--space-6) var(--space-3);\n  }\n  .novel-reader__chapter-title {\n    font-size: var(--font-size-body);\n  }\n}\n\n/* ---------- 暗色模式：顶部/底部栏背景增强 ---------- */\n[data-theme='dark'] .novel-reader__topbar,\n[data-theme='dark'] .novel-reader__bottombar {\n  background: var(--color-bg-elevated);\n}\n\n/* ---------- P8-A5 高对比模式：阅读器描边增强 ---------- */\n@media (prefers-contrast: more) {\n  .novel-reader__topbar,\n  .novel-reader__bottombar {\n    border-color: var(--novel-read-text);\n    border-width: 2px;\n  }\n  .novel-reader__chapter-end {\n    border-top-color: var(--novel-read-text);\n    border-top-width: 2px;\n  }\n  .novel-reader__nav-btn {\n    border-width: 2px;\n    border-color: var(--novel-read-text);\n  }\n}\n\n/* ---------- P8-A4 字号最大档（24px）响应式收窄行宽 ---------- */\n@media (max-width: 480px) {\n  /* 小屏 + 大字号时收紧正文内边距，避免溢出 */\n  .novel-reader__inner {\n    padding-left: var(--space-3);\n    padding-right: var(--space-3);\n  }\n}\n\n/* ============================================================\n * RankingBoard · P6 §1\n * 4 Tab + 行高 56px + TOP1-3 奖牌 + 排名变化 + 切 Tab 淡入\n * ============================================================ */\n\n.novel-ranking {\n  font-family: var(--font-sans);\n  background: var(--color-bg-surface);\n  border: 1px solid var(--color-border-subtle);\n  border-radius: var(--radius-lg);\n  overflow: hidden;\n}\n\n/* ---------- Tab 条 ---------- */\n.novel-ranking__tabs {\n  display: flex;\n  gap: var(--space-1);\n  padding: var(--space-2) var(--space-3);\n  border-bottom: 1px solid var(--color-border-subtle);\n  background: var(--color-bg-subtle);\n}\n\n.novel-ranking__tab {\n  flex: 1;\n  padding: var(--space-2) var(--space-3);\n  border: none;\n  border-radius: var(--radius-md);\n  background: transparent;\n  color: var(--color-text-secondary);\n  font-family: var(--font-sans);\n  font-size: var(--font-size-caption);\n  font-weight: var(--font-weight-medium);\n  cursor: pointer;\n  transition: background var(--dur-fast) var(--ease-standard),\n    color var(--dur-fast) var(--ease-standard);\n}\n.novel-ranking__tab:hover {\n  background: var(--color-bg-surface);\n  color: var(--color-text-primary);\n}\n.novel-ranking__tab.is-active {\n  background: var(--color-bg-surface);\n  color: var(--color-brand);\n  font-weight: var(--font-weight-semibold);\n  box-shadow: var(--sh-1);\n}\n.novel-ranking__tab:focus-visible {\n  outline: none;\n  box-shadow: 0 0 0 2px var(--color-brand-bg);\n}\n\n/* ---------- 列表（切 Tab 淡入） ---------- */\n.novel-ranking__list {\n  margin: 0;\n  padding: 0;\n  list-style: none;\n  animation: novel-ranking-fade-in var(--dur-normal) var(--ease-standard);\n}\n\n@keyframes novel-ranking-fade-in {\n  from {\n    opacity: 0;\n    transform: translateY(4px);\n  }\n  to {\n    opacity: 1;\n    transform: translateY(0);\n  }\n}\n\n/* ---------- 行 ---------- */\n.novel-ranking__row {\n  display: flex;\n  align-items: center;\n  gap: var(--space-3);\n  height: 56px;\n  padding: 0 var(--space-4);\n  border-bottom: 1px solid var(--color-border-subtle);\n  transition: background var(--dur-fast) var(--ease-standard);\n}\n.novel-ranking__row:last-child {\n  border-bottom: none;\n}\n.novel-ranking__row.is-clickable {\n  cursor: pointer;\n}\n.novel-ranking__row.is-clickable:hover {\n  background: var(--color-bg-subtle);\n}\n.novel-ranking__row.is-clickable:focus-visible {\n  outline: none;\n  box-shadow: inset 0 0 0 2px var(--color-brand-bg);\n}\n\n/* ---------- 左：序号 / 奖牌 ---------- */\n.novel-ranking__rank {\n  flex-shrink: 0;\n  width: 32px;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n}\n\n.novel-ranking__num {\n  font-family: var(--font-mono);\n  font-size: var(--font-size-body);\n  font-weight: var(--font-weight-medium);\n  color: var(--color-text-tertiary);\n}\n\n.novel-ranking__medal {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  width: 24px;\n  height: 24px;\n  border-radius: var(--radius-full);\n  font-family: var(--font-mono);\n  font-size: var(--font-size-caption);\n  font-weight: var(--font-weight-bold);\n  color: var(--color-text-inverse);\n}\n.novel-ranking__medal--gold {\n  background: var(--color-rank-gold-gradient);\n}\n.novel-ranking__medal--silver {\n  background: var(--color-rank-silver-gradient);\n}\n.novel-ranking__medal--bronze {\n  background: var(--color-rank-bronze-gradient);\n}\n\n/* ---------- 中：书名 / 作者 ---------- */\n.novel-ranking__main {\n  flex: 1;\n  min-width: 0;\n  display: flex;\n  flex-direction: column;\n  gap: 2px;\n}\n\n.novel-ranking__title {\n  font-family: var(--font-serif);\n  font-size: var(--font-size-body);\n  color: var(--color-text-primary);\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n.novel-ranking__row.is-top .novel-ranking__title {\n  font-weight: var(--font-weight-semibold);\n}\n\n.novel-ranking__author {\n  font-family: var(--font-sans);\n  font-size: var(--font-size-caption);\n  color: var(--color-text-tertiary);\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n/* ---------- 右：评分 + 排名变化 ---------- */\n.novel-ranking__meta {\n  flex-shrink: 0;\n  display: inline-flex;\n  align-items: center;\n  gap: var(--space-2);\n}\n\n.novel-ranking__score {\n  display: inline-flex;\n  align-items: center;\n  gap: 2px;\n  font-family: var(--font-mono);\n  font-size: var(--font-size-caption);\n  color: var(--color-text-secondary);\n}\n.novel-ranking__star {\n  color: var(--color-accent-orange);\n  line-height: 1;\n}\n.novel-ranking__score-num {\n  font-weight: var(--font-weight-medium);\n}\n\n.novel-ranking__trend {\n  display: inline-flex;\n  align-items: center;\n  gap: 2px;\n  min-width: 28px;\n  justify-content: flex-end;\n  font-family: var(--font-mono);\n  font-size: var(--font-size-overline);\n  font-weight: var(--font-weight-medium);\n}\n/* P8-A6 色觉障碍友好：升/降文字标签，颜色之外的双重表达 */\n.novel-ranking__trend-label {\n  font-family: var(--font-sans);\n  font-size: 10px;\n  font-weight: var(--font-weight-semibold);\n  line-height: 1;\n}\n.novel-ranking__trend--up {\n  color: var(--color-feedback-success);\n}\n.novel-ranking__trend--down {\n  color: var(--color-rose);\n}\n.novel-ranking__trend--flat {\n  color: var(--color-text-tertiary);\n}\n.novel-ranking__trend--new {\n  padding: 1px var(--space-1);\n  border-radius: var(--radius-sm);\n  background: var(--color-accent-orange-bg);\n  color: var(--color-accent-orange);\n  font-family: var(--font-sans);\n  font-weight: var(--font-weight-semibold);\n  line-height: 14px;\n}\n\n/* ---------- 空状态 ---------- */\n.novel-ranking__empty {\n  list-style: none;\n  padding: var(--space-8) var(--space-4);\n  text-align: center;\n  font-size: var(--font-size-caption);\n  color: var(--color-text-tertiary);\n}\n\n/* ---------- 骨架屏 ---------- */\n.novel-ranking__row.is-skeleton {\n  pointer-events: none;\n}\n.novel-ranking__skeleton-rank {\n  width: 24px;\n  height: 24px;\n  border-radius: var(--radius-full);\n  background: var(--color-bg-subtle);\n}\n.novel-ranking__skeleton-body {\n  flex: 1;\n  display: flex;\n  flex-direction: column;\n  gap: var(--space-1);\n}\n.novel-ranking__skeleton-line {\n  border-radius: var(--radius-sm);\n  background: linear-gradient(\n    90deg,\n    var(--color-bg-subtle) 0%,\n    var(--color-bg-elevated) 50%,\n    var(--color-bg-subtle) 100%\n  );\n  background-size: 200% 100%;\n  animation: novel-skeleton-shimmer var(--dur-slow) var(--ease-standard) infinite;\n}\n.novel-ranking__skeleton-line--title {\n  height: 14px;\n  width: 70%;\n}\n.novel-ranking__skeleton-line--sub {\n  height: 12px;\n  width: 40%;\n}\n.novel-ranking__skeleton-line--score {\n  height: 14px;\n  width: 36px;\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .novel-ranking__list {\n    animation: none;\n  }\n  .novel-ranking__skeleton-line {\n    animation: none;\n  }\n}\n\n/* ============================================================\n * TagCloud · P6 §2\n * cloud：pill 自适应字号；list：行式 name + count\n * ============================================================ */\n\n.novel-tagcloud {\n  font-family: var(--font-sans);\n}\n\n.novel-tagcloud ul {\n  margin: 0;\n  padding: 0;\n  list-style: none;\n}\n\n/* ---------- cloud 变体 ---------- */\n.novel-tagcloud__cloud {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  gap: var(--space-2);\n}\n\n.novel-tagcloud__pill {\n  display: inline-flex;\n  align-items: center;\n  gap: var(--space-1);\n  padding: var(--space-1) var(--space-3);\n  border: 1px solid transparent;\n  border-radius: var(--radius-full);\n  background: var(--color-bg-subtle);\n  color: var(--color-text-primary);\n  font-family: var(--font-sans);\n  cursor: pointer;\n  transition: background var(--dur-fast) var(--ease-standard),\n    color var(--dur-fast) var(--ease-standard),\n    border-color var(--dur-fast) var(--ease-standard),\n    box-shadow var(--dur-fast) var(--ease-standard);\n}\n\n/* 字号分档（count 越大字越大） */\n.novel-tagcloud__pill--sm {\n  font-size: var(--font-size-caption);\n}\n.novel-tagcloud__pill--md {\n  font-size: var(--font-size-body);\n}\n.novel-tagcloud__pill--xl {\n  font-size: var(--font-size-h3);\n}\n\n.novel-tagcloud__pill:hover {\n  background: var(--color-bg-surface);\n  box-shadow: var(--sh-1);\n}\n\n/* 热门 TOP3：brand 加粗 */\n.novel-tagcloud__pill.is-hot {\n  color: var(--color-brand);\n  font-weight: var(--font-weight-bold);\n}\n.novel-tagcloud__hot {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  width: 16px;\n  height: 16px;\n  border-radius: var(--radius-sm);\n  background: var(--color-accent-orange-bg);\n  color: var(--color-accent-orange);\n  font-size: var(--font-size-overline);\n  font-weight: var(--font-weight-semibold);\n  line-height: 16px;\n}\n\n/* 选中：brand-bg + brand 文字 + brand 边框 */\n.novel-tagcloud__pill.is-selected {\n  background: var(--color-brand-bg);\n  color: var(--color-brand);\n  border-color: var(--color-brand-border);\n  font-weight: var(--font-weight-semibold);\n}\n.novel-tagcloud__pill.is-selected:hover {\n  background: var(--color-brand-bg);\n}\n.novel-tagcloud__pill:focus-visible {\n  outline: none;\n  box-shadow: 0 0 0 2px var(--color-brand-bg);\n}\n\n.novel-tagcloud__count {\n  font-family: var(--font-mono);\n  font-size: var(--font-size-overline);\n  opacity: 0.8;\n}\n\n/* ---------- list 变体 ---------- */\n.novel-tagcloud__listview {\n  display: flex;\n  flex-direction: column;\n}\n\n.novel-tagcloud__item {\n  border-bottom: 1px solid var(--color-border-subtle);\n}\n.novel-tagcloud__item:last-child {\n  border-bottom: none;\n}\n.novel-tagcloud__item.is-selected {\n  background: var(--color-brand-bg);\n}\n\n.novel-tagcloud__item-btn {\n  display: flex;\n  width: 100%;\n  align-items: center;\n  justify-content: space-between;\n  gap: var(--space-3);\n  padding: var(--space-2) var(--space-3);\n  border: none;\n  background: transparent;\n  color: var(--color-text-primary);\n  font-family: var(--font-sans);\n  font-size: var(--font-size-caption);\n  cursor: pointer;\n  transition: background var(--dur-fast) var(--ease-standard);\n}\n.novel-tagcloud__item-btn:hover {\n  background: var(--color-bg-subtle);\n}\n.novel-tagcloud__item.is-selected .novel-tagcloud__item-btn {\n  color: var(--color-brand);\n  font-weight: var(--font-weight-medium);\n}\n.novel-tagcloud__item-btn:focus-visible {\n  outline: none;\n  box-shadow: inset 0 0 0 2px var(--color-brand-bg);\n}\n\n.novel-tagcloud__listview .novel-tagcloud__count {\n  font-size: var(--font-size-caption);\n  color: var(--color-text-tertiary);\n  opacity: 1;\n}\n\n/* ============================================================\n * Comment · P6 §3\n * 楼中楼：头像 32px + 昵称 + 内容(行高1.7) + 操作栏；replies 竖线缩进\n * ============================================================ */\n\n.novel-comment {\n  font-family: var(--font-sans);\n  color: var(--color-text-primary);\n}\n\n.novel-comment__node {\n  display: flex;\n  gap: var(--space-3);\n  align-items: flex-start;\n}\n\n.novel-comment__avatar {\n  flex-shrink: 0;\n}\n\n.novel-comment__body {\n  flex: 1;\n  min-width: 0;\n}\n\n/* ---------- 头部：昵称 + 评分 ---------- */\n.novel-comment__head {\n  display: flex;\n  align-items: center;\n  gap: var(--space-2);\n  flex-wrap: wrap;\n}\n\n.novel-comment__name {\n  font-family: var(--font-sans);\n  font-size: var(--font-size-caption);\n  font-weight: var(--font-weight-medium);\n  color: var(--color-text-secondary);\n}\n\n/* ---------- 内容 ---------- */\n.novel-comment__content {\n  margin-top: var(--space-1);\n  font-family: var(--font-sans);\n  font-size: var(--font-size-body);\n  line-height: var(--line-height-relaxed);\n  color: var(--color-text-primary);\n  word-break: break-word;\n}\n\n/* ---------- 操作栏 ---------- */\n.novel-comment__actions {\n  display: flex;\n  align-items: center;\n  gap: var(--space-3);\n  margin-top: var(--space-1);\n}\n\n.novel-comment__time {\n  font-family: var(--font-mono);\n  font-size: var(--font-size-overline);\n  color: var(--color-text-tertiary);\n}\n\n.novel-comment__action {\n  display: inline-flex;\n  align-items: center;\n  gap: var(--space-1);\n  padding: 0;\n  border: none;\n  background: transparent;\n  font-family: var(--font-sans);\n  font-size: var(--font-size-overline);\n  color: var(--color-text-tertiary);\n  cursor: pointer;\n  transition: color var(--dur-fast) var(--ease-standard);\n}\n.novel-comment__action:hover {\n  color: var(--color-text-secondary);\n}\n.novel-comment__action:focus-visible {\n  outline: none;\n  border-radius: var(--radius-sm);\n  box-shadow: 0 0 0 2px var(--color-brand-bg);\n}\n\n.novel-comment__like-count {\n  font-family: var(--font-mono);\n}\n\n/* 已点赞：红心 rose + 数字加粗 */\n.novel-comment__action.is-liked {\n  color: var(--color-rose);\n}\n.novel-comment__action.is-liked .novel-comment__like-count {\n  font-weight: var(--font-weight-bold);\n}\n\n/* ---------- 软删除占位 ---------- */\n.novel-comment__deleted {\n  font-family: var(--font-sans);\n  font-size: var(--font-size-caption);\n  font-style: italic;\n  color: var(--color-text-tertiary);\n  padding: var(--space-1) 0;\n}\n\n/* ---------- 楼中楼：缩进 + 左侧 2px 竖线 ---------- */\n.novel-comment__reply {\n  display: flex;\n  flex-direction: column;\n  gap: var(--space-3);\n}\n\n.novel-comment__replies {\n  margin-left: var(--space-4);\n  padding-left: var(--space-4);\n  border-left: 2px solid var(--color-border-subtle);\n  display: flex;\n  flex-direction: column;\n  gap: var(--space-3);\n  margin-top: var(--space-3);\n}\n\n.novel-comment__expand {\n  align-self: flex-start;\n  padding: 0;\n  border: none;\n  background: transparent;\n  font-family: var(--font-sans);\n  font-size: var(--font-size-overline);\n  color: var(--color-text-link);\n  cursor: pointer;\n  transition: color var(--dur-fast) var(--ease-standard);\n}\n.novel-comment__expand:hover {\n  color: var(--color-text-link-hover);\n}\n.novel-comment__expand:focus-visible {\n  outline: none;\n  border-radius: var(--radius-sm);\n  box-shadow: 0 0 0 2px var(--color-brand-bg);\n}\n\n/* ============================================================\n * RewardButton · P6 §4\n * 月票/打赏：rose-gradient；推荐：rose 实色\n * hover 提亮+sh-2；active scale 0.92；粒子飞出\n * ============================================================ */\n\n.novel-reward__wrap {\n  display: inline-flex;\n  flex-direction: column;\n  align-items: center;\n  gap: var(--space-1);\n  font-family: var(--font-sans);\n}\n\n.novel-reward {\n  position: relative;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: var(--space-2);\n  height: 40px;\n  padding: 0 var(--space-6);\n  border: none;\n  border-radius: var(--radius-lg);\n  font-family: var(--font-sans);\n  font-size: var(--font-size-body);\n  font-weight: var(--font-weight-semibold);\n  color: var(--color-text-inverse);\n  cursor: pointer;\n  overflow: visible;\n  transition: box-shadow var(--dur-fast) var(--ease-standard),\n    filter var(--dur-fast) var(--ease-standard),\n    transform var(--dur-fast) var(--ease-standard),\n    background var(--dur-fast) var(--ease-standard),\n    color var(--dur-fast) var(--ease-standard);\n}\n\n/* 月票 / 打赏：rose 渐变 */\n.novel-reward--gradient {\n  background: var(--color-rose-gradient);\n}\n/* 推荐票：rose 实色 */\n.novel-reward--solid {\n  background: var(--color-rose);\n}\n\n/* hover：渐变提亮 + sh-2 */\n.novel-reward:not(.is-disabled):not(:disabled):hover {\n  filter: brightness(1.08);\n  box-shadow: var(--sh-2);\n}\n/* active：spring 弹性缩放 0.92→1 */\n.novel-reward:not(.is-disabled):not(:disabled):active {\n  transform: scale(0.92);\n  transition: transform var(--dur-instant) var(--ease-standard);\n}\n.novel-reward:focus-visible {\n  outline: none;\n  box-shadow: 0 0 0 2px var(--color-brand-bg), var(--sh-2);\n}\n\n/* 次数用尽：subtle 底 + tertiary 文字 */\n.novel-reward.is-disabled {\n  background: var(--color-bg-subtle);\n  color: var(--color-text-tertiary);\n  cursor: not-allowed;\n}\n\n/* loading 态：微弱透明 + 进度光标 */\n.novel-reward.is-loading {\n  cursor: progress;\n  opacity: 0.85;\n}\n\n.novel-reward__icon {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  line-height: 1;\n}\n\n/* spinner 替换图标 */\n.novel-reward__spinner {\n  display: inline-block;\n  width: 16px;\n  height: 16px;\n  border: 2px solid var(--color-text-inverse);\n  border-top-color: transparent;\n  border-radius: var(--radius-full);\n  animation: novel-reward-spin var(--dur-normal) linear infinite;\n}\n@keyframes novel-reward-spin {\n  to {\n    transform: rotate(360deg);\n  }\n}\n\n/* ---------- 剩余次数 ---------- */\n.novel-reward__remaining {\n  font-family: var(--font-mono);\n  font-size: var(--font-size-overline);\n  color: var(--color-text-tertiary);\n}\n\n/* ---------- 粒子飞出（rose 小圆点向上飞出淡出） ---------- */\n.novel-reward__particles {\n  position: absolute;\n  inset: 0;\n  pointer-events: none;\n  overflow: visible;\n}\n.novel-reward__particle {\n  position: absolute;\n  left: 50%;\n  top: 50%;\n  width: 6px;\n  height: 6px;\n  margin-left: -3px;\n  margin-top: -3px;\n  border-radius: var(--radius-full);\n  background: var(--color-rose);\n  opacity: 0;\n  animation: novel-reward-particle var(--dur-slow) var(--ease-standard) forwards;\n  animation-delay: calc(var(--i, 0) * 30ms);\n}\n@keyframes novel-reward-particle {\n  0% {\n    transform: translate(0, 0) scale(1);\n    opacity: 1;\n  }\n  100% {\n    transform: translate(calc((var(--i, 0) - 2.5) * 8px), -40px) scale(0.2);\n    opacity: 0;\n  }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .novel-reward__particle,\n  .novel-reward__spinner {\n    animation: none;\n  }\n}\n\n/* ============================================================\n * BookRecommend · P6 §5\n * 横滑卡：scroll-snap x mandatory；隐藏滚动条；换一批旋转 360\n * ============================================================ */\n\n.novel-recommend {\n  font-family: var(--font-sans);\n}\n\n/* ---------- 标题行 ---------- */\n.novel-recommend__head {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  padding: 0 var(--space-4);\n  margin-bottom: var(--space-3);\n}\n\n.novel-recommend__title {\n  margin: 0;\n  font-family: var(--font-sans);\n  font-size: var(--font-size-body);\n  font-weight: var(--font-weight-bold);\n  color: var(--color-text-primary);\n}\n\n.novel-recommend__refresh {\n  display: inline-flex;\n  align-items: center;\n  gap: var(--space-1);\n  padding: var(--space-1) var(--space-2);\n  border: none;\n  background: transparent;\n  font-family: var(--font-sans);\n  font-size: var(--font-size-caption);\n  color: var(--color-text-secondary);\n  cursor: pointer;\n  border-radius: var(--radius-sm);\n  transition: color var(--dur-fast) var(--ease-standard),\n    background var(--dur-fast) var(--ease-standard);\n}\n.novel-recommend__refresh:hover {\n  color: var(--color-text-primary);\n  background: var(--color-bg-subtle);\n}\n.novel-recommend__refresh:focus-visible {\n  outline: none;\n  box-shadow: 0 0 0 2px var(--color-brand-bg);\n}\n\n/* 换一批图标：点击旋转 360deg */\n.novel-recommend__refresh-icon.is-spinning {\n  animation: novel-recommend-spin var(--dur-fast) var(--ease-standard);\n}\n@keyframes novel-recommend-spin {\n  from {\n    transform: rotate(0deg);\n  }\n  to {\n    transform: rotate(360deg);\n  }\n}\n\n/* ---------- 横滑容器 ---------- */\n.novel-recommend__scroll {\n  display: flex;\n  gap: var(--space-3);\n  overflow-x: auto;\n  scroll-snap-type: x mandatory;\n  padding: var(--space-2) var(--space-4);\n  scrollbar-width: none;\n}\n.novel-recommend__scroll::-webkit-scrollbar {\n  display: none;\n}\n\n/* ---------- 单张书卡 ---------- */\n.novel-recommend__card {\n  flex-shrink: 0;\n  width: 100px;\n  scroll-snap-align: start;\n  display: flex;\n  flex-direction: column;\n  gap: var(--space-1);\n}\n.novel-recommend__card.is-clickable {\n  cursor: pointer;\n}\n.novel-recommend__card.is-clickable:focus-visible {\n  outline: none;\n  border-radius: var(--radius-md);\n  box-shadow: 0 0 0 2px var(--color-brand-bg);\n}\n\n/* 封面 100×133 (3:4) */\n.novel-recommend__cover {\n  position: relative;\n  width: 100px;\n  aspect-ratio: 3 / 4;\n  border-radius: var(--radius-md);\n  overflow: hidden;\n  background: var(--color-bg-subtle);\n}\n.novel-recommend__cover img {\n  width: 100%;\n  height: 100%;\n  -o-object-fit: cover;\n     object-fit: cover;\n  display: block;\n  transition: transform var(--dur-fast) var(--ease-standard);\n}\n.novel-recommend__card.is-clickable:hover .novel-recommend__cover img {\n  transform: scale(1.04);\n}\n\n.novel-recommend__cover-fallback {\n  width: 100%;\n  height: 100%;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  background: var(--color-brand-bg);\n  color: var(--color-brand);\n  font-family: var(--font-serif);\n  font-size: var(--font-size-h2);\n  font-weight: var(--font-weight-semibold);\n}\n\n/* 匹配度标签：暖橙文字 + 暖橙底 */\n.novel-recommend__match {\n  position: absolute;\n  left: var(--space-1);\n  bottom: var(--space-1);\n  padding: 1px var(--space-1);\n  border-radius: var(--radius-sm);\n  background: var(--color-accent-orange-bg);\n  color: var(--color-accent-orange);\n  font-family: var(--font-sans);\n  font-size: var(--font-size-overline);\n  font-weight: var(--font-weight-medium);\n  line-height: 14px;\n}\n\n/* 书名：单行省略 */\n.novel-recommend__name {\n  font-family: var(--font-serif);\n  font-size: var(--font-size-caption);\n  color: var(--color-text-primary);\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n/* 评分 */\n.novel-recommend__rating {\n  display: inline-flex;\n  align-items: center;\n  gap: 2px;\n  font-family: var(--font-mono);\n  font-size: var(--font-size-overline);\n  color: var(--color-text-tertiary);\n}\n.novel-recommend__star {\n  color: var(--color-accent-orange);\n  line-height: 1;\n}\n\n/* ---------- 骨架屏 ---------- */\n.novel-recommend__card.is-skeleton {\n  pointer-events: none;\n}\n.novel-recommend__cover--skeleton {\n  background: linear-gradient(\n    90deg,\n    var(--color-bg-subtle) 0%,\n    var(--color-bg-elevated) 50%,\n    var(--color-bg-subtle) 100%\n  );\n  background-size: 200% 100%;\n  animation: novel-skeleton-shimmer var(--dur-slow) var(--ease-standard) infinite;\n}\n.novel-recommend__skeleton-line {\n  border-radius: var(--radius-sm);\n  background: linear-gradient(\n    90deg,\n    var(--color-bg-subtle) 0%,\n    var(--color-bg-elevated) 50%,\n    var(--color-bg-subtle) 100%\n  );\n  background-size: 200% 100%;\n  animation: novel-skeleton-shimmer var(--dur-slow) var(--ease-standard) infinite;\n}\n.novel-recommend__skeleton-line--name {\n  height: 12px;\n  width: 90%;\n}\n.novel-recommend__skeleton-line--rating {\n  height: 10px;\n  width: 50%;\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .novel-recommend__refresh-icon.is-spinning,\n  .novel-recommend__cover--skeleton,\n  .novel-recommend__skeleton-line {\n    animation: none;\n  }\n}\n\n/* ============================================================\n * StatCard · 统计卡片样式\n * ============================================================ */\n\n.stat-card {\n  display: flex;\n  flex-direction: column;\n  gap: 4px;\n}\n\n.stat-card__value {\n  font-size: var(--font-size-h2);\n  font-weight: var(--font-weight-bold);\n  color: var(--color-accent-orange);\n  line-height: var(--line-height-tighter);\n  letter-spacing: var(--letter-spacing-tight);\n  font-variant-numeric: tabular-nums;\n}\n\n.stat-card__value--mono {\n  font-family: var(--font-mono);\n}\n\n.stat-card__label {\n  font-size: var(--font-size-xs);\n  letter-spacing: var(--letter-spacing-caption);\n  text-transform: uppercase;\n  line-height: var(--line-height-snug);\n  color: var(--color-text-tertiary);\n  font-weight: var(--font-weight-emphasis);\n}\n\n/* ---------- 细节边缘 ---------- */\n\n/* 数值渐变过渡：数据刷新时平滑，避免数字跳变生硬 */\n.stat-card__value {\n  transition: opacity var(--dur-normal) var(--ease-standard);\n}\n.stat-card__value.is-updating {\n  opacity: 0.4;\n}\n\n/* 长数值：收紧字距保持一行可读 */\n.stat-card__value--mono {\n  font-feature-settings: 'tnum';\n  letter-spacing: -0.02em;\n}\n\n/* 进入动画 */\n.stat-card.is-enter {\n  animation: stat-card-enter var(--dur-normal) var(--ease-decelerate) both;\n}\n\n@keyframes stat-card-enter {\n  from {\n    opacity: 0;\n    transform: translateY(8px);\n  }\n  to {\n    opacity: 1;\n    transform: translateY(0);\n  }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .stat-card.is-enter {\n    animation: none;\n  }\n  .stat-card__value {\n    transition: none;\n  }\n}\n*, ::before, ::after {\n  --tw-border-spacing-x: 0;\n  --tw-border-spacing-y: 0;\n  --tw-translate-x: 0;\n  --tw-translate-y: 0;\n  --tw-rotate: 0;\n  --tw-skew-x: 0;\n  --tw-skew-y: 0;\n  --tw-scale-x: 1;\n  --tw-scale-y: 1;\n  --tw-pan-x:  ;\n  --tw-pan-y:  ;\n  --tw-pinch-zoom:  ;\n  --tw-scroll-snap-strictness: proximity;\n  --tw-gradient-from-position:  ;\n  --tw-gradient-via-position:  ;\n  --tw-gradient-to-position:  ;\n  --tw-ordinal:  ;\n  --tw-slashed-zero:  ;\n  --tw-numeric-figure:  ;\n  --tw-numeric-spacing:  ;\n  --tw-numeric-fraction:  ;\n  --tw-ring-inset:  ;\n  --tw-ring-offset-width: 0px;\n  --tw-ring-offset-color: #fff;\n  --tw-ring-color: rgb(59 130 246 / 0.5);\n  --tw-ring-offset-shadow: 0 0 #0000;\n  --tw-ring-shadow: 0 0 #0000;\n  --tw-shadow: 0 0 #0000;\n  --tw-shadow-colored: 0 0 #0000;\n  --tw-blur:  ;\n  --tw-brightness:  ;\n  --tw-contrast:  ;\n  --tw-grayscale:  ;\n  --tw-hue-rotate:  ;\n  --tw-invert:  ;\n  --tw-saturate:  ;\n  --tw-sepia:  ;\n  --tw-drop-shadow:  ;\n  --tw-backdrop-blur:  ;\n  --tw-backdrop-brightness:  ;\n  --tw-backdrop-contrast:  ;\n  --tw-backdrop-grayscale:  ;\n  --tw-backdrop-hue-rotate:  ;\n  --tw-backdrop-invert:  ;\n  --tw-backdrop-opacity:  ;\n  --tw-backdrop-saturate:  ;\n  --tw-backdrop-sepia:  ;\n  --tw-contain-size:  ;\n  --tw-contain-layout:  ;\n  --tw-contain-paint:  ;\n  --tw-contain-style:  ;\n}\n::backdrop {\n  --tw-border-spacing-x: 0;\n  --tw-border-spacing-y: 0;\n  --tw-translate-x: 0;\n  --tw-translate-y: 0;\n  --tw-rotate: 0;\n  --tw-skew-x: 0;\n  --tw-skew-y: 0;\n  --tw-scale-x: 1;\n  --tw-scale-y: 1;\n  --tw-pan-x:  ;\n  --tw-pan-y:  ;\n  --tw-pinch-zoom:  ;\n  --tw-scroll-snap-strictness: proximity;\n  --tw-gradient-from-position:  ;\n  --tw-gradient-via-position:  ;\n  --tw-gradient-to-position:  ;\n  --tw-ordinal:  ;\n  --tw-slashed-zero:  ;\n  --tw-numeric-figure:  ;\n  --tw-numeric-spacing:  ;\n  --tw-numeric-fraction:  ;\n  --tw-ring-inset:  ;\n  --tw-ring-offset-width: 0px;\n  --tw-ring-offset-color: #fff;\n  --tw-ring-color: rgb(59 130 246 / 0.5);\n  --tw-ring-offset-shadow: 0 0 #0000;\n  --tw-ring-shadow: 0 0 #0000;\n  --tw-shadow: 0 0 #0000;\n  --tw-shadow-colored: 0 0 #0000;\n  --tw-blur:  ;\n  --tw-brightness:  ;\n  --tw-contrast:  ;\n  --tw-grayscale:  ;\n  --tw-hue-rotate:  ;\n  --tw-invert:  ;\n  --tw-saturate:  ;\n  --tw-sepia:  ;\n  --tw-drop-shadow:  ;\n  --tw-backdrop-blur:  ;\n  --tw-backdrop-brightness:  ;\n  --tw-backdrop-contrast:  ;\n  --tw-backdrop-grayscale:  ;\n  --tw-backdrop-hue-rotate:  ;\n  --tw-backdrop-invert:  ;\n  --tw-backdrop-opacity:  ;\n  --tw-backdrop-saturate:  ;\n  --tw-backdrop-sepia:  ;\n  --tw-contain-size:  ;\n  --tw-contain-layout:  ;\n  --tw-contain-paint:  ;\n  --tw-contain-style:  ;\n}\n/* ! tailwindcss v3.4.19 | MIT License | https://tailwindcss.com *//*\n1. Prevent padding and border from affecting element width. (https://github.com/mozdevs/cssremedy/issues/4)\n2. Allow adding a border to an element by just adding a border-width. (https://github.com/tailwindcss/tailwindcss/pull/116)\n*/\n\n*,\n::before,\n::after {\n  box-sizing: border-box; /* 1 */\n  border-width: 0; /* 2 */\n  border-style: solid; /* 2 */\n  border-color: #e5e7eb; /* 2 */\n}\n\n::before,\n::after {\n  --tw-content: '';\n}\n\n/*\n1. Use a consistent sensible line-height in all browsers.\n2. Prevent adjustments of font size after orientation changes in iOS.\n3. Use a more readable tab size.\n4. Use the user's configured `sans` font-family by default.\n5. Use the user's configured `sans` font-feature-settings by default.\n6. Use the user's configured `sans` font-variation-settings by default.\n7. Disable tap highlights on iOS\n*/\n\nhtml,\n:host {\n  line-height: 1.5; /* 1 */\n  -webkit-text-size-adjust: 100%; /* 2 */\n  -moz-tab-size: 4; /* 3 */\n  -o-tab-size: 4;\n     tab-size: 4; /* 3 */\n  font-family: var(--font-sans); /* 4 */\n  font-feature-settings: normal; /* 5 */\n  font-variation-settings: normal; /* 6 */\n  -webkit-tap-highlight-color: transparent; /* 7 */\n}\n\n/*\n1. Remove the margin in all browsers.\n2. Inherit line-height from `html` so users can set them as a class directly on the `html` element.\n*/\n\nbody {\n  margin: 0; /* 1 */\n  line-height: inherit; /* 2 */\n}\n\n/*\n1. Add the correct height in Firefox.\n2. Correct the inheritance of border color in Firefox. (https://bugzilla.mozilla.org/show_bug.cgi?id=190655)\n3. Ensure horizontal rules are visible by default.\n*/\n\nhr {\n  height: 0; /* 1 */\n  color: inherit; /* 2 */\n  border-top-width: 1px; /* 3 */\n}\n\n/*\nAdd the correct text decoration in Chrome, Edge, and Safari.\n*/\n\nabbr:where([title]) {\n  -webkit-text-decoration: underline dotted;\n          text-decoration: underline dotted;\n}\n\n/*\nRemove the default font size and weight for headings.\n*/\n\nh1,\nh2,\nh3,\nh4,\nh5,\nh6 {\n  font-size: inherit;\n  font-weight: inherit;\n}\n\n/*\nReset links to optimize for opt-in styling instead of opt-out.\n*/\n\na {\n  color: inherit;\n  text-decoration: inherit;\n}\n\n/*\nAdd the correct font weight in Edge and Safari.\n*/\n\nb,\nstrong {\n  font-weight: bolder;\n}\n\n/*\n1. Use the user's configured `mono` font-family by default.\n2. Use the user's configured `mono` font-feature-settings by default.\n3. Use the user's configured `mono` font-variation-settings by default.\n4. Correct the odd `em` font sizing in all browsers.\n*/\n\ncode,\nkbd,\nsamp,\npre {\n  font-family: var(--font-mono); /* 1 */\n  font-feature-settings: normal; /* 2 */\n  font-variation-settings: normal; /* 3 */\n  font-size: 1em; /* 4 */\n}\n\n/*\nAdd the correct font size in all browsers.\n*/\n\nsmall {\n  font-size: 80%;\n}\n\n/*\nPrevent `sub` and `sup` elements from affecting the line height in all browsers.\n*/\n\nsub,\nsup {\n  font-size: 75%;\n  line-height: 0;\n  position: relative;\n  vertical-align: baseline;\n}\n\nsub {\n  bottom: -0.25em;\n}\n\nsup {\n  top: -0.5em;\n}\n\n/*\n1. Remove text indentation from table contents in Chrome and Safari. (https://bugs.chromium.org/p/chromium/issues/detail?id=999088, https://bugs.webkit.org/show_bug.cgi?id=201297)\n2. Correct table border color inheritance in all Chrome and Safari. (https://bugs.chromium.org/p/chromium/issues/detail?id=935729, https://bugs.webkit.org/show_bug.cgi?id=195016)\n3. Remove gaps between table borders by default.\n*/\n\ntable {\n  text-indent: 0; /* 1 */\n  border-color: inherit; /* 2 */\n  border