m, 30px);\n  line-height: var(--line-height-tight);\n  letter-spacing: var(--letter-spacing-tight);\n}\nh3 {\n  font-size: clamp(18px, 1.5vw + 0.5rem, 22px);\n  line-height: var(--line-height-snug);\n  letter-spacing: var(--letter-spacing-normal);\n  font-weight: var(--font-weight-bold);\n}\nh4 {\n  font-size: var(--font-size-h4);\n  line-height: var(--line-height-snug);\n  letter-spacing: var(--letter-spacing-normal);\n  font-weight: var(--font-weight-semibold);\n}\nh5 {\n  font-size: var(--font-size-body);\n  line-height: var(--line-height-snug);\n  font-weight: var(--font-weight-semibold);\n}\nh6 {\n  font-size: var(--font-size-small);\n  line-height: var(--line-height-snug);\n  font-weight: var(--font-weight-semibold);\n  color: var(--color-text-secondary);\n}\n\np {\n  margin: 0 0 var(--space-3);\n  text-wrap: pretty;\n  orphans: 3;\n  widows: 3;\n}\n\n/* ---------- 正文容器：最佳阅读宽度 ---------- */\n.prose {\n  max-width: 65ch;\n  font-size: var(--font-size-prose);\n  line-height: var(--line-height-prose);\n  color: var(--color-text-primary);\n}\n.prose-lg {\n  max-width: 65ch;\n  font-size: var(--font-size-prose-lg);\n  line-height: var(--line-height-prose);\n  color: var(--color-text-primary);\n}\n\n/* ---------- 排版工具类 ---------- */\n.text-eyebrow {\n  font-size: var(--font-size-eyebrow);\n  font-weight: var(--font-weight-emphasis);\n  letter-spacing: var(--letter-spacing-eyebrow);\n  text-transform: uppercase;\n  color: var(--color-text-tertiary);\n}\n.text-label {\n  font-size: var(--font-size-label);\n  font-weight: var(--font-weight-label);\n  letter-spacing: var(--letter-spacing-caption);\n  color: var(--color-text-secondary);\n}\n.text-display {\n  font-size: var(--font-size-display);\n  font-weight: var(--font-weight-extrabold);\n  line-height: var(--line-height-display);\n  letter-spacing: var(--letter-spacing-display);\n  color: var(--color-text-primary);\n}\n.text-balance {\n  text-wrap: balance;\n}\n.text-pretty {\n  text-wrap: pretty;\n}\n.text-no-wrap {\n  white-space: nowrap;\n}\n\na {\n  color: var(--color-text-link);\n  text-decoration: none;\n  transition: color var(--transition-smooth);\n}\na:hover {\n  color: var(--color-text-link-hover);\n}\n\n* {\n  box-sizing: border-box;\n}\n\nbutton {\n  font-family: inherit;\n  cursor: pointer;\n}\n\nimg {\n  display: block;\n  max-width: 100%;\n}\n\n.skip-link {\n  position: absolute;\n  left: -9999px;\n  top: 0;\n  z-index: var(--z-index-toast);\n  padding: var(--space-2) var(--space-4);\n  background: var(--color-bg-surface);\n  color: var(--color-text-primary);\n  border-radius: var(--radius-md);\n  box-shadow: var(--sh-3);\n}\n.skip-link:focus {\n  left: var(--space-4);\n  top: var(--space-4);\n}\n\n.container-page {\n  width: 100%;\n  max-width: 1200px;\n  margin: 0 auto;\n  padding: 0 var(--space-4);\n}\n@media (min-width: 768px) {\n  .container-page {\n    padding: 0 var(--space-6);\n  }\n}\n@media (min-width: 1280px) {\n  .container-page {\n    padding: 0 var(--space-8);\n  }\n}\n\n.scroll-x {\n  overflow-x: auto;\n  scrollbar-width: none;\n  -webkit-overflow-scrolling: touch;\n}\n.scroll-x::-webkit-scrollbar {\n  display: none;\n}\n\n/* ---------- 通用布局工具类（抽象高频重复模式） ---------- */\n.flex-center {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n.flex-between {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n}\n.flex-col {\n  display: flex;\n  flex-direction: column;\n}\n.flex-col-center {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n}\n.ellipsis {\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n.ellipsis-2 {\n  display: -webkit-box;\n  -webkit-line-clamp: 2;\n  -webkit-box-orient: vertical;\n  overflow: hidden;\n}\n.truncate-single {\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n/* ---------- 卡片悬浮效果 ---------- */\n.card-hover {\n  transition:\n    transform var(--dur-fast) var(--ease-standard),\n    box-shadow var(--dur-fast) var(--ease-standard);\n}\n.card-hover:hover {\n  transform: translateY(-2px);\n  box-shadow: var(--sh-3);\n}\n\n/* ---------- 按钮按压效果 ---------- */\n.btn-press {\n  transition: transform var(--dur-instant) var(--ease-standard);\n}\n.btn-press:active:not(:disabled) {\n  transform: scale(0.97);\n}\n\n/* ---------- 统计数字等宽 ---------- */\n.num-tabular {\n  font-variant-numeric: tabular-nums;\n}\n\n/* ---------- 列表行悬浮高亮 ---------- */\n.row-hover {\n  transition: background var(--dur-fast) var(--ease-standard);\n}\n.row-hover:hover {\n  background: var(--color-bg-subtle);\n}\n\n.hover-rise {\n  transition:\n    transform var(--transition-smooth),\n    box-shadow var(--transition-smooth);\n}\n.hover-rise:hover {\n  transform: translateY(-2px);\n  box-shadow: var(--sh-3);\n}\n\n@keyframes fadeIn {\n  from {\n    opacity: 0;\n    transform: translateY(8px);\n  }\n  to {\n    opacity: 1;\n    transform: translateY(0);\n  }\n}\n\n@keyframes slideIn {\n  from {\n    opacity: 0;\n    transform: translateX(-12px);\n  }\n  to {\n    opacity: 1;\n    transform: translateX(0);\n  }\n}\n\n@keyframes scaleIn {\n  from {\n    opacity: 0;\n    transform: scale(0.95);\n  }\n  to {\n    opacity: 1;\n    transform: scale(1);\n  }\n}\n\n/* ============================================\n * 页面级过渡（淡入 + 上移）\n * ============================================ */\n@keyframes pageFadeIn {\n  from {\n    opacity: 0;\n    transform: translateY(12px);\n  }\n  to {\n    opacity: 1;\n    transform: translateY(0);\n  }\n}\n\n/* ============================================\n * 交错入场（列表项逐条进入）\n * ============================================ */\n@keyframes staggerEnter {\n  from {\n    opacity: 0;\n    transform: translateY(16px);\n  }\n  to {\n    opacity: 1;\n    transform: translateY(0);\n  }\n}\n\n/* ============================================\n * 弹性按压效果（按钮/卡片）\n * ============================================ */\n@keyframes springPress {\n  0% { transform: scale(1); }\n  40% { transform: scale(0.96); }\n  70% { transform: scale(0.98); }\n  100% { transform: scale(1); }\n}\n\n/* ============================================\n * 光泽扫过（卡片装饰）\n * ============================================ */\n@keyframes shineSweep {\n  0% { transform: translateX(-100%); }\n  100% { transform: translateX(100%); }\n}\n\n.fade-in {\n  animation: fadeIn 300ms ease-out both;\n}\n\n.slide-in {\n  animation: slideIn 300ms ease-out both;\n}\n\n.scale-in {\n  animation: scaleIn 200ms ease-out both;\n}\n\n/** 页面级淡入 */\n.page-fade-in {\n  animation: pageFadeIn 300ms var(--ease-decelerate) both;\n}\n\n/** 交错入场：每项偏移 50ms */\n.stagger-enter {\n  animation: staggerEnter 400ms var(--ease-decelerate) both;\n}\n\n.stagger-enter:nth-child(1) { animation-delay: 0ms; }\n.stagger-enter:nth-child(2) { animation-delay: 50ms; }\n.stagger-enter:nth-child(3) { animation-delay: 100ms; }\n.stagger-enter:nth-child(4) { animation-delay: 150ms; }\n.stagger-enter:nth-child(5) { animation-delay: 200ms; }\n.stagger-enter:nth-child(6) { animation-delay: 250ms; }\n.stagger-enter:nth-child(7) { animation-delay: 300ms; }\n.stagger-enter:nth-child(8) { animation-delay: 350ms; }\n.stagger-enter:nth-child(9) { animation-delay: 400ms; }\n.stagger-enter:nth-child(10) { animation-delay: 450ms; }\n\n/** 弹性按压 */\n.spring-press {\n  transition: transform var(--dur-instant) var(--ease-spring);\n  cursor: pointer;\n  -webkit-tap-highlight-color: transparent;\n}\n\n.spring-press:active:not(:disabled) {\n  transform: scale(0.96);\n}\n\n/** 光泽扫过装饰 */\n.shine-sweep {\n  position: relative;\n  overflow: hidden;\n}\n\n.shine-sweep::after {\n  content: '';\n  position: absolute;\n  inset: 0;\n  background: linear-gradient(\n    90deg,\n    transparent 0%,\n    var(--color-overlay-white-10) 50%,\n    transparent 100%\n  );\n  transform: translateX(-100%);\n  transition: transform 0.6s ease;\n  pointer-events: none;\n}\n\n.shine-sweep:hover::after {\n  transform: translateX(100%);\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .hover-rise:hover {\n    transform: none;\n  }\n  .page-fade-in,\n  .stagger-enter,\n  .spring-press,\n  .shine-sweep,\n  *,\n  *::before,\n  *::after {\n    animation-duration: 0.01ms !important;\n    animation-iteration-count: 1 !important;\n    transition-duration: 0.01ms !important;\n    scroll-behavior: auto !important;\n  }\n}\n\n@media (max-width: 768px) and (pointer: coarse) {\n  .novel-navbar__search-btn,\n  .novel-navbar__login-btn,\n  .novel-reader__icon-btn,\n  .novel-reader__bar-btn {\n    min-height: 44px;\n    min-width: 44px;\n  }\n}\n\n.app-layout {\n  min-height: 100vh;\n  display: flex;\n  flex-direction: column;\n}\n.app-layout__main {\n  flex: 1;\n}\n@media (max-width: 768px) {\n  .app-layout__main {\n    padding-bottom: calc(48px + env(safe-area-inset-bottom, 0px));\n  }\n  .novel-footer {\n    display: none;\n  }\n  .novel-navbar {\n    padding-top: env(safe-area-inset-top, 0px);\n  }\n}\n\na:focus-visible,\nbutton:focus-visible,\ninput:focus-visible,\nselect:focus-visible,\ntextarea:focus-visible,\n[tabindex]:focus-visible {\n  outline: 2px solid var(--color-brand);\n  outline-offset: 2px;\n  border-radius: var(--radius-sm);\n}\n\n.novel-reader__tap-zone:focus-visible {\n  outline: none;\n}\n\n@media (prefers-contrast: more) {\n  :root {\n    --color-border-subtle: var(--color-border-default);\n    --font-weight-body: var(--font-weight-emphasis);\n  }\n  body {\n    background: var(--color-bg-surface);\n    color: var(--color-text-primary);\n  }\n  a,\n  a:hover {\n    text-decoration: underline;\n  }\n  .novel-navbar,\n  .novel-footer {\n    border-color: var(--color-text-primary);\n  }\n  .novel-reader__article-body p {\n    text-shadow: none;\n  }\n}\n\n.sr-only {\n  position: absolute;\n  width: 1px;\n  height: 1px;\n  padding: 0;\n  margin: -1px;\n  overflow: hidden;\n  clip: rect(0, 0, 0, 0);\n  white-space: nowrap;\n  border: 0;\n}\n\n.sr-only-focusable:focus,\n.sr-only-focusable:focus-visible {\n  position: static;\n  width: auto;\n  height: auto;\n  overflow: visible;\n  clip: auto;\n  white-space: normal;\n}\n\n/* ============================================================\n * 细节边缘体验 · Edge Cases\n * ============================================================ */\n\n/* ---------- 长文本换行：URL/长英文单词不撑破布局 ---------- */\np,\nli,\ndd,\nblockquote {\n  overflow-wrap: break-word;\n}\n\n/* ---------- 图片边缘 ---------- */\n/* 加载中的图片保持占位背景，避免白闪 */\nimg {\n  background-color: var(--color-bg-subtle);\n}\n/* 深色模式下降低过亮图片的刺眼感 */\n[data-theme='dark'] img {\n  filter: brightness(0.9) contrast(1.05);\n}\n[data-theme='dark'] img.novel-img--full-bright {\n  filter: none;\n}\n/* 加载失败：显示 alt 文字（居中灰色） */\nimg[alt]:not([alt='']) {\n  font-size: var(--font-size-caption);\n  color: var(--color-text-tertiary);\n  text-align: center;\n  -o-object-fit: contain;\n     object-fit: contain;\n  padding: var(--space-1);\n}\n\n/* ---------- 触屏 hover 粘滞修复 ---------- */\n/* 触屏设备上取消 hover 悬浮效果，避免点击后状态残留 */\n@media (hover: none) {\n  .card-hover:hover,\n  .hover-rise:hover,\n  .row-hover:hover {\n    transform: none;\n    box-shadow: none;\n    background: none;\n  }\n}\n\n/* ---------- iOS 橡皮筋 / 过度滚动控制 ---------- */\nhtml,\nbody {\n  overscroll-behavior-y: none;\n}\n.novel-reader__content {\n  overscroll-behavior-y: contain;\n}\n\n/* ---------- 滚动锚定：sticky 顶栏不遮挡锚点目标 ---------- */\n[id] {\n  scroll-margin-top: calc(var(--reader-toolbar-height, 56px) + var(--space-4));\n}\n\n/* ---------- 文本渲染优化 ---------- */\nbody {\n  text-rendering: optimizeLegibility;\n  -webkit-font-smoothing: antialiased;\n}\n\n/* ---------- 数字输入 spinner 隐藏（全局兜底） ---------- */\ninput[type='number']::-webkit-outer-spin-button,\ninput[type='number']::-webkit-inner-spin-button {\n  -webkit-appearance: none;\n  margin: 0;\n}\ninput[type='number'] {\n  -moz-appearance: textfield;\n  -webkit-appearance: textfield;\n          appearance: textfield;\n}\n\n/* ---------- 搜索框清除按钮（WebKit 原生） ---------- */\ninput[type='search']::-webkit-search-cancel-button {\n  -webkit-appearance: none;\n  appearance: none;\n}\n\n/* ---------- 表单禁用 placeholder ---------- */\ninput:disabled::-moz-placeholder, textarea:disabled::-moz-placeholder {\n  color: var(--color-text-disabled);\n}\ninput:disabled::placeholder,\ntextarea:disabled::placeholder {\n  color: var(--color-text-disabled);\n}\n\n/* ---------- 移动端文本选择菜单 / 长按 ---------- */\nbutton,\na {\n  -webkit-tap-highlight-color: transparent;\n}\nimg {\n  -webkit-user-drag: none;\n}\n\n/* ---------- 页面滚动条美化（桌面） ---------- */\n@media (hover: hover) and (pointer: fine) {\n  ::-webkit-scrollbar {\n    width: 8px;\n    height: 8px;\n  }\n  ::-webkit-scrollbar-track {\n    background: transparent;\n  }\n  ::-webkit-scrollbar-thumb {\n    background: var(--color-border-default);\n    border-radius: var(--radius-full);\n    border: 2px solid transparent;\n    background-clip: padding-box;\n  }\n  ::-webkit-scrollbar-thumb:hover {\n    background: var(--color-border-strong);\n    background-clip: padding-box;\n  }\n  html {\n    scrollbar-width: thin;\n    scrollbar-color: var(--color-border-default) transparent;\n  }\n}\n\n/* ---------- 平滑滚动（仅非减弱动效） ---------- */\n@media (prefers-reduced-motion: no-preference) {\n  html {\n    scroll-behavior: smooth;\n  }\n}\n\n/* ---------- 隐藏滚动条的横向滚动容器 ---------- */\n.scroll-x {\n  scrollbar-width: none;\n}\n"]],"\n  ",["BODY",{},"\n    ",["DIV",{"id":"root"},["DIV",{"class":"app-layout"},["A",{"href":"#main-content","class":"skip-link"},"跳到主内容"],["HEADER",{"class":"novel-navbar","role":"banner"},["DIV",{"class":"novel-navbar__inner container-page"},["A",{"class":"novel-navbar__logo","aria-label":"Atlas 小说阅读 首页","href":"/"},["SPAN",{"class":"novel-navbar__logo-mark","aria-hidden":"true"},"A"],["SPAN",{"class":"novel-navbar__logo-text"},"Atlas"]],["NAV",{"class":"novel-navbar__nav","aria-label":"主导航"},["A",{"class":"novel-navbar__nav-link","href":"/"},"首页"],["DIV",{"style":"display: inline-flex;"},["DIV",{"style":"display: inline-flex;"},["SPAN",{"style":"display: inline-flex;"},["A",{