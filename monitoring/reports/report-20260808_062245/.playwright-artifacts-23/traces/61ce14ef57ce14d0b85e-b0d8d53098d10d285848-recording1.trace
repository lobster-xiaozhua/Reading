css-dev-only-do-not-override-v90ahe).ant-spin .ant-spin-dot-item:nth-child(3){inset-inline-end:0;bottom:0;animation-delay:0.8s;}:where(.css-dev-only-do-not-override-v90ahe).ant-spin .ant-spin-dot-item:nth-child(4){bottom:0;inset-inline-start:0;animation-delay:1.2s;}:where(.css-dev-only-do-not-override-v90ahe).ant-spin .ant-spin-dot-spin{transform:rotate(45deg);animation-name:css-dev-only-do-not-override-v90ahe-antRotate;animation-duration:1.2s;animation-iteration-count:infinite;animation-timing-function:linear;}:where(.css-dev-only-do-not-override-v90ahe).ant-spin .ant-spin-dot-circle{stroke-linecap:round;transition:stroke-dashoffset 360ms ease,stroke-dasharray 360ms ease,stroke 360ms ease,stroke-width 360ms ease,opacity 360ms ease;fill-opacity:0;stroke:currentcolor;}:where(.css-dev-only-do-not-override-v90ahe).ant-spin .ant-spin-dot-circle-bg{stroke:#D3D3DA;}:where(.css-dev-only-do-not-override-v90ahe).ant-spin-sm .ant-spin-dot,:where(.css-dev-only-do-not-override-v90ahe).ant-spin-sm .ant-spin-dot-holder{font-size:14px;}:where(.css-dev-only-do-not-override-v90ahe).ant-spin-sm .ant-spin-dot-holder i{width:6px;height:6px;}:where(.css-dev-only-do-not-override-v90ahe).ant-spin-lg .ant-spin-dot,:where(.css-dev-only-do-not-override-v90ahe).ant-spin-lg .ant-spin-dot-holder{font-size:32px;}:where(.css-dev-only-do-not-override-v90ahe).ant-spin-lg .ant-spin-dot-holder i{width:14px;height:14px;}:where(.css-dev-only-do-not-override-v90ahe).ant-spin.ant-spin-show-text .ant-spin-text{display:block;}"],["STYLE",{},"@keyframes css-dev-only-do-not-override-v90ahe-antSpinMove{to{opacity:1;}}"],["STYLE",{},"@keyframes css-dev-only-do-not-override-v90ahe-antRotate{to{transform:rotate(405deg);}}"],[[2,6]],[[2,7]],[[2,8]],[[2,9]],[[2,10]],[[2,11]],[[2,12]],[[2,13]],[[2,14]],[[2,15]],[[2,16]],[[2,17]],[[2,18]],[[2,19]],[[2,20]],[[2,21]],[[2,23]],[[2,24]],[[2,25]],[[2,27]],[[2,28]],[[2,30]],[[2,32]],["STYLE",{},"/* ============================================================\n * LoginPage · B 端登录页（分屏品牌化重设计）\n * 左侧品牌展示区 + 右侧表单卡片\n * ============================================================ */\n\n@keyframes fadeInUp {\n  from {\n    opacity: 0;\n    transform: translateY(16px);\n  }\n  to {\n    opacity: 1;\n    transform: translateY(0);\n  }\n}\n\n@keyframes scaleIn {\n  from {\n    opacity: 0;\n    transform: scale(0.96);\n  }\n  to {\n    opacity: 1;\n    transform: scale(1);\n  }\n}\n\n@keyframes floatA {\n  0%, 100% {\n    transform: translate(0, 0) scale(1);\n  }\n  50% {\n    transform: translate(-14px, 16px) scale(1.05);\n  }\n}\n@keyframes floatB {\n  0%, 100% {\n    transform: translate(0, 0) scale(1);\n  }\n  50% {\n    transform: translate(16px, -12px) scale(1.08);\n  }\n}\n\n/* 页面级动画 */\n.login-page {\n  position: relative;\n  min-height: 100vh;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  background: linear-gradient(150deg, var(--color-bg-page) 0%, var(--color-brand-bg) 60%, var(--color-bg-surface) 100%);\n  overflow: hidden;\n  animation: fadeInUp var(--dur-normal) var(--ease-decelerate);\n  padding: var(--space-6);\n}\n\n/* 装饰光晕 */\n.login-orb {\n  position: absolute;\n  border-radius: var(--radius-full);\n  filter: blur(56px);\n  opacity: 0.45;\n  pointer-events: none;\n}\n.login-orb--a {\n  width: 360px;\n  height: 360px;\n  top: -100px;\n  right: 4%;\n  background: var(--gradient-brand-strong);\n  animation: floatA 14s var(--ease-smooth) infinite;\n}\n.login-orb--b {\n  width: 300px;\n  height: 300px;\n  bottom: -90px;\n  left: 8%;\n  background: var(--color-rose-gradient);\n  opacity: 0.3;\n  animation: floatB 16s var(--ease-smooth) infinite;\n}\n\n/* 左侧品牌区 */\n.login-brand {\n  position: relative;\n  z-index: 1;\n  display: none;\n  flex-direction: column;\n  align-items: flex-start;\n  gap: var(--space-3);\n  max-width: 380px;\n  padding: var(--space-4);\n  color: var(--color-text-primary);\n  animation: fadeInUp var(--dur-normal) var(--ease-decelerate) 100ms both;\n}\n.login-brand__badge {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  width: 56px;\n  height: 56px;\n  border-radius: var(--radius-xl);\n  background: linear-gradient(135deg, var(--color-brand), var(--color-accent));\n  color: var(--color-text-inverse);\n  font-size: 26px;\n  box-shadow: var(--sh-3), 0 0 28px var(--color-brand-glow-35);\n  margin-bottom: var(--space-2);\n}\n.login-brand__title {\n  margin: 0;\n  font-family: var(--font-serif);\n  font-size: 30px;\n  font-weight: var(--font-weight-bold);\n  letter-spacing: 0.02em;\n}\n.login-brand__desc {\n  margin: 0;\n  font-size: var(--font-size-small);\n  color: var(--color-text-secondary);\n  line-height: var(--line-height-relaxed);\n}\n.login-brand__features {\n  list-style: none;\n  margin: var(--space-4) 0 0;\n  padding: 0;\n  display: flex;\n  flex-direction: column;\n  gap: var(--space-3);\n}\n.login-brand__features li {\n  display: flex;\n  align-items: center;\n  gap: var(--space-3);\n  font-size: var(--font-size-small);\n  color: var(--color-text-secondary);\n}\n.login-brand__features .anticon {\n  color: var(--color-brand);\n  font-size: var(--font-size-body);\n}\n\n/* 右侧登录面板 */\n.login-panel {\n  position: relative;\n  z-index: 2;\n  width: 100%;\n  max-width: 400px;\n  animation: scaleIn var(--dur-normal) var(--ease-decelerate) 150ms both;\n}\n\n.login-card {\n  position: relative;\n  overflow: hidden;\n  border: 1px solid var(--color-border-subtle);\n  border-radius: var(--radius-2xl) !important;\n  box-shadow: var(--sh-4) !important;\n}\n.login-card::before {\n  content: \"\";\n  position: absolute;\n  top: 0;\n  left: 0;\n  right: 0;\n  height: 4px;\n  background: linear-gradient(to right, var(--color-brand), var(--color-accent), var(--color-rose));\n  border-radius: var(--radius-2xl) var(--radius-2xl) 0 0;\n  z-index: 1;\n}\n\n.login-card__header {\n  text-align: center;\n  margin-bottom: var(--space-6);\n}\n.login-card__title {\n  margin-bottom: var(--space-1) !important;\n}\n\n/* 演示账号列表 staggered 进入 */\n.login-card__demo {\n  margin-top: var(--space-6);\n  text-align: center;\n}\n.login-card__demo-label {\n  display: block;\n  font-size: 12px;\n  margin-bottom: var(--space-3);\n}\n.login-card__demo-list {\n  display: flex;\n  flex-direction: column;\n  gap: var(--space-1);\n}\n.login-card__demo-row {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: var(--space-2);\n  font-size: 12px;\n  color: var(--color-text-tertiary);\n}\n.login-card__demo-fill {\n  cursor: pointer;\n  font-size: 11px;\n  margin-inline-end: 0;\n}\n\n.login-page .demo-account-item {\n  animation: fadeInUp var(--dur-fast) var(--ease-decelerate) both;\n}\n.login-page .demo-account-item:nth-child(1) { animation-delay: 350ms; }\n.login-page .demo-account-item:nth-child(2) { animation-delay: 400ms; }\n.login-page .demo-account-item:nth-child(3) { animation-delay: 450ms; }\n.login-page .demo-account-item:nth-child(4) { animation-delay: 500ms; }\n\n.login-page .demo-account-item .ant-tag {\n  transition:\n    transform var(--dur-fast) var(--ease-standard),\n    box-shadow var(--dur-fast) var(--ease-standard);\n}\n.login-page .demo-account-item .ant-tag:hover {\n  transform: translateY(-1px);\n  box-shadow: 0 2px 8px var(--color-brand-bg);\n}\n.login-page .demo-account-item .ant-tag:active {\n  transform: scale(0.95);\n}\n\n/* 输入框聚焦提升 */\n.login-card .ant-input-affix-wrapper {\n  border-radius: var(--radius-md);\n  transition:\n    border-color var(--dur-fast) var(--ease-standard),\n    box-shadow var(--dur-fast) var(--ease-standard);\n}\n.login-card .ant-input-affix-wrapper-focused {\n  box-shadow: 0 0 0 3px var(--color-brand-bg);\n}\n\n/* 提交按钮品牌渐变 */\n.login-card .ant-btn-primary {\n  background: linear-gradient(to right, var(--color-brand), var(--color-accent));\n  border: none;\n  transition:\n    transform var(--dur-instant) var(--ease-standard),\n    box-shadow var(--dur-fast) var(--ease-standard),\n    opacity var(--dur-fast) var(--ease-standard);\n}\n.login-card .ant-btn-primary:hover {\n  box-shadow: 0 4px 16px var(--color-brand-glow-30);\n  transform: translateY(-1px);\n  opacity: 0.94;\n}\n.login-card .ant-btn-primary:active {\n  transform: scale(0.98);\n}\n\n/* 响应式：≥900px 分屏展示品牌区 */\n@media (min-width: 900px) {\n  .login-page {\n    gap: var(--space-16);\n  }\n  .login-brand {\n    display: flex;\n  }\n}\n\n/* 移动端隐藏部分装饰 */\n@media (max-width: 640px) {\n  .login-orb--b {\n    display: none;\n  }\n}\n\n/* 减弱动效适配 */\n@media (prefers-reduced-motion: reduce) {\n  .login-page,\n  .login-brand,\n  .login-panel,\n  .demo-account-item {\n    animation: none;\n  }\n  .login-orb {\n    animation: none;\n  }\n}\n"]],[[2,34]],["BODY",{"__playwright_target__":""},[[2,35]],["DIV",{"id":"root"},["DIV",{"class":"css-dev-only-do-not-override-v90ahe ant-app"},["DIV",{"style":"display: flex; justify-content: center; padding: var(--space-12);"},["DIV",{"class":"ant-spin ant-spin-lg ant-spin-spinning css-dev-only-do-not-override-v90ahe","aria-live":"polite","aria-busy":"true"},["SPAN",{"class":"ant-spin-dot-holder"},["SPAN",{"class":"ant-spin-dot ant-spin-dot-spin"},["I",{"class":"ant-spin-dot-item"}],["I",{"class":"ant-spin-dot-item"}],["I",{"class":"ant-spin-dot-item"}],["I",{"class":"ant-spin-dot-item"}]]]]]]],[[2,38]],[[2,39]]]],"viewport":{"width":1280,"height":720},"timestamp":100589.307,"wallTime":1786170269803,"collectionTime":0.7000000178813934,"resourceOverrides":[],"isMainFrame":true}}
