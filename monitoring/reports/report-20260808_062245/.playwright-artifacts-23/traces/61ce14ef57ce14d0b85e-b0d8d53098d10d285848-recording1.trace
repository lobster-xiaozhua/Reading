90ahe).anticon >*{line-height:1;}:where(.css-dev-only-do-not-override-v90ahe).anticon svg{display:inline-block;}:where(.css-dev-only-do-not-override-v90ahe).anticon .anticon .anticon-icon{display:block;}"],["STYLE",{},":where(.css-dev-only-do-not-override-v90ahe).ant-app{font-family:'Noto Sans SC','PingFang SC','Microsoft YaHei',system-ui,-apple-system,sans-serif;font-size:14px;box-sizing:border-box;}:where(.css-dev-only-do-not-override-v90ahe).ant-app::before,:where(.css-dev-only-do-not-override-v90ahe).ant-app::after{box-sizing:border-box;}:where(.css-dev-only-do-not-override-v90ahe).ant-app [class^=\"ant-app\"],:where(.css-dev-only-do-not-override-v90ahe).ant-app [class*=\" ant-app\"]{box-sizing:border-box;}:where(.css-dev-only-do-not-override-v90ahe).ant-app [class^=\"ant-app\"]::before,:where(.css-dev-only-do-not-override-v90ahe).ant-app [class*=\" ant-app\"]::before,:where(.css-dev-only-do-not-override-v90ahe).ant-app [class^=\"ant-app\"]::after,:where(.css-dev-only-do-not-override-v90ahe).ant-app [class*=\" ant-app\"]::after{box-sizing:border-box;}:where(.css-dev-only-do-not-override-v90ahe).ant-app{color:var(--gray-14);font-size:14px;line-height:1.5714;font-family:'Noto Sans SC','PingFang SC','Microsoft YaHei',system-ui,-apple-system,sans-serif;}:where(.css-dev-only-do-not-override-v90ahe).ant-app.ant-app-rtl{direction:rtl;}"],["STYLE",{},".anticon{display:inline-flex;align-items:center;color:inherit;font-style:normal;line-height:0;text-align:center;text-transform:none;vertical-align:-0.125em;text-rendering:optimizeLegibility;-webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale;}.anticon >*{line-height:1;}.anticon svg{display:inline-block;}.anticon .anticon .anticon-icon{display:block;}"],"\n    ","\n\n    ","\n\n    ",["META",{"charset":"utf-8"}],"\n    ",["LINK",{"rel":"icon","type":"image/svg+xml","href":"/favicon.svg"}],"\n    ",["META",{"name":"viewport","content":"width=device-width, initial-scale=1.0"}],"\n    ",["META",{"name":"theme-color","content":"#1890FF"}],"\n    ",["META",{"name":"description","content":"Atlas 小说运营管理后台"}],"\n    ",["META",{"name":"color-scheme","content":"light dark"}],"\n    ",["TITLE",{},"Atlas 运营管理后台"],"\n    ","\n    ",["STYLE",{},"\n      html,\n      body {\n        margin: 0;\n        padding: 0;\n        background: #f7f8fa;\n        color: #1f2329;\n        font-family:\n          \"Noto Sans SC\", \"PingFang SC\", \"Microsoft YaHei\", system-ui,\n          sans-serif;\n      }\n      #root {\n        min-height: 100vh;\n      }\n      .app-shell-skeleton {\n        display: flex;\n        min-height: 100vh;\n      }\n      .app-shell-skeleton__sider {\n        width: 240px;\n        background: #ffffff;\n        border-right: 1px solid #e5e6eb;\n      }\n      .app-shell-skeleton__main {\n        flex: 1;\n        padding: 24px;\n      }\n      .app-shell-skeleton__line {\n        height: 16px;\n        background: #f2f3f5;\n        border-radius: 4px;\n        margin-bottom: 12px;\n      }\n      .app-shell-skeleton__line--w60 {\n        width: 60%;\n      }\n      .app-shell-skeleton__line--w40 {\n        width: 40%;\n      }\n    "],"\n  ",["STYLE",{},"/* ============================================================\n * P1 · B 端布局样式\n * Sider 240/80 + Header 64 + Tabs 40 + Content max 1440\n * 响应式：>=1440 宽屏 / 1024-1439 中屏 / <1024 窄屏\n * ============================================================ */\n\n/* ---------- 整体外壳：响应式布局 ---------- */\n.bend-shell {\n  min-height: 100vh;\n  overflow-x: auto;\n}\n\n@media (max-width: 1023px) {\n  .bend-shell {\n    min-width: 1024px;\n  }\n}\n\n.bend-layout {\n  min-height: 100vh;\n}\n\n.bend-layout__main {\n  /* 内容区独立滚动，Sider/Header/Tabs 固定 */\n  height: 100vh;\n  overflow: hidden;\n  display: flex;\n  flex-direction: column;\n}\n\n/* ---------- 侧边栏 ---------- */\n.bend-sider {\n  background: var(--color-bg-surface) !important;\n  border-right: 1px solid var(--color-border-subtle);\n  box-shadow: var(--sh-1);\n  transition: width var(--dur-normal) var(--ease-standard), min-width var(--dur-normal) var(--ease-standard) !important;\n}\n\n.bend-sider__logo {\n  height: 64px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: var(--space-2);\n  border-bottom: 1px solid var(--color-border-subtle);\n  overflow: hidden;\n  transition: gap var(--dur-normal) var(--ease-standard);\n}\n\n.bend-sider__logo-icon {\n  flex-shrink: 0;\n  color: var(--color-brand);\n  transition: transform var(--dur-fast) var(--ease-standard);\n}\n\n.bend-sider:hover .bend-sider__logo-icon {\n  transform: scale(1.1);\n}\n\n.bend-sider__logo-mark {\n  font-size: 24px;\n  font-weight: 700;\n  color: var(--color-brand);\n}\n\n.bend-sider__logo-text {\n  font-size: 16px;\n  font-weight: 600;\n  color: var(--color-text-primary);\n  white-space: nowrap;\n}\n\n.bend-sider__menu {\n  border-inline-end: none !important;\n  padding: var(--space-2) var(--space-1);\n}\n\n/* AntD Menu 激活态：左侧 3px 指示条 + brand-bg + 品牌色文字 */\n.bend-sider__menu .ant-menu-item {\n  border-radius: var(--radius-md);\n  transition:\n    background var(--dur-fast) var(--ease-standard),\n    color var(--dur-fast) var(--ease-standard);\n}\n\n.bend-sider__menu .ant-menu-item:hover {\n  background: var(--color-bg-subtle) !important;\n}\n\n.bend-sider__menu .ant-menu-item-selected {\n  background: var(--color-brand-bg) !important;\n  color: var(--color-brand) !important;\n  border-radius: var(--radius-md);\n  position: relative;\n}\n\n.bend-sider__menu .ant-menu-item-selected::before {\n  content: \"\";\n  position: absolute;\n  left: 0;\n  top: 50%;\n  transform: translateY(-50%);\n  width: 3px;\n  height: 20px;\n  background: var(--color-brand);\n  border-radius: var(--radius-xs);\n  animation: siderIndicatorIn 200ms var(--ease-decelerate) both;\n}\n\n@keyframes siderIndicatorIn {\n  from {\n    height: 0;\n    opacity: 0;\n  }\n  to {\n    height: 20px;\n    opacity: 1;\n  }\n}\n\n/* 子菜单项折叠动画 */\n.bend-sider__menu .ant-menu-submenu-title {\n  transition:\n    color var(--dur-fast) var(--ease-standard),\n    background var(--dur-fast) var(--ease-standard);\n  border-radius: var(--radius-md);\n}\n\n.bend-sider__menu .ant-menu-submenu-title:hover {\n  color: var(--color-brand) !important;\n}\n\n/* ---------- 顶部栏 ---------- */\n.bend-header {\n  display: flex;\n  align-items: center;\n  gap: var(--space-3);\n  border-bottom: 1px solid var(--color-border-subtle);\n  padding: 0 var(--space-5) !important;\n  flex-shrink: 0;\n}\n\n.bend-header__collapse {\n  width: 48px;\n  height: 48px;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  border: none;\n  background: transparent;\n  color: var(--color-text-secondary);\n  border-radius: var(--radius-md);\n  cursor: pointer;\n  font-size: 18px;\n  transition:\n    background var(--dur-fast) var(--ease-standard),\n    color var(--dur-fast) var(--ease-standard),\n    transform var(--dur-instant) var(--ease-spring);\n  -webkit-tap-highlight-color: transparent;\n}\n\n.bend-header__collapse:hover {\n  background: var(--color-bg-subtle);\n  color: var(--color-text-primary);\n}\n\n.bend-header__collapse:focus-visible {\n  outline: 2px solid var(--color-border-focus);\n  outline-offset: 2px;\n  border-radius: var(--radius-sm);\n}\n\n.bend-header__collapse:active {\n  transform: scale(0.95);\n}\n\n.bend-header__breadcrumb {\n  flex: 1;\n  min-width: 0;\n  font-size: var(--font-size-small);\n}\n\n.bend-header__right {\n  display: flex;\n  align-items: center;\n  gap: var(--space-4);\n  flex-shrink: 0;\n}\n\n.bend-header__search .ant-input-affix-wrapper {\n  border-radius: var(--radius-md);\n}\n\n.bend-header__icon-btn {\n  width: 48px;\n  height: 48px;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  border: none;\n  background: transparent;\n  color: var(--color-text-secondary);\n  border-radius: var(--radius-md);\n  cursor: pointer;\n  font-size: 18px;\n  transition:\n    background var(--dur-fast) var(--ease-standard),\n    color var(--dur-fast) var(--ease-standard),\n    transform var(--dur-instant) var(--ease-spring);\n  -webkit-tap-highlight-color: transparent;\n}\n\n.bend-header__icon-btn:hover {\n  background: var(--color-bg-subtle);\n  color: var(--color-text-primary);\n}\n\n.bend-header__icon-btn:focus-visible {\n  outline: 2px solid var(--color-border-focus);\n  outline-offset: 2px;\n  border-radius: var(--radius-sm);\n}\n\n.bend-header__icon-btn:active {\n  transform: scale(0.95);\n}\n\n.bend-header__user {\n  display: inline-flex;\n  align-items: center;\n  gap: var(--space-2);\n  border: none;\n  background: transparent;\n  cursor: pointer;\n  padding: var(--space-1) var(--space-2);\n  border-radius: var(--radius-md);\n  transition: background var(--dur-fast) var(--ease-out);\n}\n\n.bend-header__user:hover {\n  background: var(--color-bg-subtle);\n}\n\n.bend-header__user:focus-visible {\n  outline: 2px solid var(--color-border-focus);\n  outline-offset: 2px;\n  border-radius: var(--radius-sm);\n}\n\n.bend-header__user:active {\n  transform: scale(0.97);\n}\n\n.bend-header__username {\n  font-size: var(--font-size-small);\n  color: var(--color-text-primary);\n  max-width: 120px;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n/* ---------- 多 Tab 标签页 ---------- */\n.bend-tabs {\n  height: 40px;\n  flex-shrink: 0;\n  background: var(--color-bg-surface);\n  border-bottom: 1px solid var(--color-border-subtle);\n  padding: 0 var(--space-5);\n  display: flex;\n  align-items: flex-end;\n  overflow: hidden;\n}\n\n.bend-tabs .ant-tabs {\n  width: 100%;\n}\n\n.bend-tabs .ant-tabs-nav {\n  margin: 0 !important;\n}\n\n.bend-tabs .ant-tabs-tab {\n  padding: var(--space-1) var(--space-3) !important;\n  min-width: 120px;\n  max-width: 200px;\n  border-radius: var(--radius-md) var(--radius-md) 0 0 !important;\n  font-size: 13px;\n  transition:\n    background var(--dur-fast) var(--ease-standard),\n    color var(--dur-fast) var(--ease-standard),\n    border-color var(--dur-fast) var(--ease-standard);\n}\n\n.bend-tabs .ant-tabs-tab:hover {\n  color: var(--color-brand) !important;\n}\n\n.bend-tabs .ant-tabs-tab-active {\n  background: var(--color-bg-page) !important;\n  border-bottom-color: var(--color-bg-page) !important;\n  color: var(--color-brand) !important;\n}\n\n.bend-tabs .ant-tabs-tab-btn {\n  transition: color var(--dur-fast) var(--ease-standard);\n}\n\n.bend-tabs .ant-tabs-tab-remove {\n  transition:\n    opacity var(--dur-fast) var(--ease-standard),\n    transform var(--dur-fast) var(--ease-standard);\n  opacity: 0.5;\n}\n\n.bend-tabs .ant-tabs-tab:hover .ant-tabs-tab-remove {\n  opacity: 1;\n  transform: scale(1.1);\n}\n\n.bend-tabs .ant-tabs-tab-remove:active {\n  transform: scale(0.9);\n}\n\n/* ---------- 内容区 ---------- */\n.bend-layout__content {\n  flex: 1;\n  overflow-y: auto;\n  outline: none;\n}\n\n.bend-layout__inner {\n  animation: bFadeIn 0.3s ease-out;\n}\n\n@keyframes bFadeIn {\n  from {\n    opacity: 0;\n    transform: translateY(6px);\n  }\n  to {\n    opacity: 1;\n    transform: translateY(0);\n  }\n}\n\n.bend-layout__inner {\n  max-width: 1440px;\n  margin: 0 auto;\n  display: grid;\n  grid-template-columns: repeat(12, 1fr);\n  gap: var(--space-4);\n}\n\n/* Sider 折叠动画对齐令牌 */\n.ant-layout-sider {\n  transition:\n    width var(--dur-normal) var(--ease-in-out),\n    min-width var(--dur-normal) var(--ease-in-out);\n}\n\n/* Chapter edit icon hover visibility */\n.b-chapter-edit-icon {\n  opacity: 0;\n  transition: opacity 0.2s ease;\n}\n\ntr:hover .b-chapter-edit-icon {\n  opacity: 1;\n}\n\n/* B 端页面切换淡入动画 */\n.b-page-fade-in {\n  animation: bPageFadeIn 250ms var(--ease-decelerate) both;\n}\n\n@keyframes bPageFadeIn {\n  from {\n    opacity: 0;\n    transform: translateY(8px);\n  }\n  to {\n    opacity: 1;\n    transform: translateY(0);\n  }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .b-page-fade-in {\n    animation: none;\n  }\n}\n"],["STYLE",{},"/* ============================================================\n * B 端全局样式（apps/admin）\n * - 仅注入 @novel/tokens（不注入 @novel/components/styles.css，V1.1 修正审查 #1）\n * - AntD 样式由 cssinjs 运行时注入，无需全局引入\n * ============================================================ */\n/* ============================================================\n * Atlas Design System · Tokens Aggregator\n * 一站式引入：primitive + semantic + reader-theme\n * 用法：import '@novel/tokens/styles/tokens.css';\n * ============================================================ */\n\n/* ============================================================\n * Atlas Design System · L1 Primitive Tokens\n * 不可变原子值，全局唯一真值。组件禁止直接引用本层。\n * Source: 01-前端底层设计.md §13.1\n * Version: V1.0.0 · 2026.07\n * ============================================================ */\n\n:root {\n  /* ---------- L1 Primitive · 品牌（Ant Design blue 基准） ---------- */\n  --brand-1: #F0F9FF;\n  --brand-2: #E6F7FF;\n  --brand-3: #BAE7FF;\n  --brand-4: #91D5FF;\n  --brand-5: #69C0FF;\n  --brand-6: #40A9FF;\n  --brand-7: #1890FF;\n  --brand-8: #096DD9;\n  --brand-9: #0050B3;\n  --brand-10: #003A8C;\n\n  /* ---------- L1 Primitive · 强调（C 端 accent，钴蓝） ---------- */\n  --accent-1: #EEF2FF;\n  --accent-2: #DCE3FF;\n  --accent-3: #B9C7FF;\n  --accent-4: #8FA5FF;\n  --accent-5: #6A82FF;\n  --accent-6: #4566FF;\n  --accent-7: #245BFF;\n  --accent-8: #1A47D9;\n  --accent-9: #1238A8;\n  --accent-10: #0B2470;\n\n  /* ---------- L1 Primitive · 暖橙（C 端营销扩展色，03 §3.2.1） ---------- */\n  --orange-1: #FFF4E6;\n  --orange-2: #FFD9B3;\n  --orange-3: #E37318;\n  --orange-4: #F08528;\n  --orange-5: #C9640F;\n\n  /* ---------- L1 Primitive · 功能色 ---------- */\n  --success-1: #F6FFED;\n  --success-2: #B7EB8F;\n  --success-3: #52C41A;\n  --success-4: #389E0D;\n  --success-5: #237804;\n\n  --warning-1: #FFFBE6;\n  --warning-2: #FFE58F;\n  --warning-3: #FAAD14;\n  --warning-4: #D48806;\n  --warning-5: #AD6800;\n\n  --error-1: #FFF1F0;\n  --error-2: #FFA39E;\n  --error-3: #F5222D;\n  --error-4: #CF1322;\n  --error-5: #A8071A;\n\n  --info-1: #E6F7FF;\n  --info-2: #91D5FF;\n  --info-3: #1890FF;\n  --info-4: #096DD9;\n  --info-5: #0050B3;\n\n  /* ---------- L1 Primitive · 中性色 14 级 ---------- */\n  --gray-1: #F7F7F8;\n  --gray-2: #EDEDF0;\n  --gray-3: #E2E2E7;\n  --gray-4: #D3D3DA;\n  --gray-5: #B8B8C1;\n  --gray-6: #9999A5;\n  --gray-7: #7A7A86;\n  --gray-8: #5E5E6A;\n  --gray-9: #45454F;\n  --gray-10: #2F2F37;\n  --gray-11: #1F1F25;\n  --gray-12: #15151B;\n  --gray-13: #0E0E13;\n  --gray-14: #0A0B12;\n\n  /* ---------- L1 Primitive · 阅读主题色（独立于通用 gray） ---------- */\n  --read-bg-day: #FFFFFF;\n  --read-bg-night: #1A1A1A;\n  --read-bg-sepia: #F5EDDC;\n  --read-bg-parchment: #F4ECD8;\n\n  --read-text-day: #2A2B33;\n  --read-text-night: #E0E0E0;\n  --read-text-sepia: #5B4636;\n  --read-text-parchment: #5B4636;\n\n  --read-text-secondary-day: #5E5E6A;\n  --read-text-secondary-night: #888888;\n  --read-text-secondary-sepia: #8C7355;\n  --read-text-secondary-parchment: #8C7355;\n\n  /* ---------- L1 Primitive · 图表色板（独立于 UI 语义色，02 §4.1 / 04 §7.1） ---------- */\n  --chart-1: #1890FF;  /* 主序列，对齐 brand-7 */\n  --chart-2: #52C41A;  /* 对齐 success-3 */\n  --chart-3: #FAAD14;  /* 对齐 warning-3 */\n  --chart-4: #F5222D;  /* 对齐 error-3 */\n  --chart-5: #722ED1;  /* 紫色序列 */\n  --chart-6: #13C2C2;  /* 青色序列 */\n\n  /* ---------- L1 Primitive · 渐变色 ---------- */\n  --gradient-brand-subtle: linear-gradient(135deg, #E6F7FF 0%, #F0F9FF 100%);\n  --gradient-brand-strong: linear-gradient(135deg, #1890FF 0%, #096DD9 100%);\n  --gradient-warm: linear-gradient(135deg, #FFF4E6 0%, #FFE4B5 100%);\n  --gradient-rose: linear-gradient(135deg, #FF6B6B 0%, #F5222D 100%);\n  --gradient-gold: linear-gradient(135deg, #FFD700 0%, #FFA500 100%);\n  --gradient-surface: linear-gradient(180deg, #FFFFFF 0%, #F7F7F8 100%);\n  --gradient-surface-dark: linear-gradient(180deg, #15151B 0%, #0E0E13 100%);\n}\n/* ============================================================\n * Atlas Design System · L2 Semantic Tokens\n * 按用途命名，引用 L1 Primitive，随主题切换。\n * 组件层推荐引用本层（var(--color-*)）。\n * Source: 01-前端底层设计.md §13.1\n * ============================================================ */\n\n:root {\n  color-scheme: light dark;\n\n  /* ---------- L2 Semantic · 文本 ---------- */\n  --color-text-primary: var(--gray-14);\n  --color-text-secondary: var(--gray-8);\n  --color-text-tertiary: var(--gray-6);\n  --color-text-disabled: var(--gray-5);\n  --color-text-inverse: var(--gray-1);\n  --color-text-link: var(--brand-7);\n  --color-text-link-hover: var(--brand-6);\n\n  /* ---------- L2 Semantic · 背景 ---------- */\n  --color-bg-page: var(--gray-1);\n  --color-bg-surface: #FFFFFF;\n  --color-bg-subtle: var(--gray-2);\n  --color-bg-elevated: #FFFFFF;\n  --color-bg-mask: rgba(10, 11, 18, 0.45);\n\n  /* ---------- L2 Semantic · 边框 ---------- */\n  --color-border-default: var(--gray-4);\n  --color-border-subtle: var(--gray-3);\n  --color-border-focus: var(--brand-7);\n  --color-border-strong: var(--gray-6);\n\n  /* ---------- L2 Semantic · 品牌 ---------- */\n  --color-brand: var(--brand-7);\n  --color-brand-hover: var(--brand-8);\n  --color-brand-active: var(--brand-9);\n  --color-brand-bg: var(--brand-2);\n  --color-brand-border: var(--brand-3);\n\n  /* ---------- L2 Semantic · 表面层级（新增 raised / overlay / tooltip） ---------- */\n  --color-bg-raised: #FFFFFF;\n  --color-bg-overlay: #FFFFFF;\n  --color-bg-tooltip: var(--gray-14);\n\n  /* ---------- L2 Semantic · 渐变（引用 L1 Gradient） ---------- */\n  --gradient-brand-subtle: var(--gradient-brand-subtle);\n  --gradient-brand-strong: var(--gradient-brand-strong);\n  --gradient-warm: var(--gradient-warm);\n  --gradient-rose: var(--gradient-rose);\n  --gradient-gold: var(--gradient-gold);\n  --gradient-surface: var(--gradient-surface);\n\n  /* ---------- L2 Semantic · 品牌发光（光晕/按钮辉光等视觉装饰，随主题切换） ---------- */\n  --color-brand-glow-0: rgba(24, 144, 255, 0);\n  --color-brand-glow-20: rgba(24, 144, 255, 0.2);\n  --color-brand-glow-25: rgba(24, 144, 255, 0.25);\n  --color-brand-glow-30: rgba(24, 144, 255, 0.3);\n  --color-brand-glow-35: rgba(24, 144, 255, 0.35);\n  --color-brand-glow-40: rgba(24, 144, 255, 0.4);\n\n  /* ---------- L2 Semantic · 强调（C 端 accent） ---------- */\n  --color-accent: var(--accent-7);\n  --color-accent-hover: var(--accent-8);\n  --color-accent-active: var(--accent-9);\n\n  /* ---------- L2 Semantic · 强调暖橙（C 端营销色，03 §3.2.1） ---------- */\n  --color-accent-orange: var(--orange-3);\n  --color-accent-orange-hover: var(--orange-4);\n  --color-accent-orange-active: var(--orange-5);\n  --color-accent-orange-bg: var(--orange-1);\n\n  /* ---------- L2 Semantic · 玫红（C 端互动色，03 §3.2.2） ---------- */\n  --color-rose: var(--error-3);\n  --color-rose-light: #FF6B6B;\n  --color-rose-gradient: linear-gradient(135deg, var(--error-3) 0%, #FF6B6B 100%);\n  --color-rose-bg: var(--error-1);\n\n  /* ---------- L2 Semantic · 排行榜 Top3 奖牌色（03 §6.3 排行榜） ---------- */\n  --color-rank-gold-gradient: linear-gradient(135deg, #FFD700, #FFA500);\n  --color-rank-silver-gradient: linear-gradient(135deg, #C0C0C0, #A0A0A0);\n  --color-rank-bronze-gradient: linear-gradient(135deg, #CD7F32, #A06030);\n\n  /* ---------- L2 Semantic · 排行榜 Top3 奖牌阴影（03 §6.3） ---------- */\n  --color-rank-gold-shadow: rgba(255, 215, 0, 0.3);\n  --color-rank-silver-shadow: rgba(192, 192, 192, 0.3);\n  --color-rank-bronze-shadow: rgba(205, 127, 50, 0.3);\n\n  /* ---------- L2 Semantic · 遮罩 / 覆盖层（轮播图、卡片悬浮控件） ---------- */\n  --color-overlay-gradient: linear-gradient(180deg, transparent 40%, rgba(0, 0, 0, 0.72) 100%);\n  --color-overlay-medium: rgba(0, 0, 0, 0.4);\n  --color-overlay-strong: rgba(0, 0, 0, 0.6);\n  --color-overlay-dot: rgba(255, 255, 255, 0.5);\n\n  /* ---------- L2 Semantic · 装饰光泽 / 阴影（按钮涟漪、卡片光泽、轻阴影） ---------- */\n  --color-overlay-white-10: rgba(255, 255, 255, 0.1);\n  --color-overlay-white-12: rgba(255, 255, 255, 0.12);\n  --color-overlay-white-15: rgba(255, 255, 255, 0.15);\n  --color-overlay-white-20: rgba(255, 255, 255, 0.2);\n  --color-overlay-white-25: rgba(255, 255, 255, 0.25);\n  --color-overlay-white-30: rgba(255, 255, 255, 0.3);\n  --color-shadow-soft-10: rgba(0, 0, 0, 0.1);\n  --color-shadow-soft-15: rgba(0, 0, 0, 0.15);\n\n  /* ---------- L2 Semantic · 反馈 ---------- */\n  --color-feedback-success: var(--success-3);\n  --color-feedback-success-bg: var(--success-1);\n  --color-feedback-warning: var(--warning-3);\n  --color-feedback-warning-bg: var(--warning-1);\n  --color-feedback-error: var(--error-3);\n  --color-feedback-error-bg: var(--error-1);\n  --color-feedback-info: var(--info-3);\n  --color-feedback-info-bg: var(--info-1);\n\n  /* ---------- 字体 ---------- */\n  --font-sans: 'Noto Sans SC', 'PingFang SC', 'Microsoft YaHei', system-ui, -apple-system, sans-serif;\n  --font-serif: 'Noto Serif SC', 'Source Han Serif SC', 'Songti SC', serif;\n  --font-mono: 'JetBrains Mono', 'SFMono-Regular', Consolas, 'Liberation Mono', monospace;\n\n  --font-size-display: 64px;\n  --font-size-h1: 40px;\n  --font-size-h2: 28px;\n  --font-size-h3: 20px;\n  --font-size-body: 16px;\n  --font-size-small: 14px;\n  --font-size-caption: 13px;\n  --font-size-xs: 12px;\n  --font-size-overline: 11px;\n  --font-size-tiny: 10px;\n  --font-size-button: 14px;\n  --font-size-body-lg: 17px;\n  --font-size-h4: 18px;\n\n  /* ---------- 字号语义化（用途命名） ---------- */\n  --font-size-prose: var(--font-size-body);\n  --font-size-prose-lg: var(--font-size-body-lg);\n  --font-size-eyebrow: var(--font-size-overline);\n  --font-size-label: var(--font-size-caption);\n\n  --font-weight-light: 300;\n  --font-weight-regular: 400;\n  --font-weight-medium: 500;\n  --font-weight-semibold: 600;\n  --font-weight-bold: 700;\n  --font-weight-extrabold: 800;\n\n  /* ---------- 字重语义化（按层级用途） ---------- */\n  --font-weight-heading: var(--font-weight-bold);\n  --font-weight-subheading: var(--font-weight-semibold);\n  --font-weight-body: var(--font-weight-regular);\n  --font-weight-emphasis: var(--font-weight-medium);\n  --font-weight-caption: var(--font-weight-medium);\n\n  /* ---------- 行高（5 级，按内容类型） ---------- */\n  --line-height-tighter: 1.1;   /* display / hero title */\n  --line-height-tight: 1.2;     /* heading 1-2 */\n  --line-height-snug: 1.35;     /* heading 3-4 / UI title */\n  --line-height-normal: 1.5;    /* body / input */\n  --line-height-relaxed: 1.7;   /* prose / long-form */\n  --line-height-loose: 1.85;    /* 阅读类正文 */\n\n  /* ---------- 行高语义化 ---------- */\n  --line-height-display: var(--line-height-tighter);\n  --line-height-heading: var(--line-height-tight);\n  --line-height-subheading: var(--line-height-snug);\n  --line-height-ui: var(--line-height-snug);\n  --line-height-prose: var(--line-height-relaxed);\n\n  /* ---------- 字间距（6 级） ---------- */\n  --letter-spacing-tighter: -0.04em;\n  --letter-spacing-tight: -0.02em;\n  --letter-spacing-normal: 0;\n  --letter-spacing-wide: 0.02em;\n  --letter-spacing-wider: 0.05em;\n  --letter-spacing-widest: 0.1em;\n\n  /* ---------- 字间距语义化 ---------- */\n  --letter-spacing-heading: var(--letter-spacing-tight);\n  --letter-spacing-display: var(--letter-spacing-tighter);\n  --letter-spacing-body: var(--letter-spacing-normal);\n  --letter-spacing-caption: var(--letter-spacing-wide);\n  --letter-spacing-eyebrow: var(--letter-spacing-wider);\n  --letter-spacing-uppercase: var(--letter-spacing-widest);\n\n  /* ---------- 小说正文 ---------- */\n  --novel-font-family: var(--font-serif);\n  --novel-font-size: 18px;\n  --novel-line-height: 1.8;\n  --novel-paragraph-spacing: 1em;\n  --novel-text-color: var(--gray-11);\n  --novel-measure: 42ch;\n\n  /* ---------- 阅读主题（L2 Semantic，切换时仅改这一层） ---------- */\n  --novel-read-bg: var(--read-bg-day);\n  --novel-read-text: var(--read-text-day);\n  --novel-read-text-secondary: var(--read-text-secondary-day);\n\n  /* ---------- 阅读器交互区 ---------- */\n  --reader-tap-zone: 80px;\n  --reader-tap-center: 40%;\n  --reader-toolbar-height: 56px;\n  --reader-progress-height: 3px;\n  --reader-chapter-gap: var(--space-12);\n  --reader-paragraph-indent: 2em;\n  --reader-line-spacing-extra: 0.05em;\n\n  /* ---------- 阅读器字体族（L2，由 ReaderSettings 切换；03 §4.6） ---------- */\n  --reader-font-family: var(--font-serif);\n  --reader-font-family-serif: 'Noto Serif SC', serif;\n  --reader-font-family-song: 'SimSun', 'Noto Serif SC', serif;\n  --reader-font-family-hei: 'SimHei', 'Noto Sans SC', sans-serif;\n  --reader-font-family-kai: 'KaiTi', 'Noto Serif SC', serif;\n\n  /* ---------- 阅读器行距分档（03 §6.13 ReaderSettings） ---------- */\n  --reader-line-height-compact: 1.5;\n  --reader-line-height-standard: 1.8;\n  --reader-line-height-loose: 2.1;\n\n  /* ---------- 间距（13 档，4px 基准） ---------- */\n  --space-1: 4px;\n  --space-2: 8px;\n  --space-3: 12px;\n  --space-4: 16px;\n  --space-5: 20px;\n  --space-6: 24px;\n  --space-8: 32px;\n  --space-10: 40px;\n  --space-12: 48px;\n  --space-16: 64px;\n  --space-20: 80px;\n  --space-24: 96px;\n  --space-32: 128px;\n\n  /* ---------- 圆角（8 档） ---------- */\n  --radius-none: 0;\n  --radius-xs: 2px;\n  --radius-sm: 4px;\n  --radius-md: 8px;\n  --radius-lg: 12px;\n  --radius-xl: 16px;\n  --radius-2xl: 24px;\n  --radius-full: 9999px;\n\n  /* ---------- 阴影（5 级） ---------- */\n  --sh-1: 0 1px 2px 0 rgba(0, 0, 0, 0.04);\n  --sh-2: 0 2px 8px 0 rgba(0, 0, 0, 0.08);\n  --sh-3: 0 4px 12px 0 rgba(0, 0, 0, 0.10);\n  --sh-4: 0 8px 24px 0 rgba(0, 0, 0, 0.12);\n  --sh-5: 0 16px 48px 0 rgba(0, 0, 0, 0.16);\n\n  /* ---------- 阴影增强（发光、内阴影、按压） ---------- */\n  --sh-glow-brand: 0 0 12px rgba(24, 144, 255, 0.3);\n  --sh-glow-rose: 0 0 12px rgba(245, 34, 45, 0.2);\n  --sh-inner: inset 0 1px 3px rgba(0, 0, 0, 0.06);\n  --sh-pressed: inset 0 1px 4px rgba(0, 0, 0, 0.12);\n\n  /* ---------- 动效 ---------- */\n  --ease-standard: cubic-bezier(0.4, 0, 0.2, 1);\n  --ease-emphasized: cubic-bezier(0.2, 0, 0, 1);\n  --ease-decelerate: cubic-bezier(0, 0, 0.2, 1);\n  --ease-accelerate: cubic-bezier(0.4, 0, 1, 1);\n  --ease-spring: cubic-bezier(0.34, 1.56, 0.64, 1);\n  --ease-smooth: cubic-bezier(0.65, 0, 0.35, 1);\n\n  --dur-instant: 90ms;\n  --dur-fast: 150ms;\n  --dur-normal: 240ms;\n  --dur-slow: 360ms;\n  --dur-deliberate: 540ms;\n\n  /* ---------- 过渡简写（组合 duration + easing） ---------- */\n  --transition-fade: opacity var(--dur-fast) var(--ease-standard);\n  --transition-slide: transform var(--dur-normal) var(--ease-decelerate);\n  --transition-spring: transform var(--dur-normal) var(--ease-spring);\n  --transition-expand: grid-template-rows var(--dur-normal) var(--ease-standard);\n\n  /* ---------- 层级 z-index（6 级） ---------- */\n  --z-index-base: 0;\n  --z-index-dropdown: 1000;\n  --z-index-sticky: 1100;\n  --z-index-drawer: 1200;\n  --z-index-modal: 1300;\n  --z-index-toast: 1400;\n\n  /* ---------- 主题切换过渡 ---------- */\n  --theme-transition: background-color 0.3s ease, color 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;\n\n  /* ---------- 图标尺寸 ---------- */\n  --icon-size-xs: 12px;\n  --icon-size-sm: 14px;\n  --icon-size-md: 16px;\n  --icon-size-lg: 20px;\n  --icon-size-xl: 24px;\n  --icon-size-2xl: 32px;\n\n  /* ---------- L2 Semantic · 图表色板（02 §4.1 / 04 §7.1） ---------- */\n  --color-chart-1: var(--chart-1);\n  --color-chart-2: var(--chart-2);\n  --color-chart-3: var(--chart-3);  /* 暗色提亮为 #8AA2B8（见下方 dark 块，P9-D3） */\n  --color-chart-4: var(--chart-4);\n  --color-chart-5: var(--chart-5);\n  --color-chart-6: var(--chart-6);\n}\n\n/* ============================================================\n * Dark Theme · 仅覆盖 L2 语义层与阴影\n * 触发：[data-theme='dark']\n * ============================================================ */\n[data-theme='dark'] {\n  color-scheme: dark;\n\n  --color-text-primary: var(--gray-1);\n  --color-text-secondary: var(--gray-5);\n  --color-text-tertiary: var(--gray-6);\n  --color-text-disabled: var(--gray-7);\n  --color-text-inverse: var(--gray-14);\n  --color-text-link: var(--brand-6);\n  --color-text-link-hover: var(--brand-5);\n\n  --color-bg-page: var(--gray-14);\n  --color-bg-surface: var(--gray-12);\n  --color-bg-subtle: var(--gray-11);\n  --color-bg-elevated: var(--gray-12);\n  --color-bg-mask: rgba(0, 0, 0, 0.65);\n\n  --color-border-default: var(--gray-10);\n  --color-border-subtle: var(--gray-11);\n  --color-border-focus: var(--brand-6);\n  --color-border-strong: var(--gray-8);\n\n  --color-brand: var(--brand-6);\n  --color-brand-hover: var(--brand-7);\n  --color-brand-active: var(--brand-8);\n  --color-brand-bg: rgba(24, 144, 255, 0.16);\n  --color-brand-border: rgba(24, 144, 255, 0.32);\n\n  /* 品牌发光暗色重定义：跟随暗色主品牌色 #40A9FF（brand-6） */\n  --color-brand-glow-0: rgba(64, 169, 255, 0);\n  --color-brand-glow-20: rgba(64, 169, 255, 0.2);\n  --color-brand-glow-25: rgba(64, 169, 255, 0.25);\n  --color-brand-glow-30: rgba(64, 169, 255, 0.3);\n  --color-brand-glow-35: rgba(64, 169, 255, 0.35);\n  --color-brand-glow-40: rgba(64, 169, 255, 0.4);\n\n  --color-accent: var(--accent-6);\n  --color-accent-hover: var(--accent-7);\n  --color-accent-active: var(--accent-8);\n\n  /* 暖橙暗色提亮（03 §3.2.1：保证对比度） */\n  --color-accent-orange: var(--orange-4);\n  --color-accent-orange-hover: var(--orange-3);\n  --color-accent-orange-active: var(--orange-5);\n  --color-accent-orange-bg: rgba(240, 133, 40, 0.16);\n\n  /* 玫红暗色微调 */\n  --color-rose-bg: rgba(245, 34, 45, 0.16);\n\n  --color-bg-raised: var(--gray-11);\n  --color-bg-overlay: var(--gray-11);\n  --color-bg-tooltip: var(--gray-2);\n\n  --gradient-surface: var(--gradient-surface-dark);\n\n  --color-feedback-success: var(--success-2);\n  --color-feedback-success-bg: rgba(82, 196, 26, 0.16);\n  --color-feedback-warning: var(--warning-2);\n  --color-feedback-warning-bg: rgba(250, 173, 20, 0.16);\n  --color-feedback-error: var(--error-2);\n  --color-feedback-error-bg: rgba(245, 34, 45, 0.16);\n  --color-feedback-info: var(--info-2);\n  --color-feedback-info-bg: rgba(24, 144, 255, 0.16);\n\n  --novel-text-color: var(--gray-3);\n\n  /* 阅读主题：系统暗色时默认指向夜间主题 */\n  --novel-read-bg: var(--read-bg-night);\n  --novel-read-text: var(--read-text-night);\n  --novel-read-text-secondary: var(--read-text-secondary-night);\n\n  /* 图表色板暗色覆盖：chart-3 提亮保证对比度（P9-D3 / 04 §7.1） */\n  --color-chart-3: #8AA2B8;\n\n  --sh-1: 0 1px 2px 0 rgba(0, 0, 0, 0.40);\n  --sh-2: 0 2px 8px 0 rgba(0, 0, 0, 0.44);\n  --sh-3: 0 4px 12px 0 rgba(0, 0, 0, 0.48);\n  --sh-4: 0 8px 24px 0 rgba(0, 0, 0, 0.52);\n  --sh-5: 0 16px 48px 0 rgba(0, 0, 0, 0.56);\n}\n\n/* ============================================================\n * 系统暗色模式自动触发（匹配用户 OS 偏好）\n * ============================================================ */\n@media (prefers-color-scheme: dark) {\n  :root:not([data-theme='light']) {\n    color-scheme: dark;\n\n    --color-text-primary: var(--gray-1);\n    --color-text-secondary: var(--gray-5);\n    --color-text-tertiary: var(--gray-6);\n    --color-text-disabled: var(--gray-7);\n    --color-text-inverse: var(--gray-14);\n    --color-text-link: var(--brand-6);\n    --color-text-link-hover: var(--brand-5);\n\n    --color-bg-page: var(--gray-14);\n    --color-bg-surface: var(--gray-12);\n    --color-bg-subtle: var(--gray-11);\n    --color-bg-elevated: var(--gray-12);\n    --color-bg-mask: rgba(0, 0, 0, 0.65);\n\n    --color-border-default: var(--gray-10);\n    --color-border-subtle: var(--gray-11);\n    --color-border-focus: var(--brand-6);\n    --color-border-strong: var(--gray-8);\n\n    --color-brand: var(--brand-6);\n    --color-brand-hover: var(--brand-7);\n    --color-brand-active: var(--brand-8);\n    --color-brand-bg: rgba(24, 144, 255, 0.16);\n    --color-brand-border: rgba(24, 144, 255, 0.32);\n\n    --color-brand-glow-0: rgba(64, 169, 255, 0);\n    --color-brand-glow-20: rgba(64, 169, 255, 0.2);\n    --color-brand-glow-25: rgba(64, 169, 255, 0.25);\n    --color-brand-glow-30: rgba(64, 169, 255, 0.3);\n    --color-brand-glow-35: rgba(64, 169, 255, 0.35);\n    --color-brand-glow-40: rgba(64, 169, 255, 0.4);\n\n    --color-accent: var(--accent-6);\n    --color-accent-hover: var(--accent-7);\n    --color-accent-active: var(--accent-8);\n\n    --color-accent-orange: var(--orange-4);\n    --color-accent-orange-hover: var(--orange-3);\n    --color-accent-orange-active: var(--orange-5);\n    --color-accent-orange-bg: rgba(240, 133, 40, 0.16);\n\n--color-rose-bg: rgba(245, 34, 45, 0.16);\n\n  --color-bg-raised: var(--gray-11);\n  --color-bg-overlay: var(--gray-11);\n  --color-bg-tooltip: var(--gray-2);\n\n  --gradient-surface: var(--gradient-surface-dark);\n\n    --color-feedback-success: var(--success-2);\n    --color-feedback-success-bg: rgba(82, 196, 26, 0.16);\n    --color-feedback-warning: var(--warning-2);\n    --color-feedback-warning-bg: rgba(250, 173, 20, 0.16);\n    --color-feedback-error: var(--error-2);\n    --color-feedback-error-bg: rgba(245, 34, 45, 0.16);\n    --color-feedback-info: var(--info-2);\n    --color-feedback-info-bg: rgba(24, 144, 255, 0.16);\n\n    --novel-text-color: var(--gray-3);\n\n    --novel-read-bg: var(--read-bg-night);\n    --novel-read-text: var(--read-text-night);\n    --novel-read-text-secondary: var(--read-text-secondary-night);\n\n    --color-chart-3: #8AA2B8;\n\n    --sh-1: 0 1px 2px 0 rgba(0, 0, 0, 0.40);\n    --sh-2: 0 2px 8px 0 rgba(0, 0, 0, 0.44);\n    --sh-3: 0 4px 12px 0 rgba(0, 0, 0, 0.48);\n    --sh-4: 0 8px 24px 0 rgba(0, 0, 0, 0.52);\n    --sh-5: 0 16px 48px 0 rgba(0, 0, 0, 0.56);\n  }\n}\n\n/* ---------- 高对比偏好（无障碍，03 §10） ---------- */\n@media (prefers-contrast: more) {\n  :root {\n    --color-border-default: var(--gray-7);\n    --color-border-subtle: var(--gray-6);\n  }\n  [data-theme='dark'] {\n    --color-border-default: var(--gray-5);\n    --color-border-subtle: var(--gray-6);\n  }\n  @media (prefers-color-scheme: dark) {\n    :root:not([data-theme='light']) {\n      --color-border-default: var(--gray-5);\n      --color-border-subtle: var(--gray-6);\n    }\n  }\n}\n\n/* ---------- 减弱动效（无障碍，01 §10.3） ---------- */\n@media (prefers-reduced-motion: reduce) {\n  :root {\n    --dur-instant: 0ms;\n    --dur-fast: 0ms;\n    --dur-normal: 0ms;\n    --dur-slow: 0ms;\n    --dur-deliberate: 0ms;\n  }\n}\n/* ============================================================\n * Atlas Design System · Reader Theme Tokens\n * 4 阅读主题（日/夜/护眼/羊皮纸），切换时仅改 L2 Semantic 层。\n * 触发：[data-reader-theme='day|night|sepia|parchment']\n * Source: 01-前端底层设计.md §5.6 / 03-C端专项设计.md §3.4\n * ============================================================ */\n\n/* 日间（默认，与系统浅色一致） */\n[data-reader-theme='day'] {\n  --novel-read-bg: var(--read-bg-day);\n  --novel-read-text: var(--read-text-day);\n  --novel-read-text-secondary: var(--read-text-secondary-day);\n}\n\n/* 夜间 */\n[data-reader-theme='night'] {\n  --novel-read-bg: var(--read-bg-night);\n  --novel-read-text: var(--read-text-night);\n  --novel-read-text-secondary: var(--read-text-secondary-night);\n}\n\n/* 护眼（sepia） */\n[data-reader-theme='sepia'] {\n  --novel-read-bg: var(--read-bg-sepia);\n  --novel-read-text: var(--read-text-sepia);\n  --novel-read-text-secondary: var(--read-text-secondary-sepia);\n}\n\n/* 羊皮纸（parchment） */\n[data-reader-theme='parchment'] {\n  --novel-read-bg: var(--read-bg-parchment);\n  --novel-read-text: var(--read-text-parchment);\n  --novel-read-text-secondary: var(--read-text-secondary-parchment);\n}\n\n/* 阅读主题切换强制 instant（90ms），避免色彩流动干扰阅读 */\n[data-reader-theme] {\n  transition:\n    background-color var(--dur-instant) var(--ease-standard),\n    color var(--dur-instant) var(--ease-standard);\n}\n*, ::before, ::after {\n  --tw-border-spacing-x: 0;\n  --tw-border-spacing-y: 0;\n  --tw-translate-x: 0;\n  --tw-translate-y: 0;\n  --tw-rotate: 0;\n  --tw-skew-x: 0;\n  --tw-skew-y: 0;\n  --tw-scale-x: 1;\n  --tw-scale-y: 1;\n  --tw-pan-x:  ;\n  --tw-pan-y:  ;\n  --tw-pinch-zoom:  ;\n  --tw-scroll-snap-strictness: proximity;\n  --tw-gradient-from-position:  ;\n  --tw-gradient-via-position:  ;\n  --tw-gradient-to-position:  ;\n  --tw-ordinal:  ;\n  --tw-slashed-zero:  ;\n  --tw-numeric-figure:  ;\n  --tw-numeric-spacing:  ;\n  --tw-numeric-fraction:  ;\n  --tw-ring-inset:  ;\n  --tw-ring-offset-width: 0px;\n  --tw-ring-offset-color: #fff;\n  --tw-ring-color: rgb(59 130 246 / 0.5);\n  --tw-ring-offset-shadow: 0 0 #0000;\n  --tw-ring-shadow: 0 0 #0000;\n  --tw-shadow: 0 0 #0000;\n  --tw-shadow-colored: 0 0 #0000;\n  --tw-blur:  ;\n  --tw-brightness:  ;\n  --tw-contrast:  ;\n  --tw-grayscale:  ;\n  --tw-hue-rotate:  ;\n  --tw-invert:  ;\n  --tw-saturate:  ;\n  --tw-sepia:  ;\n  --tw-drop-shadow:  ;\n  --tw-backdrop-blur:  ;\n  --tw-backdrop-brightness:  ;\n  --tw-backdrop-contrast:  ;\n  --tw-backdrop-grayscale:  ;\n  --tw-backdrop-hue-rotate:  ;\n  --tw-backdrop-invert:  ;\n  --tw-backdrop-opacity:  ;\n  --tw-backdrop-saturate:  ;\n  --tw-backdrop-sepia:  ;\n  --tw-contain-size:  ;\n  --tw-contain-layout:  ;\n  --tw-contain-paint:  ;\n  --tw-contain-style:  ;\n}\n::backdrop {\n  --tw-border-spacing-x: 0;\n  --tw-border-spacing-y: 0;\n  --tw-translate-x: 0;\n  --tw-translate-y: 0;\n  --tw-rotate: 0;\n  --tw-skew-x: 0;\n  --tw-skew-y: 0;\n  --tw-scale-x: 1;\n  --tw-scale-y: 1;\n  --tw-pan-x:  ;\n  --tw-pan-y:  ;\n  --tw-pinch-zoom:  ;\n  --tw-scroll-snap-strictness: proximity;\n  --tw-gradient-from-position:  ;\n  --tw-gradient-via-position:  ;\n  --tw-gradient-to-position:  ;\n  --tw-ordinal:  ;\n  --tw-slashed-zero:  ;\n  --tw-numeric-figure:  ;\n  --tw-numeric-spacing:  ;\n  --tw-numeric-fraction:  ;\n  --tw-ring-inset:  ;\n  --tw-ring-offset-width: 0px;\n  --tw-ring-offset-color: #fff;\n  --tw-ring-color: rgb(59 130 246 / 0.5);\n  --tw-ring-offset-shadow: 0 0 #0000;\n  --tw-ring-shadow: 0 0 #0000;\n  --tw-shadow: 0 0 #0000;\n  --tw-shadow-colored: 0 0 #0000;\n  --tw-blur:  ;\n  --tw-brightness:  ;\n  --tw-contrast:  ;\n  --tw-grayscale:  ;\n  --tw-hue-rotate:  ;\n  --tw-invert:  ;\n  --tw-saturate:  ;\n  --tw-sepia:  ;\n  --tw-drop-shadow:  ;\n  --tw-backdrop-blur:  ;\n  --tw-backdrop-brightness:  ;\n  --tw-backdrop-contrast:  ;\n  --tw-backdrop-grayscale:  ;\n  --tw-backdrop-hue-rotate:  ;\n  --tw-backdrop-invert:  ;\n  --tw-backdrop-opacity:  ;\n  --tw-backdrop-saturate:  ;\n  --tw-backdrop-sepia:  ;\n  --tw-contain-size:  ;\n  --tw-contain-layout:  ;\n  --tw-contain-paint:  ;\n  --tw-contain-style:  ;\n}\n/* ! tailwindcss v3.4.19 | MIT License | https://tailwindcss.com *//*\n1. Prevent padding and border from affecting element width. (https://github.com/mozdevs/cssremedy/issues/4)\n2. Allow adding a border to an element by just adding a border-width. (https://github.com/tailwindcss/tailwindcss/pull/116)\n*/\n\n*,\n::before,\n::after {\n  box-sizing: border-box; /* 1 */\n  border-width: 0; /* 2 */\n  border-style: solid; /* 2 */\n  border-color: #e5e7eb; /* 2 */\n}\n\n::before,\n::after {\n  --tw-content: '';\n}\n\n/*\n1. Use a consistent sensible line-height in all browsers.\n2. Prevent adjustments of font size after orientation changes in iOS.\n3. Use a more readable tab size.\n4. Use the user's configured `sans` font-family by default.\n5. Use the user's configured `sans` font-feature-settings by default.\n6. Use the user's configured `sans` font-variation-settings by default.\n7. Disable tap highlights on iOS\n*/\n\nhtml,\n:host {\n  line-height: 1.5; /* 1 */\n  -webkit-text-size-adjust: 100%; /* 2 */\n  -moz-tab-size: 4; /* 3 */\n  -o-tab-size: 4;\n     tab-size: 4; /* 3 */\n  font-family: var(--font-sans); /* 4 */\n  font-feature-settings: normal; /* 5 */\n  font-variation-settings: normal; /* 6 */\n  -webkit-tap-highlight-color: transparent; /* 7 */\n}\n\n/*\n1. Remove the margin in all browsers.\n2. Inherit line-height from `html` so users can set them as a class directly on the `html` element.\n*/\n\nbody {\n  margin: 0; /* 1 */\n  line-height: inherit; /* 2 */\n}\n\n/*\n1. Add the correct height in Firefox.\n2. Correct the inheritance of border color in Firefox. (https://bugzilla.mozilla.org/show_bug.cgi?id=190655)\n3. Ensure horizontal rules are visible by default.\n*/\n\nhr {\n  height: 0; /* 1 */\n  color: inherit; /* 2 */\n  border-top-width: 1px; /* 3 */\n}\n\n/*\nAdd the correct text decoration in Chrome, Edge, and Safari.\n*/\n\nabbr:where([title]) {\n  -webkit-text-decoration: underline dotted;\n          text-decoration: underline dotted;\n}\n\n/*\nRemove the default font size and weight for headings.\n*/\n\nh1,\nh2,\nh3,\nh4,\nh5,\nh6 {\n  font-size: inherit;\n  font-weight: inherit;\n}\n\n/*\nReset links to optimize for opt-in styling instead of opt-out.\n*/\n\na {\n  color: inherit;\n  text-decoration: inherit;\n}\n\n/*\nAdd the correct font weight in Edge and Safari.\n*/\n\nb,\nstrong {\n  font-weight: bolder;\n}\n\n/*\n1. Use the user's configured `mono` font-family by default.\n2. Use the user's configured `mono` font-feature-settings by default.\n3. Use the user's configured `mono` font-variation-settings by default.\n4. Correct the odd `em` font sizing in all browsers.\n*/\n\ncode,\nkbd,\nsamp,\npre {\n  font-family: var(--font-mono); /* 1 */\n  font-feature-settings: normal; /* 2 */\n  font-variation-settings: normal; /* 3 */\n  font-size: 1em; /* 4 */\n}\n\n/*\nAdd the correct font size in all browsers.\n*/\n\nsmall {\n  font-size: 80%;\n}\n\n/*\nPrevent `sub` and `sup` elements from affecting the line height in all browsers.\n*/\n\nsub,\nsup {\n  font-size: 75%;\n  line-height: 0;\n  position: relative;\n  vertical-align: baseline;\n}\n\nsub {\n  bottom: -0.25em;\n}\n\nsup {\n  top: -0.5em;\n}\n\n/*\n1. Remove text indentation from table contents in Chrome and Safari. (https://bugs.chromium.org/p/chromium/issues/detail?id=999088, https://bugs.webkit.org/show_bug.cgi?id=201297)\n2. Correct table border color inheritance in all Chrome and Safari. (https://bugs.chromium.org/p/chromium/issues/detail?id=935729, https://bugs.webkit.org/show_bug.cgi?id=195016)\n3. Remove gaps between table borders by default.\n*/\n\ntable {\n  text-indent: 0; /* 1 */\n  border-color: inherit; /* 2 */\n  border-collapse: collapse; /* 3 */\n}\n\n/*\n1. Change the font styles in all browsers.\n2. Remove the margin in Firefox and Safari.\n3. Remove default padding in all browsers.\n*/\n\nbutton,\ninput,\noptgroup,\nselect,\ntextarea {\n  font-family: inherit; /* 1 */\n  font-feature-settings: inherit; /* 1 */\n  font-variation-settings: inherit; /* 1 */\n  font-size: 100%; /* 1 */\n  font-weight: inherit; /* 1 */\n  line-height: inherit; /* 1 */\n  letter-spacing: inherit; /* 1 */\n  color: inherit; /* 1 */\n  margin: 0; /* 2 */\n  padding: 0; /* 3 */\n}\n\n/*\nRemove the inheritance of text transform in Edge and Firefox.\n*/\n\nbutton,\nselect {\n  text-transform: none;\n}\n\n/*\n1. Correct the inability to style clickable types in iOS and Safari.\n2. Remove default button styles.\n*/\n\nbutton,\ninput:where([type='button']),\ninput:where([type='reset']),\ninput:where([type='submit']) {\n  -webkit-appearance: button; /* 1 */\n  background-color: transparent; /* 2 */\n  background-image: none; /* 2 */\n}\n\n/*\nUse the modern Firefox focus style for all focusable elements.\n*/\n\n:-moz-focusring {\n  outline: auto;\n}\n\n/*\nRemove the additional `:invalid` styles in Firefox. (https://github.com/mozilla/gecko-dev/blob/2f9eacd9d3d995c937b4251a5557d95d494c9be1/layout/style/res/forms.css#L728-L737)\n*/\n\n:-moz-ui-invalid {\n  box-shadow: none;\n}\n\n/*\nAdd the correct vertical alignment in Chrome and Firefox.\n*/\n\nprogress {\n  vertical-align: baseline;\n}\n\n/*\nCorrect the cursor style of increment and decrement buttons in Safari.\n*/\n\n::-webkit-inner-spin-button,\n::-webkit-outer-spin-button {\n  height: auto;\n}\n\n/*\n1. Correct the odd appearance in Chrome and Safari.\n2. Correct the outline style in Safari.\n*/\n\n[type='search'] {\n  -webkit-appearance: textfield; /* 1 */\n  outline-offset: -2px; /* 2 */\n}\n\n/*\nRemove the inner padding in Chrome and Safari on macOS.\n*/\n\n::-webkit-search-decoration {\n  -webkit-appearance: none;\n}\n\n/*\n1. Correct the inability to style clickable types in iOS and Safari.\n2. Change font properties to `inherit` in Safari.\n*/\n\n::-webkit-file-upload-button {\n  -webkit-appearance: button; /* 1 */\n  font: inherit; /* 2 */\n}\n\n/*\nAdd the correct display in Chrome and Safari.\n*/\n\nsummary {\n  display: list-item;\n}\n\n/*\nRemoves the default spacing and border for appropriate elements.\n*/\n\nblockquote,\ndl,\ndd,\nh1,\nh2,\nh3,\nh4,\nh5,\nh6,\nhr,\nfigure,\np,\npre {\n  margin: 0;\n}\n\nfieldset {\n  margin: 0;\n  padding: 0;\n}\n\nlegend {\n  padding: 0;\n}\n\nol,\nul,\nmenu {\n  list-style: none;\n  margin: 0;\n  padding: 0;\n}\n\n/*\nReset default styling for dialogs.\n*/\ndialog {\n  padding: 0;\n}\n\n/*\nPrevent resizing textareas horizontally by default.\n*/\n\ntextarea {\n  resize: vertical;\n}\n\n/*\n1. Reset the default placeholder opacity in Firefox. (https://github.com/tailwindlabs/tailwindcss/issues/3300)\n2. Set the default placeholder color to the user's configured gray 400 color.\n*/\n\ninput::-moz-placeholder, textarea::-moz-placeholder {\n  opacity: 1; /* 1 */\n  color: #9ca3af; /* 2 */\n}\n\ninput::placeholder,\ntextarea::placeholder {\n  opacity: 1; /* 1 */\n  color: #9ca3af; /* 2 */\n}\n\n/*\nSet the default cursor for buttons.\n*/\n\nbutton,\n[role=\"button\"] {\n  cursor: pointer;\n}\n\n/*\nMake sure disabled buttons don't get the pointer cursor.\n*/\n:disabled {\n  cursor: default;\n}\n\n/*\n1. Make replaced elements `display: block` by default. (https://github.com/mozdevs/cssremedy/issues/14)\n2. Add `vertical-align: middle` to align replaced elements more sensibly by default. (https://github.com/jensimmons/cssremedy/issues/14#issuecomment-634934210)\n   This can trigger a poorly considered lint error in some tools but is included by design.\n*/\n\nimg,\nsvg,\nvideo,\ncanvas,\naudio,\niframe,\nembed,\nobject {\n  display: block; /* 1 */\n  vertical-align: middle; /* 2 */\n}\n\n/*\nConstrain images and videos to the parent width and preserve their intrinsic aspect ratio. (https://github.com/mozdevs/cssremedy/issues/14)\n*/\n\nimg,\nvideo {\n  max-width: 100%;\n  height: auto;\n}\n\n/* Make elements with the HTML hidden attribute stay hidden by default */\n[hidden]:where(:not([hidden=\"until-found\"])) {\n  display: none;\n}\n.\\!visible {\n  visibility: visible !important;\n}\n.visible {\n  visibility: visible;\n}\n.static {\n  position: static;\n}\n.fixed {\n  position: fixed;\n}\n.relative {\n  position: relative;\n}\n.sticky {\n  position: sticky;\n}\n.block {\n  display: block;\n}\n.inline {\n  display: inline;\n}\n.flex {\n  display: flex;\n}\n.inline-flex {\n  display: inline-flex;\n}\n.table {\n  display: table;\n}\n.grid {\n  display: grid;\n}\n.hidden {\n  display: none;\n}\n.transform {\n  transform: translate(var(--tw-translate-x), var(--tw-translate-y)) rotate(var(--tw-rotate)) skewX(var(--tw-skew-x)) skewY(var(--tw-skew-y)) scaleX(var(--tw-scale-x)) scaleY(var(--tw-scale-y));\n}\n.border {\n  border-width: 1px;\n}\n.italic {\n  font-style: italic;\n}\n.tabular-nums {\n  --tw-numeric-spacing: tabular-nums;\n  font-variant-numeric: var(--tw-ordinal) var(--tw-slashed-zero) var(--tw-numeric-figure) var(--tw-numeric-spacing) var(--tw-numeric-fraction);\n}\n.underline {\n  text-decoration-line: underline;\n}\n.shadow {\n  --tw-shadow: 0 1px 3px 0 rgb(0 0 0 / 0.1), 0 1px 2px -1px rgb(0 0 0 / 0.1);\n  --tw-shadow-colored: 0 1px 3px 0 var(--tw-shadow-color), 0 1px 2px -1px var(--tw-shadow-color);\n  box-shadow: var(--tw-ring-offset-shadow, 0 0 #0000), var(--tw-ring-shadow, 0 0 #0000), var(--tw-shadow);\n}\n.outline {\n  outline-style: solid;\n}\n.ring {\n  --tw-ring-offset-shadow: var(--tw-ring-inset) 0 0 0 var(--tw-ring-offset-width) var(--tw-ring-offset-color);\n  --tw-ring-shadow: var(--tw-ring-inset) 0 0 0 calc(3px + var(--tw-ring-offset-width)) var(--tw-ring-color);\n  box-shadow: var(--tw-ring-offset-shadow), var(--tw-ring-shadow), var(--tw-shadow, 0 0 #0000);\n}\n.filter {\n  filter: var(--tw-blur) var(--tw-brightness) var(--tw-contrast) var(--tw-grayscale) var(--tw-hue-rotate) var(--tw-invert) var(--tw-saturate) var(--tw-sepia) var(--tw-drop-shadow);\n}\n.transition {\n  transition-property: color, background-color, border-color, text-decoration-color, fill, stroke, opacity, box-shadow, transform, filter, backdrop-filter;\n  transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);\n  transition-duration: 150ms;\n}\n.ease-out {\n  transition-timing-function: cubic-bezier(0, 0, 0.2, 1);\n}\n\nhtml,\nbody {\n  margin: 0;\n  padding: 0;\n  font-family: var(--font-sans);\n  font-size: var(--font-size-body);\n  font-weight: var(--font-weight-body);\n  line-height: var(--line-height-normal);\n  letter-spacing: var(--letter-spacing-body);\n  background: var(--color-bg-page);\n  color: var(--color-text-primary);\n  color-scheme: light dark;\n  transition:\n    background-color 0.3s ease,\n    color 0.3s ease;\n  -webkit-font-smoothing: antialiased;\n  -moz-osx-font-smoothing: grayscale;\n  text-rendering: optimizeLegibility;\n  font-kerning: normal;\n}\n\n#root {\n  min-height: 100vh;\n}\n\n/* ============================================================\n * 排版基础 · Typography Foundation（B 端 PC 优先）\n * ============================================================ */\nh1, h2, h3, h4, h5, h6 {\n  margin: 0;\n  font-family: var(--font-sans);\n  font-weight: var(--font-weight-heading);\n  color: var(--color-text-primary);\n  text-wrap: balance;\n  line-height: var(--line-height-heading);\n  letter-spacing: var(--letter-spacing-heading);\n}\nh1 {\n  font-size: var(--font-size-h1);\n  line-height: var(--line-height-tight);\n  font-weight: var(--font-weight-extrabold);\n}\nh2 {\n  font-size: var(--font-size-h2);\n  line-height: var(--line-height-tight);\n  font-weight: var(--font-weight-bold);\n}\nh3 {\n  font-size: var(--font-size-h3);\n  line-height: var(--line-height-snug);\n  font-weight: var(--font-weight-bold);\n}\nh4 {\n  font-size: var(--font-size-h4);\n  line-height: var(--line-height-snug);\n  font-weight: var(--font-weight-semibold);\n}\nh5 {\n  font-size: var(--font-size-body);\n  line-height: var(--line-height-snug);\n  font-weight: var(--font-weight-semibold);\n}\nh6 {\n  font-size: var(--font-size-small);\n  line-height: var(--line-height-snug);\n  font-weight: var(--font-weight-semibold);\n  color: var(--color-text-secondary);\n}\n\np {\n  margin: 0 0 var(--space-3);\n  text-wrap: pretty;\n  orphans: 3;\n  widows: 3;\n}\n\n/* 排版工具类 */\n.text-eyebrow {\n  font-size: var(--font-size-eyebrow);\n  font-weight: var(--font-weight-emphasis);\n  letter-spacing: var(--letter-spacing-eyebrow);\n  text-transform: uppercase;\n  color: var(--color-text-tertiary);\n}\n.text-label {\n  font-size: var(--font-size-label);\n  font-weight: var(--font-weight-label);\n  letter-spacing: var(--letter-spacing-caption);\n  color: var(--color-text-secondary);\n}\n.text-balance { text-wrap: balance; }\n.text-pretty { text-wrap: pretty; }\n\n#root {\n  min-height: 100vh;\n}\n\na {\n  color: var(--color-text-link);\n  text-decoration: none;\n}\na:hover {\n  color: var(--color-text-link-hover);\n}\n\n* {\n  box-sizing: border-box;\n}\n\nbutton {\n  font-family: inherit;\n}\n\nimg {\n  display: block;\n  max-width: 100%;\n}\n\n/* ============================================================\n * B 端布局容器：PC 优先，最小 1280px（B 端设计决策，低于此宽度横向滚动）\n * 注意：min-width: 1280px 是 B 端保留的设计决策，不可删除\n * ============================================================ */\n.admin-layout {\n  min-height: 100vh;\n  min-width: 1280px;\n  display: flex;\n}\n\n/* 可访问性：跳过到主内容 */\n.skip-link {\n  position: absolute;\n  left: -9999px;\n  top: 0;\n  z-index: var(--z-index-toast);\n  padding: var(--space-2) var(--space-4);\n  background: var(--color-bg-surface);\n  color: var(--color-text-primary);\n  border-radius: var(--radius-md);\n  box-shadow: var(--sh-3);\n}\n.skip-link:focus {\n  left: var(--space-4);\n  top: var(--space-4);\n}\n\n/* ============================================================\n * 焦点可见全局样式（与 C 端一致，P8-A3）\n * ============================================================ */\na:focus-visible,\nbutton:focus-visible,\ninput:focus-visible,\nselect:focus-visible,\ntextarea:focus-visible,\n[tabindex]:focus-visible {\n  outline: 2px solid var(--color-brand);\n  outline-offset: 2px;\n  border-radius: var(--radius-sm);\n}\n\n/* ============================================================\n * prefers-contrast: more 高对比模式（P8-A5）\n * ============================================================ */\n@media (prefers-contrast: more) {\n  :root {\n    --color-border-subtle: var(--color-border-default);\n  }\n  body {\n    background: var(--color-bg-surface);\n    color: var(--color-text-primary);\n  }\n  a,\n  a:hover {\n    text-decoration: underline;\n  }\n}\n\n/* ============================================================\n * prefers-reduced-motion 全量降级（P8-A7）\n * ============================================================ */\n@media (prefers-reduced-motion: reduce) {\n  *,\n  *::before,\n  *::after {\n    animation-duration: 0.01ms !important;\n    animation-iteration-count: 1 !important;\n    transition-duration: 0.01ms !important;\n    scroll-behavior: auto !important;\n  }\n}\n\n/* 屏幕阅读器辅助工具类 */\n.sr-only {\n  position: absolute;\n  width: 1px;\n  height: 1px;\n  padding: 0;\n  margin: -1px;\n  overflow: hidden;\n  clip: rect(0, 0, 0, 0);\n  white-space: nowrap;\n  border: 0;\n}\n\n/* ============================================================\n * B 端数值表格对齐（04 §9.1）：数值列右对齐 + 千分位字体\n * ============================================================ */\n.admin-table-num-cell {\n  text-align: right;\n  font-variant-numeric: tabular-nums;\n  font-feature-settings: \"tnum\";\n}\n\n/* ============================================================\n * 细节边缘体验 · Edge Cases（B 端）\n * ============================================================ */\n\n/* ---------- 长文本换行：URL/长英文单词不撑破布局 ---------- */\n.ant-typography,\n.ant-card,\n.ant-table-cell,\n.ant-descriptions-item-content {\n  overflow-wrap: break-word;\n}\n\n/* ---------- 数字输入 spinner 隐藏（全局兜底） ---------- */\ninput[type='number']::-webkit-outer-spin-button,\ninput[type='number']::-webkit-inner-spin-button {\n  -webkit-appearance: none;\n  margin: 0;\n}\ninput[type='number'] {\n  -moz-appearance: textfield;\n  -webkit-appearance: textfield;\n          appearance: textfield;\n}\n\n/* ---------- 深色模式：AntD 输入框自动填充修复 ---------- */\n.ant-input:-webkit-autofill,\n.ant-input:-webkit-autofill:hover,\n.ant-input:-webkit-autofill:focus {\n  -webkit-text-fill-color: var(--color-text-primary);\n  -webkit-box-shadow: 0 0 0 1000px var(--color-bg-surface) inset;\n  -webkit-transition: background-color 9999s ease-in-out 0s;\n  transition: background-color 9999s ease-in-out 0s;\n}\n[data-theme='dark'] .ant-input:-webkit-autofill,\n[data-theme='dark'] .ant-input:-webkit-autofill:hover,\n[data-theme='dark'] .ant-input:-webkit-autofill:focus {\n  -webkit-text-fill-color: var(--color-text-primary);\n  -webkit-box-shadow: 0 0 0 1000px var(--color-bg-surface) inset;\n}\n\n/* ---------- AntD 表格行 hover 细节 ---------- */\n.ant-table-tbody > tr:hover > td {\n  background: var(--color-brand-bg) !important;\n}\n\n/* 状态 Tag 在行 hover 时轻微放大反馈 */\n.ant-table-tbody > tr:hover .ant-tag {\n  transition: transform var(--dur-fast) var(--ease-standard);\n  transform: scale(1.05);\n}\n\n/* ---------- 触屏 hover 粘滞修复 ---------- */\n@media (hover: none) {\n  .ant-card:hover,\n  .ant-table-tbody > tr:hover > td {\n    box-shadow: none;\n    transform: none;\n    background: inherit !important;\n  }\n}\n\n/* ---------- 桌面滚动条美化 ---------- */\n@media (hover: hover) and (pointer: fine) {\n  ::-webkit-scrollbar {\n    width: 8px;\n    height: 8px;\n  }\n  ::-webkit-scrollbar-track {\n    background: transparent;\n  }\n  ::-webkit-scrollbar-thumb {\n    background: var(--color-border-default);\n    border-radius: var(--radius-full);\n    border: 2px solid transparent;\n    background-clip: padding-box;\n  }\n  ::-webkit-scrollbar-thumb:hover {\n    background: var(--color-border-strong);\n    background-clip: padding-box;\n  }\n  html {\n    scrollbar-width: thin;\n    scrollbar-color: var(--color-border-default) transparent;\n  }\n}\n\n/* ---------- 深色模式：过亮图片降噪（B 端截图/封面） ---------- */\n[data-theme='dark'] img {\n  filter: brightness(0.92) contrast(1.05);\n}\n\n/* ---------- 表格空数据状态：柔和留白 ---------- */\n.ant-table-placeholder .ant-empty {\n  margin-block: var(--space-16);\n}\n\n/* ---------- AntD 卡片标题数字等宽 ---------- */\n.ant-statistic-content {\n  font-variant-numeric: tabular-nums;\n}\n\n/* ---------- 选中文本高亮（与主题一致） ---------- */\n::-moz-selection {\n  background: var(--color-brand-bg);\n  color: var(--color-brand-active);\n}\n::selection {\n  background: var(--color-brand-bg);\n  color: var(--color-brand-active);\n}\n\n/* ---------- 移动端长按高亮透明 ---------- */\n.ant-btn,\n.ant-tag {\n  -webkit-tap-highlight-color: transparent;\n}\n\n/* ---------- 分页边界：末页无更多时不显示禁用态灰块干扰 ---------- */\n.ant-pagination-disabled {\n  opacity: 0.45;\n}\n\n/* ---------- 筛选复选框组：细致分类横向排列，超出自动换行 ---------- */\n.filter-checkbox-group {\n  display: flex;\n  flex-wrap: wrap;\n  gap: var(--space-1) var(--space-3);\n  max-width: 560px;\n}\n.filter-checkbox-group .ant-checkbox-wrapper {\n  margin-inline-end: 0;\n}\n\n/* 子页面（弹窗/抽屉/内嵌面板）纵向排列 */\n.filter-checkbox-group.is-vertical {\n  flex-direction: column;\n  gap: var(--space-2);\n  max-width: none;\n}\n\n/* 选项较多的横向排列场景，放开宽度限制 */\n.filter-checkbox-group.is-wide {\n  max-width: none;\n}\n\n/* ============================================\n * CompactTable · 紧凑型数据表格\n * ============================================ */\n.compact-table .ant-table-thead > tr > th {\n  font-size: var(--font-size-caption, 13px);\n  font-weight: var(--font-weight-semibold, 600);\n  text-transform: none;\n  color: var(--color-text-tertiary);\n  background: var(--color-bg-subtle);\n  border-bottom: 1px solid var(--color-border-subtle);\n  white-space: nowrap;\n}\n\n.compact-table .ant-table-thead > tr > th,\n.compact-table .ant-table-tbody > tr > td {\n  padding-top: 8px;\n  padding-bottom: 8px;\n}\n\n.compact-table .ant-table-tbody > tr > td {\n  font-size: var(--font-size-small, 14px);\n  border-bottom: 1px solid var(--color-border-subtle);\n}\n\n/* 行悬浮：左侧品牌色指示条 */\n.compact-table .ant-table-tbody > tr {\n  transition: background var(--dur-fast) var(--ease-standard);\n}\n\n.compact-table .ant-table-tbody > tr:hover > td {\n  box-shadow: inset 3px 0 0 var(--color-brand);\n}\n\n/* 数字列等宽对齐（数据列） */\n.compact-table .num-tabular,\n.compact-table td.num-col {\n  font-variant-numeric: tabular-nums;\n  font-family: var(--font-mono);\n}\n\n/* 紧凑分页 */\n.compact-table .ant-pagination {\n  margin-top: var(--space-3);\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .compact-table .ant-table-tbody > tr {\n    transition: none;\n  }\n}\n"]],"\n  ",["BODY",{},"\n    ",["DIV",{"id":"root"},["DIV",{"class":"css-dev-only-do-not-override-v90ahe ant-app"}]],"\n    ","\n  \n\n"]],"viewport":{"width":1280,"height":720},"timestamp":94953.688,"wallTime":1786170263961,"collectionTime":1012.2000000178814,"resourceOverrides":[],"isMainFrame":true}}
