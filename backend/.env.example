# 小说阅读平台后端配置
# 复制此文件为 .env 并根据环境修改

# 应用
APP_NAME=小说阅读平台后端
# DEBUG=true 时允许：无 token 降级为 demo 账号、Redis 连接失败降级 fakeredis、自动写入种子数据
# 生产环境必须设为 false（默认值即 false）
DEBUG=false

# 数据库（默认 SQLite 开发，生产用 MySQL）
DB_URL=sqlite+aiosqlite:///./novel.db
# DB_URL=mysql+asyncmy://user:password@localhost:3306/novel_db

# Redis（生产环境必须真实可用；DEBUG=false 时连接失败将直接报错，不会降级）
REDIS_URL=redis://localhost:6379/0

# JWT 鉴权（生产环境必须配置强随机密钥，>=32 字节，否则启动校验失败）
# 生成方式：openssl rand -hex 32
JWT_SECRET=change-me-in-production-min-32-bytes!!
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL=28800
REFRESH_TOKEN_TTL=2592000

# 演示账号（仅 DEBUG=true 时生效，生产环境请勿使用）
DEMO_READER_ID=1001
DEMO_ADMIN_USERNAME=admin
DEMO_ADMIN_PASSWORD=admin123

# 限流
RATE_LIMIT_LOGIN=5
RATE_LIMIT_SEARCH=10
RATE_LIMIT_PROGRESS=1
RATE_LIMIT_REWARD=1

# CORS
CORS_ORIGINS=["*"]
