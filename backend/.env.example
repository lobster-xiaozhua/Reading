# ===================== PostgreSQL 配置 =====================
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=postgres
PG_DB=novel_db

# ===================== Meilisearch 配置 =====================
MEILI_HOST=http://127.0.0.1:7700
MEILI_API_KEY=
MEILI_BOOKS_INDEX=books
MEILI_CHAPTERS_INDEX=chapters

# ===================== JWT =====================
# 生产环境请设置为随机字符串
JWT_SECRET=change-me-in-production

# ===================== CORS =====================
# 允许的前端来源，多个用逗号分隔。默认开发环境 localhost:5173。
# 生产环境请改为实际域名，如 https://reading.example.com
CORS_ORIGINS=http://localhost:5173

# ===================== 管理 API 认证 =====================
# 留空则跳过认证（本地开发）。生产请设随机字符串，前端 Admin 页填写相同值。
ADMIN_API_KEY=
